<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Agnes.App.Mobile.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml" />
        <!-- Aliases the plugin drawn controls' role names onto this head's; see DrawingRoles.axaml. -->
        <ResourceInclude Source="/Themes/DrawingRoles.axaml" />
        <ResourceInclude Source="/Themes/Icons.axaml" />
        <ResourceInclude Source="/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <StyleInclude Source="/Themes/AppStyles.axaml" />
  </Application.Styles>
</Application>
