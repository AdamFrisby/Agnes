<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Agnes.App.Mobile.Controls"
             xmlns:v="using:Agnes.App.Mobile.Views"
             xmlns:vm="using:Agnes.App.Mobile.ViewModels"
             x:Class="Agnes.App.Mobile.Views.ShellView"
             Background="{DynamicResource Bg}">
  <!--
    The app frame: tab content, a pushed-page layer over it, the sheet layer over that, and a toast on
    top of everything.

    Layering rather than swapping keeps state alive — a session you pushed is still subscribed while a
    sheet is over it, and popping back doesn't rebuild the transcript.
  -->
  <!-- The view-model → view map. Pages and sheets are pushed as view models; these templates are the
       only place that decides what each one looks like. -->
  <UserControl.DataTemplates>
    <!-- Page → view -->
    <DataTemplate DataType="vm:SessionPageViewModel"><v:SessionPageView /></DataTemplate>
    <DataTemplate DataType="vm:NewSessionPageViewModel"><v:NewSessionPageView /></DataTemplate>
    <DataTemplate DataType="vm:ConnectPageViewModel"><v:ConnectPageView /></DataTemplate>
    <DataTemplate DataType="vm:HostSessionsPageViewModel"><v:HostSessionsPageView /></DataTemplate>
    <DataTemplate DataType="vm:AppearancePageViewModel"><v:AppearancePageView /></DataTemplate>
    <DataTemplate DataType="vm:NotificationsPageViewModel"><v:NotificationsPageView /></DataTemplate>
    <DataTemplate DataType="vm:PromptsPageViewModel"><v:PromptsPageView /></DataTemplate>
    <DataTemplate DataType="vm:DevicesPageViewModel"><v:DevicesPageView /></DataTemplate>
    <DataTemplate DataType="vm:AboutPageViewModel"><v:AboutPageView /></DataTemplate>
    <DataTemplate DataType="vm:CodeyBoxSetupPageViewModel"><v:CodeyBoxSetupPageView /></DataTemplate>
    <DataTemplate DataType="vm:CodeyBoxItemPageViewModel"><v:CodeyBoxItemPageView /></DataTemplate>

    <!-- Sheet → view -->
    <DataTemplate DataType="vm:DetailSheetViewModel"><v:DetailSheetView /></DataTemplate>
    <DataTemplate DataType="vm:ChangedFilesSheetViewModel"><v:ChangedFilesSheetView /></DataTemplate>
    <DataTemplate DataType="vm:ToolsSheetViewModel"><v:ToolsSheetView /></DataTemplate>
    <DataTemplate DataType="vm:PlanSheetViewModel"><v:PlanSheetView /></DataTemplate>
    <DataTemplate DataType="vm:AgentsSheetViewModel"><v:AgentsSheetView /></DataTemplate>
    <DataTemplate DataType="vm:QueueSheetViewModel"><v:QueueSheetView /></DataTemplate>
    <DataTemplate DataType="vm:GitSheetViewModel"><v:GitSheetView /></DataTemplate>
    <DataTemplate DataType="vm:SessionInfoSheetViewModel"><v:SessionInfoSheetView /></DataTemplate>
    <DataTemplate DataType="vm:SessionActionsSheetViewModel"><v:SessionActionsSheetView /></DataTemplate>
    <DataTemplate DataType="vm:HostsSheetViewModel"><v:HostsSheetView /></DataTemplate>
    <DataTemplate DataType="vm:ReceivedFileSheetViewModel"><v:ReceivedFileSheetView /></DataTemplate>
    <DataTemplate DataType="vm:CodeyBoxAnswerSheetViewModel"><v:CodeyBoxAnswerSheetView /></DataTemplate>
  </UserControl.DataTemplates>

  <Panel>

    <!-- ================= tabs, rail, panes ================= -->
    <!-- One grid holds three arrangements the window's size chooses between (ShellView.axaml.cs applies
         them from WindowLayout): a bar under the tabs on a phone; the same buttons as a rail down the left
         in landscape or on anything wider than a phone; and, with room for two panes, the tab's list in a
         fixed-width column with the open session or item beside it. -->
    <Grid Name="ShellGrid" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*">

      <!-- All the tabs stay alive and simply hide, so switching back doesn't rebuild a list or lose a
           scroll position. IsVisible has to sit on the wrapper: on the view itself it would resolve
           against that tab's own view model, not the shell. -->
      <Grid Name="PaneGrid" Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,0">
        <Panel Grid.Column="0" Name="TabsPane">
          <!--
            One ContentControl per destination, and the view is its template rather than its child.

            That one indirection is what makes a launch show the Sessions list instead of building all
            five screens first. A ContentPresenter materializes its child when it is measured, and an
            invisible control is never measured — so a cold start builds exactly the tab you land on,
            and each of the others the first time you go there. Measured on a Lenovo TB310FU: the shell's
            constructor went from 1038 ms to 190 ms.

            Nothing about the lifetime changes: Content never changes, so the view built on first visit
            is the one you come back to, with its list and its scroll position. IsVisible stays on the
            wrapper for the reason it always did — on the view itself it would resolve against that tab's
            own view model, not the shell.
          -->
          <ContentControl IsVisible="{Binding IsSessionsTab}" Content="{Binding Sessions}">
            <ContentControl.ContentTemplate>
              <DataTemplate><v:SessionsView /></DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <ContentControl IsVisible="{Binding IsInboxTab}" Content="{Binding Inbox}">
            <ContentControl.ContentTemplate>
              <DataTemplate><v:InboxView /></DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <ContentControl IsVisible="{Binding IsSearchTab}" Content="{Binding Search}">
            <ContentControl.ContentTemplate>
              <DataTemplate><v:SearchView /></DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <ContentControl IsVisible="{Binding IsMoreTab}" Content="{Binding More}">
            <ContentControl.ContentTemplate>
              <DataTemplate><v:MoreView /></DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <!-- The fifth destination exists only on a device that watches a CodeyBox fleet; see ShellTab. -->
          <ContentControl IsVisible="{Binding IsCodeyBoxTab}" Content="{Binding CodeyBox}">
            <ContentControl.ContentTemplate>
              <DataTemplate><v:CodeyBoxView /></DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Panel>

        <!-- The detail pane: the open session or fleet item beside its list, on a window with two panes. -->
        <Border Grid.Column="1" Name="DetailPane"
                BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsDetailShown}">
          <c:PageStackHost Name="DetailHost"
                           Pages="{Binding DetailStack}"
                           Current="{Binding Detail}"
                           Background="{DynamicResource Bg}" />
        </Border>
      </Grid>

      <!-- The destinations: a bar (thumb height, labels always on — an icon-only bar saves a few pixels
           and costs a guess on every launch) or, moved by the code-behind, a rail. -->
      <Border Grid.Row="1" Grid.Column="1" Name="NavBar"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource Border}"
              BorderThickness="0,1,0,0"
              IsVisible="{Binding ShowTabs}">
        <!-- A UniformGrid rather than a fixed four-column Grid, because the fifth destination is
             conditional: it lays out only the children that are visible, so four tabs share the bar
             and five re-divide it. -->
        <UniformGrid Name="NavGrid" Rows="1" Height="60">

          <RadioButton GroupName="tabs" Theme="{StaticResource NavButton}"
                       IsChecked="{Binding IsSessionsTab, Mode=OneWay}"
                       Command="{Binding SelectTabCommand}" CommandParameter="Sessions">
            <StackPanel Spacing="3">
              <c:Icon Data="{StaticResource IconMessageSquare}" Size="22"
                      Stroke="{Binding $parent[RadioButton].Foreground}" HorizontalAlignment="Center" />
              <TextBlock Text="Sessions" FontSize="11" LineHeight="13" HorizontalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>

          <RadioButton GroupName="tabs" Theme="{StaticResource NavButton}"
                       IsChecked="{Binding IsInboxTab, Mode=OneWay}"
                       Command="{Binding SelectTabCommand}" CommandParameter="Inbox">
            <StackPanel Spacing="3">
              <Panel HorizontalAlignment="Center">
                <c:Icon Data="{StaticResource IconInbox}" Size="22"
                        Stroke="{Binding $parent[RadioButton].Foreground}" />
                <!-- The badge is the app's whole proposition in one dot: something is waiting on you. -->
                <Border Background="{DynamicResource Danger}" CornerRadius="{StaticResource RadiusPill}"
                        MinWidth="17" Height="17" Padding="5,0" Margin="12,-9,-12,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        IsVisible="{Binding Inbox.HasBlocked}">
                  <TextBlock Text="{Binding Inbox.BlockedCount}" FontSize="10" FontWeight="Bold"
                             LineHeight="17" Foreground="White" HorizontalAlignment="Center" />
                </Border>
              </Panel>
              <TextBlock Text="Inbox" FontSize="11" LineHeight="13" HorizontalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>

          <RadioButton GroupName="tabs" Theme="{StaticResource NavButton}"
                       IsChecked="{Binding IsSearchTab, Mode=OneWay}"
                       Command="{Binding SelectTabCommand}" CommandParameter="Search">
            <StackPanel Spacing="3">
              <c:Icon Data="{StaticResource IconSearch}" Size="22"
                      Stroke="{Binding $parent[RadioButton].Foreground}" HorizontalAlignment="Center" />
              <TextBlock Text="Search" FontSize="11" LineHeight="13" HorizontalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>

          <RadioButton GroupName="tabs" Theme="{StaticResource NavButton}"
                       IsChecked="{Binding IsMoreTab, Mode=OneWay}"
                       Command="{Binding SelectTabCommand}" CommandParameter="More">
            <StackPanel Spacing="3">
              <c:Icon Data="{StaticResource IconSliders}" Size="22"
                      Stroke="{Binding $parent[RadioButton].Foreground}" HorizontalAlignment="Center" />
              <TextBlock Text="More" FontSize="11" LineHeight="13" HorizontalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>

          <RadioButton GroupName="tabs" Theme="{StaticResource NavButton}"
                       IsVisible="{Binding HasCodeyBox}"
                       IsChecked="{Binding IsCodeyBoxTab, Mode=OneWay}"
                       Command="{Binding SelectTabCommand}" CommandParameter="CodeyBox">
            <StackPanel Spacing="3">
              <c:Icon Data="{StaticResource IconLayers}" Size="22"
                      Stroke="{Binding $parent[RadioButton].Foreground}" HorizontalAlignment="Center" />
              <TextBlock Text="Fleet" FontSize="11" LineHeight="13" HorizontalAlignment="Center"
                         Foreground="{Binding $parent[RadioButton].Foreground}" />
            </StackPanel>
          </RadioButton>
        </UniformGrid>
      </Border>
    </Grid>

    <!-- ================= pushed page ================= -->
    <!-- Every page on the stack stays built and attached behind the one on top (see PageStackHost), so
         popping back to a session is a visibility flip rather than a rebuild of its whole view. -->
    <c:PageStackHost Name="PageHost"
                     Pages="{Binding Stack}"
                     Current="{Binding CurrentPage}"
                     Background="{DynamicResource Bg}"
                     IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- ================= sheet ================= -->
    <c:SheetHost Name="Sheets" Sheet="{Binding CurrentSheet}" Side="{Binding Layout.SideSheets}" />

    <!-- ================= toast ================= -->
    <Border Name="Toast" Classes="toast"
            Classes.success="{Binding ToastIsSuccess}"
            Classes.warning="{Binding ToastIsWarning}"
            Classes.danger="{Binding ToastIsDanger}"
            VerticalAlignment="Top" HorizontalAlignment="Stretch"
            Margin="12,0" Padding="14,11"
            CornerRadius="{StaticResource RadiusMd}"
            Background="{DynamicResource Surface3}"
            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
            IsVisible="{Binding HasToast}">
      <Grid ColumnDefinitions="Auto,*">
        <Border Name="ToastAccent" Grid.Column="0" Width="3" CornerRadius="{StaticResource RadiusPill}"
                Margin="0,0,12,0" Background="{DynamicResource Accent}" />
        <TextBlock Grid.Column="1" Text="{Binding ToastText}" VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Panel>
</UserControl>
