<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Agnes.App.Mobile.Controls"
             xmlns:vm="using:Agnes.App.Mobile.ViewModels"
             x:Class="Agnes.App.Mobile.Views.QueueSheetView"
             x:DataType="vm:QueueSheetViewModel">
  <ScrollViewer>
    <StackPanel Margin="12,10,12,24">

      <!-- This client's queue: sent in order as each turn ends. -->
      <ItemsControl ItemsSource="{Binding Session.PendingPrompts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="inset" Margin="0,0,0,8" Padding="12,10">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Text}" MaxLines="3"
                           TextTrimming="CharacterEllipsis" FontSize="{StaticResource TextSm}"
                           Margin="0,0,10,0" />
                <Button Grid.Column="1" Theme="{StaticResource IconButton}" Width="40" Height="40"
                        Command="{Binding $parent[UserControl].DataContext.EditCommand}"
                        CommandParameter="{Binding}">
                  <c:Icon Data="{StaticResource IconCode}" Size="16" Stroke="{DynamicResource TextDim}" />
                </Button>
                <Button Grid.Column="2" Theme="{StaticResource IconButton}" Width="40" Height="40"
                        Command="{Binding $parent[UserControl].DataContext.RemoveCommand}"
                        CommandParameter="{Binding}">
                  <c:Icon Data="{StaticResource IconTrash}" Size="16" Stroke="{DynamicResource Danger}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The host-side queue, shared by every client on this session. -->
      <TextBlock Classes="section" Text="QUEUED ON THE HOST"
                 IsVisible="{Binding Session.HasHostPending}" />
      <ItemsControl ItemsSource="{Binding Session.HostPending}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="inset" Margin="0,0,0,8" Padding="12,10">
              <TextBlock Text="{Binding Text}" MaxLines="3" TextTrimming="CharacterEllipsis"
                         FontSize="{StaticResource TextSm}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
