<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Agnes.App.Mobile.Controls"
             xmlns:vm="using:Agnes.App.Mobile.ViewModels"
             x:Class="Agnes.App.Mobile.Views.AgentsSheetView"
             x:DataType="vm:AgentsSheetViewModel">
  <!-- The lead agent and its subagents. Selecting one filters the transcript to that conversation, which
       is how a fan-out stays readable in a single column. -->
  <ScrollViewer>
    <ItemsControl ItemsSource="{Binding Session.AgentRows}" Margin="12,10,12,24">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Theme="{StaticResource RowButton}" Padding="10,12" Command="{Binding SelectCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <c:Icon Grid.Column="0" Data="{StaticResource IconSparkles}" Size="17"
                      Stroke="{DynamicResource Accent}" Margin="0,0,12,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="Lead agent" IsVisible="{Binding IsMain}" />
              </StackPanel>
              <c:Icon Grid.Column="2" Data="{StaticResource IconCheck}" Size="18"
                      Stroke="{DynamicResource Accent}" IsVisible="{Binding IsSelected}" />
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
