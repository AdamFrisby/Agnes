<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Agnes.App.Mobile.Controls"
             xmlns:vm="using:Agnes.App.Mobile.ViewModels"
             x:Class="Agnes.App.Mobile.Views.DevicesPageView"
             x:DataType="vm:DevicesPageViewModel"
             Background="{DynamicResource Bg}">
  <Grid RowDefinitions="Auto,*">
    <c:PageHeader Grid.Row="0" Title="Paired devices">
      <c:PageHeader.Action>
        <Button Theme="{StaticResource IconButton}"
                Command="{Binding RefreshCommand}">
          <c:Icon Data="{StaticResource IconRefresh}" Size="20" Stroke="{DynamicResource TextDim}" />
        </Button>
      </c:PageHeader.Action>
    </c:PageHeader>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="16,12,16,28" Spacing="10">

        <TextBlock Classes="dim" LineHeight="22"
                   Text="Every device that paired with this host holds its own token. Revoking one cuts it off immediately and leaves the others alone." />

        <TextBlock Classes="muted" Text="{Binding Status}" />

        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MobileDeviceRow">
              <Border Classes="card" Margin="0,0,0,8" Padding="14">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding Name}" Classes="strong" VerticalAlignment="Center" />
                        <!-- The role, as a plain pill. Not one of the status tints: those already mean
                             needs-you / running / failed, and a role is none of those. -->
                        <Border Name="RoleChip" Classes="pill"><TextBlock Text="{Binding RoleChip}" /></Border>
                        <Border Classes="pill accent" IsVisible="{Binding IsCurrentDevice}">
                          <TextBlock Text="this device" />
                        </Border>
                      </StackPanel>
                      <TextBlock Classes="caption" Text="{Binding Admission}" IsVisible="{Binding Admission, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Classes="caption" Text="{Binding LastSeen}" />
                    </StackPanel>
                    <Button Grid.Column="1" Theme="{StaticResource DangerButton}" MinHeight="38"
                            Padding="14,0" Content="Revoke"
                            Command="{Binding $parent[UserControl].DataContext.RevokeCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                  <Button Name="RoleButton" Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                          MinHeight="38" Content="{Binding RoleActionLabel}"
                          IsVisible="{Binding $parent[UserControl].DataContext.CanManage}"
                          IsEnabled="{Binding CanChangeRole}"
                          Command="{Binding $parent[UserControl].DataContext.SetRoleCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- A member sees the same list, read-only, and is told why rather than left to wonder. -->
        <TextBlock Name="OnlyOwnersNote" Classes="muted" TextWrapping="Wrap"
                   IsVisible="{Binding ShowOnlyOwnersNote}" Text="{Binding OnlyOwnersNote}" />

        <Button Name="PruneButton" Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                MinHeight="42" IsVisible="{Binding CanManage}" Content="{Binding PruneButtonLabel}"
                Command="{Binding PruneCommand}" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
