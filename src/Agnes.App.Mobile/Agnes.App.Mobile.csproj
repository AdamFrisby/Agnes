<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>dev.agnes.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia/XAML codegen produces warnings we don't want to fail the build (same posture as the
         desktop head). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Reflection-heavy (Avalonia bindings + System.Text.Json over the wire contract): don't trim, and don't
      link. SdkOnly linking was tried and reverted — it saved 1.3 MB and the packaged app stopped launching.
      This project has form here: see AndroidEnableMarshalMethods below, where the linker's involvement in
      emitting Java-callable wrappers already produced a launch crash once. The ABI restriction below is
      where the size actually comes from, and it doesn't touch code generation at all.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <!--
      One ABI in a shipped build. arm64 is every current Android phone; x86_64 exists for emulators and
      doubles the APK for a device that will never load it. Debug keeps both so an emulator still works.
    -->
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'Debug'">android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(Configuration)' != 'Debug'">android-arm64</RuntimeIdentifiers>
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <!-- AOT requires trimming, which we can't enable while bindings and the wire contract are resolved
         reflectively. Release therefore JITs, like the desktop head. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!--
      Marshal methods (Release default) pre-bind each Java-callable wrapper's native methods, but they
      are emitted by the linker — which AndroidLinkMode=None above turns off. The result is an APK whose
      wrappers declare native methods that nothing implements and that no longer self-register, so it
      dies on launch with `UnsatisfiedLinkError: No implementation found for ... n_onCreate()` before any
      of our code runs. Debug never enables them, which is why only the packaged APK was affected.
    -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Android" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
    <!-- This head's own chrome is drawn from the Lucide geometry in Themes/Icons.axaml, which matches the
         web design kit glyph-for-glyph. FluentIcons is here for the icons this head doesn't own: a
         `Symbol` named by a shared view model or contributed by a plugin has to render on a phone too.
         Kept in lockstep with tools/Agnes.MobilePreview, which links these sources. -->
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand fonts (Space Grotesk / Manrope / JetBrains Mono), embedded so typography is identical on
         every device rather than falling back to whatever the OEM ships. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.md" />
    <None Include="Assets\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agnes.Abstractions\Agnes.Abstractions.csproj" />
    <ProjectReference Include="..\Agnes.Protocol\Agnes.Protocol.csproj" />
    <ProjectReference Include="..\Agnes.Client\Agnes.Client.csproj" />
    <!-- Debug only: the offline demo host is a development affordance, and a release build must not
         ship a simulated host or its scripted transcripts at all. -->
    <ProjectReference Include="..\Agnes.Client.Simulation\Agnes.Client.Simulation.csproj"
                      Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="..\Agnes.Ui.Core\Agnes.Ui.Core.csproj" />
  </ItemGroup>

</Project>
