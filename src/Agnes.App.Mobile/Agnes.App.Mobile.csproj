<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>dev.agnes.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia/XAML codegen produces warnings we don't want to fail the build (same posture as the
         desktop head). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Trim everything — framework, Avalonia, the lot — except the assemblies whose members are only ever
      named by a string at runtime. Those are listed in ILLink.Descriptors.xml below, which explains
      which string and why; between them they cover the reflection bindings and the reflection-based
      JSON over the wire contract, the two things a whole-program trim would quietly break.

      PublishTrimmed=false turns the linker off outright, so AndroidLinkMode on its own is ignored:
      both have to say yes.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <AndroidLinkMode>Full</AndroidLinkMode>
    <!--
      A full trim otherwise sets this to false, and System.Text.Json then throws
      `InvalidOperationException: Reflection-based serialization has been disabled` on the first message
      off the hub. We have no source-generated JsonSerializerContext, so reflection *is* the serializer;
      the types it reflects over are rooted by the descriptor.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!--
      Shrink the Java side too. Without this nothing shrinks it at all: classes.dex ships every class of
      every AndroidX package a transitive reference dragged in, and an Avalonia app draws its own UI and
      uses almost none of them. R8 is the supported tool and the keep rules come from the SDK's generated
      proguard_xamarin.cfg plus each binding's own, which is what keeps the Java-callable wrappers and
      anything reached only over JNI.
    -->
    <AndroidLinkTool>r8</AndroidLinkTool>
    <!--
      One ABI in a shipped build. arm64 is every current Android phone; x86_64 exists for emulators and
      doubles the APK for a device that will never load it. Debug keeps both so an emulator still works.
    -->
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'Debug'">android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(Configuration)' != 'Debug'">android-arm64</RuntimeIdentifiers>
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <!--
      AOT needs the linker, which is now on, so this is available — and it was measured rather than
      assumed. Profiled AOT (RunAOTCompilation + AndroidEnableProfiledAot, compiling only what the SDK's
      startup profile says a launch runs) built and ran correctly on a Lenovo TB310FU, and cost 2.9 MB
      for 764 ms: 23.0 MB / 5785 ms against 20.1 MB / 6549 ms, medians of five cold starts. Twelve
      percent off a start that is still five and a half seconds is not worth fourteen percent more APK
      when the point of this configuration is size — and whatever dominates that six seconds is not JIT.
      Flip both to true to take the other side of the trade.
    -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!--
      Marshal methods pre-bind each Java-callable wrapper's native methods instead of registering them
      one by one at startup. They are *emitted by the linker*: with AndroidLinkMode=None they were
      emitted by nothing, so the wrappers declared native methods that nothing implemented and that no
      longer self-registered, and the packaged app died on launch with
      `UnsatisfiedLinkError: No implementation found for ... n_onCreate()` before any of our code ran.
      That was a symptom of the linker being off, not of marshal methods; with it on they work, and this
      is the Release default anyway.
    -->
    <AndroidEnableMarshalMethods>true</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <!--
    Launch instrumentation, off unless asked for: `-p:AgnesStartupTrace=true` defines the symbol that
    un-deletes StartupTrace's call sites (they are [Conditional], so without it they are not compiled at
    all and cost nothing). See Services/StartupTrace.cs for how to read the result.
  -->
  <PropertyGroup Condition="'$(AgnesStartupTrace)' == 'true'">
    <DefineConstants>$(DefineConstants);AGNES_STARTUP_TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Says what the linker must not remove, and why. -->
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Android" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
    <!-- This head's own chrome is drawn from the Lucide geometry in Themes/Icons.axaml, which matches the
         web design kit glyph-for-glyph. FluentIcons is here for the icons this head doesn't own: a
         `Symbol` named by a shared view model or contributed by a plugin has to render on a phone too.
         Kept in lockstep with tools/Agnes.MobilePreview, which links these sources. -->
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand fonts (Space Grotesk / Manrope / JetBrains Mono), embedded so typography is identical on
         every device rather than falling back to whatever the OEM ships. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.md" />
    <None Include="Assets\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agnes.Abstractions\Agnes.Abstractions.csproj" />
    <ProjectReference Include="..\Agnes.Protocol\Agnes.Protocol.csproj" />
    <ProjectReference Include="..\Agnes.Client\Agnes.Client.csproj" />
    <!-- Debug only: the offline demo host is a development affordance, and a release build must not
         ship a simulated host or its scripted transcripts at all. -->
    <ProjectReference Include="..\Agnes.Client.Simulation\Agnes.Client.Simulation.csproj"
                      Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="..\Agnes.Ui.Core\Agnes.Ui.Core.csproj" />
    <!--
      CodeyBox, as models rather than as a plugin. This head has no plugin loader and is not growing one:
      what it takes is CodeyBoxClient, OverviewGather, OverviewModel, BoardModel, Decision,
      NowWorkingViewModel and the small drawn controls, none of which know what a window is. The plugin's
      own Views/*.axaml come along in its assembly and are simply never instantiated — the phone's screens
      are its own (docs/mobile.md).

      The plugin's Avalonia and CommunityToolkit references are PrivateAssets="all", so nothing of its UI
      stack flows here; this project's own copies (identical versions) are what everything binds against.
      Its SignalR client is 10.0.10, the same version Agnes.Client already carries.
    -->
    <ProjectReference Include="..\Agnes.Plugins.CodeyBox\Agnes.Plugins.CodeyBox.csproj" />
  </ItemGroup>

</Project>
