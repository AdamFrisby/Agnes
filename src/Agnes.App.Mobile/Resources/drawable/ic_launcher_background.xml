<?xml version="1.0" encoding="utf-8"?>
<!-- Brand ink field. The mark is already gradient-coloured, so the backdrop stays a deep, quiet
     indigo (#1D1546 → #120C2E) and lets the squid carry the colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:aapt="http://schemas.android.com/aapt"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">
  <path android:pathData="M0,0 H108 V108 H0 Z">
    <aapt:attr name="android:fillColor">
      <gradient android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
        <item android:offset="0" android:color="#241A55" />
        <item android:offset="1" android:color="#120C2E" />
      </gradient>
    </aapt:attr>
  </path>
</vector>
