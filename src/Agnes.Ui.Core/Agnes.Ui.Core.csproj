<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agnes.Abstractions\Agnes.Abstractions.csproj" />
    <ProjectReference Include="..\Agnes.Protocol\Agnes.Protocol.csproj" />
    <ProjectReference Include="..\Agnes.Client\Agnes.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One MVVM stack across all heads (Desktop already uses it); replaces the former hand-rolled
         ObservableObject/RelayCommand/AsyncRelayCommand in this project. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- QR encoding for pairing/session codes. Pure managed, MIT, no native or System.Drawing
         dependency — it only ever produces a module matrix here, which each head draws itself. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- The `Symbol` enum only — netstandard2.0 with zero dependencies and no UI framework, so a shared
         view model can name an icon type-safely and each head renders it with its own control (Avalonia's
         SymbolIcon on desktop/mobile, the WinUI one on the Uno web head). Icons that never vary are left
         to the views; this is for the cases where *which* icon to show is view-model state. -->
    <PackageReference Include="FluentIcons.Common" Version="2.1.337" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Agnes.Ui.Core.Tests" />
  </ItemGroup>

</Project>
