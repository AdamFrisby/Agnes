<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:sys="using:System"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             xmlns:km="using:Agnes.App.Desktop.Keymaps"
             x:Class="Agnes.App.Desktop.Views.Settings.McpPage">
    <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="MCP servers" />
            <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                          Description="MCP servers give agents extra tools. Install a curated preset in one click, or add your own. Each server has a scope (all hosts / this host / this workspace) that decides which sessions see it. Changes apply on the next session start, never mid-session."
                          Security="These servers live on the host you're connected to. A host-run server is proxied into a sandbox through the audited forward; a sandbox-run server runs inside the VM." />
            <Button Grid.Column="4" Content="Refresh" Command="{Binding LoadMcpCommand}" Classes="seg" Margin="6,0,0,0" />
        </Grid>
        <TextBlock Classes="scopeNote">
            <Run Text="Configured on the host:" /><Run Text=" " /><Run Text="{Binding ActiveHostName}" FontWeight="SemiBold" />
        </TextBlock>
        <TextBlock Text="{Binding McpStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />

        <!-- Curated quick-install presets -->
        <TextBlock Text="Quick install" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
        <ItemsControl ItemsSource="{Binding McpPresets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" />
                            <TextBlock Text="{Binding Command}" Foreground="{DynamicResource FgFaint}" FontSize="10" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <!-- Reads "Installed" and disables once the host has it, so the list says what
                             you already have rather than offering the same install indefinitely. -->
                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="seg" IsEnabled="{Binding CanInstall}"
                                Command="{Binding $parent[ItemsControl].DataContext.InstallMcpPresetCommand}" CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Search the registries. The curated list above is four servers; this reaches the
             official MCP registry (and any other catalogue plugin the host has). Results say
             what each server needs before you install it, not after it fails to start. -->
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
        <TextBlock Text="Find more" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding McpCatalogQuery, Mode=TwoWay}" FontSize="12" Padding="8,5" CornerRadius="6"
                     Watermark="Search the MCP registries — e.g. postgres, figma, filesystem"
                     km:KeymapBinder.Context="SettingsMcpSearchFocus" />
            <Button Grid.Column="1" Content="Search" Command="{Binding SearchMcpCatalogCommand}" Classes="seg" />
            <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center"
                         IsVisible="{Binding IsSearchingMcpCatalog}"
                         Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
        </Grid>
        <TextBlock Text="{Binding McpCatalogStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding McpCatalogResults}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Provenance}" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                <TextBlock Text="{Binding RequiredEnvironmentLabel}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                           FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                           IsVisible="{Binding NeedsConfiguration}"
                                           ToolTip.Tip="These environment variables are added empty on install — fill them in under Configured servers before the server will work." />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="seg" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanInstall}"
                                    Command="{Binding $parent[ItemsControl].DataContext.InstallMcpCatalogEntryCommand}" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Configured servers (with scope + run location) -->
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
        <TextBlock Text="Configured servers" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
        <ItemsControl ItemsSource="{Binding McpServers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,3" ColumnSpacing="8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" />
                            <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                <Run Text="{Binding RunAt}" /><Run Text=" · " /><Run Text="{Binding Transport}" /><Run Text=" · " /><Run Text="{Binding ApplyScope}" />
                            </TextBlock>
                        </StackPanel>
                        <!-- The row used to render the raw bool ("True"/"False") next to a button
                             called "Toggle", which says neither what state you're in nor what the
                             click will do. Now both are named. -->
                        <TextBlock Grid.Column="1" Text="enabled" Foreground="{DynamicResource Good}" FontSize="10" VerticalAlignment="Center"
                                   IsVisible="{Binding Enabled}" />
                        <TextBlock Grid.Column="1" Text="disabled" Foreground="{DynamicResource FgFaint}" FontSize="10" VerticalAlignment="Center"
                                   IsVisible="{Binding !Enabled}" />
                        <Button Grid.Column="2" Content="Disable" Classes="seg" IsVisible="{Binding Enabled}"
                                Command="{Binding $parent[ItemsControl].DataContext.ToggleMcpServerCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Content="Enable" Classes="seg" IsVisible="{Binding !Enabled}"
                                Command="{Binding $parent[ItemsControl].DataContext.ToggleMcpServerCommand}" CommandParameter="{Binding}" />
                        <Button Classes="danger" Grid.Column="3" Content="Remove" FontSize="11" Padding="9,3"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveMcpServerCommand}" CommandParameter="{Binding Id}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Add a server by hand (reuses the shared MCP composer fields) -->
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
        <TextBlock Text="Add a server" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
        <StackPanel Spacing="6">
            <TextBox Text="{Binding NewMcpName, Mode=TwoWay}" Watermark="Server name" FontSize="12" Padding="8,5" CornerRadius="6" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Host" Command="{Binding SetNewMcpRunAtCommand}" CommandParameter="host" Classes.on="{Binding NewMcpRunAtHost}" Classes="seg" />
                <Button Content="Sandbox" Command="{Binding SetNewMcpRunAtCommand}" CommandParameter="sandbox" Classes.on="{Binding NewMcpRunAtSandbox}" Classes="seg" />
                <Button Content="stdio" Command="{Binding SetNewMcpTransportCommand}" CommandParameter="stdio" Classes.on="{Binding NewMcpIsStdio}" Classes="seg" />
                <Button Content="http" Command="{Binding SetNewMcpTransportCommand}" CommandParameter="http" Classes.on="{Binding NewMcpIsHttp}" Classes="seg" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding NewMcpIsStdio}">
                <TextBox Text="{Binding NewMcpCommand, Mode=TwoWay}" Watermark="command (e.g. npx)" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                <TextBox Text="{Binding NewMcpArgs, Mode=TwoWay}" Watermark="args (space-separated)" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
            <TextBox IsVisible="{Binding NewMcpIsHttp}" Text="{Binding NewMcpUrl, Mode=TwoWay}" Watermark="https://server/mcp" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
            <Button Content="Add server" Command="{Binding AddMcpServerCommand}" HorizontalAlignment="Left" Classes="seg" />
        </StackPanel>

        <!-- Effective-config preview -->
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
        <TextBlock Text="Would be active" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
        <TextBlock Classes="scopeNote" TextWrapping="Wrap"
                   Text="The scope-filtered answer for a plain session started right now — including servers from a CLI's own config that Agnes doesn't manage. Recomputed whenever you change something above." />
        <TextBlock Text="{Binding McpPreviewStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding EffectiveMcp}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="0" Margin="2,1,0,0">
                        <TextBlock Foreground="{DynamicResource FgDim}" FontSize="11">
                            <Run Text="{Binding Name}" /><Run Text="  ·  " /><Run Text="{Binding RunAt}" /><Run Text="  ·  " /><Run Text="{Binding ApplyScope}" />
                        </TextBlock>
                        <!-- Native-config servers (Agnes didn't add them) are read-only; label their origin CLI. -->
                        <TextBlock IsVisible="{Binding NativeConfig}" Foreground="{DynamicResource FgFaint}" FontSize="10" Margin="0,0,0,2">
                            <Run Text="read-only · from " /><Run Text="{Binding Source}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
