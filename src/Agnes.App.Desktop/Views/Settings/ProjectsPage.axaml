<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:sys="using:System"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             x:Class="Agnes.App.Desktop.Views.Settings.ProjectsPage">
    <!-- PROJECTS (per-repo, on the host). The use cases: change one project's VM size; see which project
         has a device attached; give one project an MCP server; know whether the edit is saved. So the
         editor's header carries the project's name, an "Unsaved changes" tag and Save — always in view —
         and the settings below are grouped by what they are. -->
    <StackPanel Spacing="16">
        <ctl:SettingsPageHeader Title="Projects" Scope="{Binding ActiveHostName}"
                                Purpose="Per-repository settings a session inherits: its sandbox image, VM size, devices, MCP servers, GitHub account and defaults. A session in a repository uses that repository's project, created the first time it is seen.">
            <ctl:SettingsPageHeader.Actions>
                <Button Classes="icon" Command="{Binding LoadProjectsCommand}" ToolTip.Tip="Refresh">
                    <ic:SymbolIcon Symbol="ArrowSync" />
                </Button>
            </ctl:SettingsPageHeader.Actions>
        </ctl:SettingsPageHeader>

        <TextBlock Classes="status" Text="{Binding ProjectsStatus}" />

        <Grid ColumnDefinitions="260,*" ColumnSpacing="16">
            <!-- The list: one row per project, the open one marked. Switching away from unsaved edits asks
                 for a second click (the status line says so) rather than dropping them. -->
            <Border Grid.Column="0" Classes="rows" Padding="6" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding ProjectRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="navitem" Classes.on="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="10,8" Command="{Binding $parent[ItemsControl].DataContext.SelectProjectCommand}" CommandParameter="{Binding Project}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <ic:SymbolIcon Grid.Column="0" Symbol="Folder" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                            <Border Classes="tag" IsVisible="{Binding IsDefault}">
                                                <TextBlock Text="fallback" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RepoKey}" Classes="meta mono" IsVisible="{Binding !IsDefault}" />
                                        <TextBlock Text="every other repository" Classes="meta" IsVisible="{Binding IsDefault}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- The editor -->
            <StackPanel Grid.Column="1" Spacing="14" IsVisible="{Binding HasSelectedProject}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding SelectedProject.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                            <Border Classes="tag attention" IsVisible="{Binding IsProjectDirty}">
                                <TextBlock Text="Unsaved changes" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedProjectSubtitle}" Classes="meta" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsSavingProject}"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
                        <Button Content="Save project" Classes="primary" Command="{Binding SaveProjectCommand}" IsEnabled="{Binding !IsSavingProject}"
                                ToolTip.Tip="Saving rebuilds this project's sandbox image, which takes a few minutes" />
                    </StackPanel>
                </Grid>

                <ctl:SettingsSection Title="Project">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="Name" />
                        <TextBox Text="{Binding ProjName, Mode=TwoWay}" FontSize="13" Padding="8,5" CornerRadius="6" />
                    </StackPanel>
                </ctl:SettingsSection>

                <ctl:SettingsSection Title="Sandbox image"
                                     Description="What this project's VM image contains. Saving rebuilds it; sessions in this repository launch from it."
                                     Hint="The image is baked once per project from the base image plus what you list here, so a session starts with its tools already installed rather than installing them every time."
                                     Security="Anything you add here becomes available to this project's sandboxed agents.">
                    <StackPanel Spacing="10">
                        <CheckBox IsChecked="{Binding ProjNode, Mode=TwoWay}" Foreground="{DynamicResource Fg}" Content="Install Node.js and npm" />
                        <!-- apt gets the whole row: it is the long list; npm and pip are usually a word or two. -->
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="apt packages" />
                            <TextBox Text="{Binding ProjApt, Mode=TwoWay}" Watermark="git ripgrep cargo" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{DynamicResource MonoFont}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="npm globals" />
                                <TextBox Text="{Binding ProjNpm, Mode=TwoWay}" Watermark="typescript" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{DynamicResource MonoFont}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="pip packages" />
                                <TextBox Text="{Binding ProjPip, Mode=TwoWay}" Watermark="ruff" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{DynamicResource MonoFont}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="help" Text="Space-separated. Installed into the image when the project is saved." />
                    </StackPanel>
                </ctl:SettingsSection>

                <ctl:SettingsSection Title="Virtual machine"
                                     Description="The size of this project's sandbox VM, and any host USB devices it gets."
                                     Hint="Leave a size blank to inherit the host's default (2 CPUs, 12 GiB RAM, 16 GiB disk). Sizes apply to sessions opened after saving. A USB device is passed through raw: the guest sees the real device and the host loses it while a session holds it."
                                     Security="An agent with a device gets everything the device allows — adb can install, wipe app data and sideload. Attach only devices you would hand the agent. The host operator must also allow passthrough (Agnes:Security:AllowUsbPassthrough); a fork of a session never inherits a device.">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="CPUs" />
                                <TextBox Text="{Binding ProjCpu, Mode=TwoWay}" Watermark="host default" FontSize="12" Padding="8,5" CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="RAM (GiB)" />
                                <TextBox Text="{Binding ProjMemoryGiB, Mode=TwoWay}" Watermark="host default" FontSize="12" Padding="8,5" CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Disk (GiB)" />
                                <TextBox Text="{Binding ProjDiskGiB, Mode=TwoWay}" Watermark="host default" FontSize="12" Padding="8,5" CornerRadius="6" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="USB devices" />
                            <Border Classes="rows flat">
                                <ItemsControl ItemsSource="{Binding ProjectUsb}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="row" Padding="0,7">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <ic:SymbolIcon Grid.Column="0" Symbol="UsbPlug" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="2,0,2,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding Label, TargetNullValue=USB device}" Classes="rowTitle" />
                                                        <TextBlock Text="{Binding Ids}" Classes="meta mono" />
                                                    </StackPanel>
                                                    <Button Classes="danger" Grid.Column="2" Content="Remove" FontSize="11" Padding="9,3"
                                                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveProjectUsbCommand}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding HostUsbDevices}" SelectedItem="{Binding SelectedHostUsb, Mode=TwoWay}"
                                          PlaceholderText="A device plugged into the host…" HorizontalAlignment="Stretch" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Label}" FontSize="12" />
                                                <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource FgFaint}" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Classes="icon" Command="{Binding LoadHostUsbCommand}" ToolTip.Tip="List the devices plugged into the host">
                                    <ic:SymbolIcon Symbol="ArrowSync" />
                                </Button>
                                <Button Grid.Column="2" Content="Add device" Command="{Binding AddProjectUsbCommand}" Classes="seg" FontSize="12" />
                            </Grid>
                            <TextBox Text="{Binding NewUsbId, Mode=TwoWay}" Watermark="Or type vendor:product, e.g. 0e8d:201c — add /serial to pin one unit"
                                     FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{DynamicResource MonoFont}" />
                            <TextBlock Text="{Binding HostUsbStatus}" Classes="help"
                                       IsVisible="{Binding HostUsbStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>
                </ctl:SettingsSection>

                <ctl:SettingsSection Title="MCP servers"
                                     Description="Servers only this project's sessions get, on top of the host's own list."
                                     Hint="A host-run server is proxied into the sandbox through the audited forward; a sandbox-run server runs inside the VM. Changes apply on the next session start.">
                    <StackPanel Spacing="8">
                        <Border Classes="rows flat">
                            <ItemsControl ItemsSource="{Binding ProjectMcp}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="row" Padding="0,7">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <ic:SymbolIcon Grid.Column="0" Symbol="PlugDisconnected" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="2,0,2,0" />
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Classes="rowTitle" />
                                                    <TextBlock Classes="meta">
                                                        <Run Text="{Binding Transport}" /><Run Text=" · runs at " /><Run Text="{Binding RunAt}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Classes="danger" Grid.Column="2" Content="Remove" FontSize="11" Padding="9,3"
                                                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveProjectMcpCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="No project-only servers. Sessions still get the host's MCP servers." Classes="help"
                                   IsVisible="{Binding !HasProjectMcp}" />
                        <Expander Header="Add a server" Padding="0,8,0,0">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="Name" />
                                    <TextBox Text="{Binding NewMcpName, Mode=TwoWay}" Watermark="playwright" FontSize="12" Padding="8,5" CornerRadius="6" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Runs at" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Host" Command="{Binding SetNewMcpRunAtCommand}" CommandParameter="host" Classes.on="{Binding NewMcpRunAtHost}" Classes="seg" />
                                    <Button Grid.Column="2" Content="Sandbox" Command="{Binding SetNewMcpRunAtCommand}" CommandParameter="sandbox" Classes.on="{Binding NewMcpRunAtSandbox}" Classes="seg" />
                                    <TextBlock Grid.Column="3" Classes="fieldLabel" Text="Transport" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <Button Grid.Column="4" Content="stdio" Command="{Binding SetNewMcpTransportCommand}" CommandParameter="stdio" Classes.on="{Binding NewMcpIsStdio}" Classes="seg" />
                                    <Button Grid.Column="5" Content="http" Command="{Binding SetNewMcpTransportCommand}" CommandParameter="http" Classes.on="{Binding NewMcpIsHttp}" Classes="seg" />
                                </Grid>
                                <Grid ColumnDefinitions="*,2*" ColumnSpacing="8" IsVisible="{Binding NewMcpIsStdio}">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="Command" />
                                        <TextBox Text="{Binding NewMcpCommand, Mode=TwoWay}" Watermark="npx" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{DynamicResource MonoFont}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="Arguments" />
                                        <TextBox Text="{Binding NewMcpArgs, Mode=TwoWay}" Watermark="-y @playwright/mcp@latest" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{DynamicResource MonoFont}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4" IsVisible="{Binding NewMcpIsHttp}">
                                    <TextBlock Classes="fieldLabel" Text="URL" />
                                    <TextBox Text="{Binding NewMcpUrl, Mode=TwoWay}" Watermark="https://server/mcp" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{DynamicResource MonoFont}" />
                                </StackPanel>
                                <Button Content="Add server" Command="{Binding AddProjectMcpCommand}" HorizontalAlignment="Left" Classes="seg" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ctl:SettingsSection>

                <ctl:SettingsSection Title="GitHub"
                                     Description="Which linked account this project pushes as, and what it checks out."
                                     Hint="Access decides whether a sandboxed agent may push at all: Off gives it no credentials, Ask approves each repository once, Trust allows every repository the account can reach.">
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Account" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding GitHubAccounts}" SelectedItem="{Binding ProjAccount, Mode=TwoWay}"
                                  MinWidth="220" HorizontalAlignment="Left" PlaceholderText="The host's default account" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Access" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding ProjGitMode, Mode=TwoWay}" MinWidth="140" HorizontalAlignment="Left">
                            <sys:String>Off</sys:String>
                            <sys:String>Ask</sys:String>
                            <sys:String>Trust</sys:String>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Checkout" VerticalAlignment="Top" Margin="0,7,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <TextBox Text="{Binding ProjRepo, Mode=TwoWay}" Watermark="owner/repo or https://github.com/owner/repo — optional"
                                     FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{DynamicResource MonoFont}" />
                            <TextBlock Classes="help" Text="Cloned into the working directory before the agent launches, when the directory is empty. Needs an account with access." />
                        </StackPanel>
                    </Grid>
                </ctl:SettingsSection>

                <ctl:SettingsSection Title="Defaults for new sessions"
                                     Description="How a session in this repository opens unless you say otherwise at the time.">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="MCP tools" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedItem="{Binding ProjMcpApproval, Mode=TwoWay}" MinWidth="140" HorizontalAlignment="Left"
                                      ToolTip.Tip="Ask: approve each MCP tool call. Trust: let them run.">
                                <sys:String>Ask</sys:String>
                                <sys:String>Trust</sys:String>
                            </ComboBox>
                        </Grid>
                        <CheckBox IsChecked="{Binding ProjSkipPermissions, Mode=TwoWay}" Foreground="{DynamicResource Fg}" Content="Autonomous by default"
                                  ToolTip.Tip="The agent runs without asking permission for each tool call. Confined to a sandbox unless the host allows otherwise." />
                        <CheckBox IsChecked="{Binding ProjGraphical, Mode=TwoWay}" Foreground="{DynamicResource Fg}" Content="Graphical sandbox by default"
                                  ToolTip.Tip="Open sessions in a VM with a screen the agent can see and drive. Only where the host allows graphical sandboxes." />
                    </StackPanel>
                </ctl:SettingsSection>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
