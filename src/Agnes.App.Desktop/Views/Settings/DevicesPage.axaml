<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:sys="using:System"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             xmlns:km="using:Agnes.App.Desktop.Keymaps"
             x:Class="Agnes.App.Desktop.Views.Settings.DevicesPage">
    <!-- DEVICES (host) -->
    <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Devices" />
            <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                          Description="Every client paired with this host has its own token. Revoke one to cut off a lost or unwanted device without affecting the others."
                          Security="Tokens are stored only as hashes on the host. Anyone holding a valid token has full access to this host's sessions." />
            <Button Grid.Column="3" Content="Refresh" Command="{Binding LoadDevicesCommand}" Classes="seg" />
        </Grid>
        <TextBlock Classes="scopeNote">
            <Run Text="Paired with the host:" /><Run Text=" " /><Run Text="{Binding ActiveHostName}" FontWeight="SemiBold" />
        </TextBlock>

        <!-- Devices asking to join, above the paired list: this is the decision that
             hasn't been made yet, and it's the one worth reading carefully. The digits are
             derived from the asking device's own key, so the comparison is the security
             check — approving without it proves nothing. -->
        <StackPanel Spacing="8" IsVisible="{Binding HasPendingApprovals}">
            <TextBlock Text="Asking to join" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding PendingApprovals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                        <Run Text="Check it shows" /><Run Text=" " /><Run Text="{Binding VerificationCode}" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Fg}" /><Run Text=" " /><Run Text="before approving" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Classes="danger" Grid.Column="1" Content="Decline" FontSize="11" Padding="9,3"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        Command="{Binding $parent[ItemsControl].DataContext.DenyDeviceCommand}" CommandParameter="{Binding RequestId}" />
                                <!-- Two ways in, not one: a member is the ordinary answer, and handing over
                                     the run of the host is a separate deliberate click that only an owner
                                     is offered at all. -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Let in as member" FontSize="11" Padding="9,3" Classes="seg"
                                            ToolTip.Tip="It can open sessions and see its own"
                                            Command="{Binding $parent[ItemsControl].DataContext.ApproveDeviceCommand}" CommandParameter="{Binding RequestId}" />
                                    <Button Content="Let in as owner" FontSize="11" Padding="9,3" Classes="seg"
                                            ToolTip.Tip="It sees everything on this host and can manage devices"
                                            IsVisible="{Binding $parent[ItemsControl].DataContext.CanManageDevices}"
                                            Command="{Binding $parent[ItemsControl].DataContext.ApproveDeviceAsOwnerCommand}" CommandParameter="{Binding RequestId}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Last-seen is the field that answers "which of these is stale?", and the device you're
             sitting at is marked because revoking it signs this app out. Revoke arms on the first
             click and commits on the second. -->
        <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,3">
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" VerticalAlignment="Center" />
                                <!-- The role, in neutral text. Deliberately not a status hue: those mean
                                     working / blocked / done / failed, and a role is none of those. -->
                                <Border Name="RoleChip" CornerRadius="8" Padding="7,1" Background="{DynamicResource PanelAlt}" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <TextBlock Text="{Binding RoleChip}" FontSize="10" Foreground="{DynamicResource FgDim}" />
                                </Border>
                                <Border CornerRadius="8" Padding="7,1" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"
                                        IsVisible="{Binding IsCurrentDevice}">
                                    <TextBlock Text="this device" FontSize="10" Foreground="{DynamicResource Fg}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding DetailLine}" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                        </StackPanel>
                        <Button Name="RoleButton" Grid.Column="1" Classes="seg" Content="{Binding RoleActionLabel}" FontSize="11" Padding="9,3"
                                IsVisible="{Binding $parent[ItemsControl].DataContext.CanManageDevices}"
                                IsEnabled="{Binding CanChangeRole}" ToolTip.Tip="{Binding RoleActionTooltip}"
                                Command="{Binding $parent[ItemsControl].DataContext.SetDeviceRoleCommand}" CommandParameter="{Binding}" />
                        <Button Classes="danger" Grid.Column="2" Content="{Binding RevokeLabel}" FontSize="11" Padding="9,3"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Command="{Binding $parent[ItemsControl].DataContext.RevokeDeviceCommand}" CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- A member sees the same list, read-only, and is told why rather than left to
             wonder where the other buttons went. -->
        <TextBlock Name="OnlyOwnersNote" Text="{Binding OnlyOwnersNote}" IsVisible="{Binding ShowOnlyOwnersNote}"
                   Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />

        <Button Name="PruneDevicesButton" Classes="seg" HorizontalAlignment="Left" FontSize="11" Padding="9,3"
                IsVisible="{Binding CanManageDevices}" Content="{Binding PruneButtonLabel}"
                ToolTip.Tip="The host never removes this device, and never the last owner"
                Command="{Binding PruneDevicesCommand}" />

        <TextBlock Text="{Binding DevicesStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
