<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             x:Class="Agnes.App.Desktop.Views.Settings.KeymapPage">
    <!-- KEYMAP (this device). The question is "what is the key for X?", so every row is a key cap and a
         sentence; the ids are there for the file, in the faint mono of things one copies. -->
    <UserControl.Styles>
        <!-- A key cap: a tag in the mono font, so a chord reads like the keys on a keyboard. -->
        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.keycap > TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Border.keycap.unassigned">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.keycap.unassigned > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="16">
        <ctl:SettingsPageHeader Title="Keymap" Scope="This device"
                                Purpose="Every shortcut in the app, and the file that overrides them. Edit the file and the change applies as you save it.">
            <ctl:SettingsPageHeader.Actions>
                <Button Content="Edit keymap file" Classes="seg" Command="{Binding EditKeymapCommand}"
                        ToolTip.Tip="Opens the override file in your editor, creating an empty one the first time" />
            </ctl:SettingsPageHeader.Actions>
        </ctl:SettingsPageHeader>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding KeymapPath}" Classes="meta mono" VerticalAlignment="Center" />
            <TextBlock Text="·" Classes="meta" VerticalAlignment="Center" />
            <TextBlock Text="{Binding KeymapStatus}" Classes="meta" VerticalAlignment="Center" />
        </StackPanel>

        <ctl:SettingsSection Title="The keymap file has a problem" Classes="error" IsVisible="{Binding HasKeymapDiagnostic}"
                             Description="The packaged defaults are in effect until it parses.">
            <TextBlock Text="{Binding KeymapDiagnostic}" Foreground="{DynamicResource StatusError}" TextWrapping="Wrap"
                       FontFamily="{DynamicResource MonoFont}" FontSize="11" />
        </ctl:SettingsSection>

        <TextBlock Text="Nothing matches that search." Classes="status" IsVisible="{Binding !HasKeymapMatches}" />

        <ItemsControl ItemsSource="{Binding KeymapGroups}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ctl:SettingsSection Title="{Binding Title}">
                        <Border Classes="rows flat">
                            <ItemsControl ItemsSource="{Binding Commands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="row" Padding="0,7">
                                            <Grid ColumnDefinitions="230,*,Auto,Auto" ColumnSpacing="12">
                                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Gestures}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="keycap" Margin="0,2,6,2"
                                                                    Classes.unassigned="{Binding $parent[ItemsControl].DataContext.IsUnassigned}">
                                                                <TextBlock Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" Classes="rowTitle" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding CommandId}" Classes="meta mono" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="tag" ToolTip.Tip="Where the shortcut applies">
                                                    <TextBlock Text="{Binding Context}" />
                                                </Border>
                                                <Button Grid.Column="3" Classes="icon" Padding="5" IsEnabled="{Binding CanCopyJson}" Click="OnCopyKeymapJson"
                                                        ToolTip.Tip="Copy as a JSON rule, to paste into the keymap file">
                                                    <ic:SymbolIcon Symbol="Copy" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ctl:SettingsSection>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
