<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:sys="using:System"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             xmlns:km="using:Agnes.App.Desktop.Keymaps"
             x:Class="Agnes.App.Desktop.Views.Settings.CollaboratorsPage">
    <!-- Collaborators & access grants (collaboration/01) -->
    <StackPanel>
        <StackPanel DataContext="{Binding Collaborators}" Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Collaborators" />
                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Classes="seg" />
            </Grid>
            <TextBlock Classes="scopeNote"
                       Text="A collaborator is a GitHub-verified user. Being a collaborator (or sharing a configured org/team) only makes someone eligible — it shares nothing on its own. Access is conferred only by an explicit, revocable grant below. Owner-only." />

            <!-- Add a collaborator by GitHub handle, with a live eligibility hint -->
            <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding NewCollaboratorHandle, Mode=TwoWay}" PlaceholderText="GitHub handle" />
                <TextBox Grid.Column="1" Text="{Binding NewCollaboratorDisplayName, Mode=TwoWay}" PlaceholderText="Display name (optional)" />
                <Button Grid.Column="2" Content="Check" Command="{Binding CheckEligibilityCommand}" Classes="seg" />
                <Button Grid.Column="3" Content="Add collaborator" Command="{Binding AddCollaboratorCommand}" Classes="seg" />
            </Grid>
            <TextBlock Text="{Binding EligibilityHint}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding EligibilityHint, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

            <!-- Each row says why the person is listed (added by hand vs surfaced from a shared
                 org/team) and can re-check its own eligibility, instead of making you retype the
                 handle into the box above to find out. -->
            <ItemsControl ItemsSource="{Binding Collaborators}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding GitHubLogin}" Foreground="{DynamicResource Fg}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                        <Run Text="{Binding SourceLabel}" /><Run Text=" · " /><Run Text="{Binding AddedLabel}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding EligibilityNote}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                               IsVisible="{Binding HasEligibilityNote}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Check" Classes="seg" VerticalAlignment="Center"
                                        ToolTip.Tip="Ask the host, now, whether this person is currently eligible for a grant."
                                        Command="{Binding $parent[ItemsControl].DataContext.CheckCollaboratorEligibilityCommand}" CommandParameter="{Binding}" />
                                <Button Grid.Column="2" Content="Remove" Classes="seg" VerticalAlignment="Center"
                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveCollaboratorCommand}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Grant access to an eligible collaborator. What a grant names used to be a free-text
                 "resource id" with no discoverable values; it's now a picker built from the host
                 and its open sessions. -->
            <TextBlock Classes="sectionTitle" Text="Access grants" Margin="0,6,0,0" />
            <TextBlock Classes="scopeNote" TextWrapping="Wrap"
                       Text="A grant is recorded here and honoured wherever a feature asks for it. To hand someone a session today, use Share on that session — that path enforces access itself." />
            <TextBlock Classes="scopeNote" Text="Connect a host, and open a session, to have something to grant against."
                       IsVisible="{Binding !HasGrantTargets}" />
            <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding HasGrantTargets}">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Collaborators}" SelectedItem="{Binding SelectedCollaborator, Mode=TwoWay}"
                          PlaceholderText="Collaborator" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding GitHubLogin}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GrantTargets}" SelectedItem="{Binding SelectedGrantTarget, Mode=TwoWay}"
                          PlaceholderText="What they get" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Scopes}" SelectedItem="{Binding NewGrantScope, Mode=TwoWay}" />
                <Button Grid.Column="3" Content="Grant" Command="{Binding GrantCommand}" Classes="seg" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Grants}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GranteeLogin}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                    <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                        <Run Text="{Binding Resource}" /><Run Text=" · " /><Run Text="{Binding Scope}" /><Run Text=" · granted " /><Run Text="{Binding GrantedAt, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Revoke" Classes="seg"
                                        Command="{Binding $parent[ItemsControl].DataContext.RevokeGrantCommand}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
