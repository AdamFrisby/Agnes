<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             x:Class="Agnes.App.Desktop.Views.Settings.CollaboratorsPage">
    <!-- COLLABORATORS (host). Two lists: the people who may be given access, and the access they have been given. -->
    <StackPanel Spacing="16">
        <ctl:SettingsPageHeader Title="Collaborators" Scope="{Binding ActiveHostName}"
                                Purpose="The people who may be given access to this host's sessions, and the access they have. Being listed makes someone eligible; only a grant lets them in.">
            <ctl:SettingsPageHeader.Actions>
                <Button Classes="icon" Command="{Binding Collaborators.RefreshCommand}" ToolTip.Tip="Refresh">
                    <ic:SymbolIcon Symbol="ArrowSync" />
                </Button>
            </ctl:SettingsPageHeader.Actions>
        </ctl:SettingsPageHeader>

        <StackPanel DataContext="{Binding Collaborators}" Spacing="16">
            <TextBlock Classes="status" Text="{Binding Status}" />

            <ctl:SettingsSection Title="People"
                                 Hint="A collaborator is a GitHub-verified user. Add one by handle, or configure a shared org or team on the host and its members are eligible without being listed. Check asks GitHub whether a handle qualifies right now."
                                 Security="Eligibility shares nothing on its own. Access is conferred only by an explicit, revocable grant below, and only an Owner can make one.">
                <StackPanel Spacing="10">
                    <!-- Add a person: handle, an optional display name, and a check that answers before you commit. -->
                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding NewCollaboratorHandle, Mode=TwoWay}" Watermark="GitHub handle" FontSize="12" Padding="8,5" CornerRadius="6" />
                        <TextBox Grid.Column="1" Text="{Binding NewCollaboratorDisplayName, Mode=TwoWay}" Watermark="Display name (optional)" FontSize="12" Padding="8,5" CornerRadius="6" />
                        <Button Grid.Column="2" Content="Check" Command="{Binding CheckEligibilityCommand}" Classes="seg" FontSize="12"
                                ToolTip.Tip="Ask GitHub whether this handle is eligible right now, without adding it" />
                        <Button Grid.Column="3" Content="Add" Command="{Binding AddCollaboratorCommand}" Classes="primary" FontSize="12" />
                    </Grid>
                    <TextBlock Text="{Binding EligibilityHint}" Classes="help"
                               IsVisible="{Binding EligibilityHint, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                    <Border Classes="rows flat" IsVisible="{Binding HasCollaborators}">
                        <ItemsControl ItemsSource="{Binding Collaborators}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="row" Padding="0,9">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="PersonCircle" FontSize="18" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding GitHubLogin}" Classes="rowTitle" />
                                                    <TextBlock Text="{Binding DisplayName}" Classes="meta" VerticalAlignment="Center"
                                                               IsVisible="{Binding DisplayName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                                    <!-- Eligible is a healthy fact (mint); not eligible needs you (amber); a failed check is neutral text. -->
                                                    <Border Classes="tag" Classes.done="{Binding IsKnownEligible}" Classes.attention="{Binding IsKnownIneligible}"
                                                            IsVisible="{Binding HasEligibilityNote}">
                                                        <TextBlock Text="{Binding EligibilityNote}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Classes="meta">
                                                    <Run Text="{Binding SourceLabel}" /><Run Text=" · " /><Run Text="{Binding AddedLabel}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Check" Classes="seg" FontSize="11" Padding="9,3"
                                                    ToolTip.Tip="Ask the host, now, whether this person is currently eligible for a grant"
                                                    Command="{Binding $parent[ItemsControl].DataContext.CheckCollaboratorEligibilityCommand}" CommandParameter="{Binding}" />
                                            <Button Classes="danger" Grid.Column="3" Content="Remove" FontSize="11" Padding="9,3"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveCollaboratorCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ctl:EmptyState Symbol="PersonAdd" Title="No collaborators yet" IsVisible="{Binding !HasCollaborators}"
                                    Text="Add a GitHub user above to make them eligible for a grant. Members of a shared org or team configured on the host are eligible without being listed." />
                </StackPanel>
            </ctl:SettingsSection>

            <ctl:SettingsSection Title="Access grants"
                                 Hint="A grant is recorded here and honoured wherever a feature asks for it. To hand someone a session today, use Share on that session — that path enforces access itself."
                                 Security="Owner-only. Revoking a grant takes effect at the next check; it does not close a session already open.">
                <StackPanel Spacing="10">
                    <TextBlock Classes="help" Text="Connect a host and open a session to have something to grant against."
                               IsVisible="{Binding !HasGrantTargets}" />
                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding HasGrantTargets}">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Collaborators}" SelectedItem="{Binding SelectedCollaborator, Mode=TwoWay}"
                                  PlaceholderText="Who" HorizontalAlignment="Stretch" FontSize="12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GitHubLogin}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding GrantTargets}" SelectedItem="{Binding SelectedGrantTarget, Mode=TwoWay}"
                                  PlaceholderText="What they get" HorizontalAlignment="Stretch" FontSize="12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Scopes}" SelectedItem="{Binding NewGrantScope, Mode=TwoWay}" FontSize="12" />
                        <Button Grid.Column="3" Content="Grant" Command="{Binding GrantCommand}" Classes="primary" FontSize="12" />
                    </Grid>

                    <Border Classes="rows flat" IsVisible="{Binding HasGrants}">
                        <ItemsControl ItemsSource="{Binding Grants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="row" Padding="0,9">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Key" FontSize="16" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding GranteeLogin}" Classes="rowTitle" />
                                                    <Border Classes="tag">
                                                        <TextBlock Text="{Binding Scope}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Classes="meta">
                                                    <Run Text="{Binding Resource}" /><Run Text=" · granted " /><Run Text="{Binding GrantedAt, StringFormat=yyyy-MM-dd}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Classes="danger" Grid.Column="2" Content="Revoke" FontSize="11" Padding="9,3"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RevokeGrantCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ctl:EmptyState Symbol="Key" Title="No active grants" IsVisible="{Binding !HasGrants}"
                                    Text="Pick a collaborator and what they get, and the grant appears here. Every grant can be revoked from this list." />
                </StackPanel>
            </ctl:SettingsSection>
        </StackPanel>
    </StackPanel>
</UserControl>
