<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:sys="using:System"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             xmlns:km="using:Agnes.App.Desktop.Keymaps"
             x:Class="Agnes.App.Desktop.Views.Settings.AppearancePage">
    <!-- APPEARANCE (this device) -->
    <StackPanel Spacing="12">
        <TextBlock Classes="sectionTitle" Text="Appearance" />
        <TextBlock Classes="scopeNote" Text="These apply to this app on this device." />

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="fieldLabel" Text="Theme" VerticalAlignment="Center" />
                <ctl:InfoHint Description="The app's colour scheme. System follows your OS light/dark setting; everything else pins it. The Spacegray flavours are ports of the Sublime Text theme (MIT) — see Themes/Spacegray.axaml for the credit." />
            </StackPanel>
            <!-- One row per theme in ThemeCatalog, so adding a theme never touches this view. -->
            <ItemsControl ItemsSource="{Binding Themes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Classes="seg" Margin="0,0,6,6"
                                Classes.on="{Binding IsSelected}"
                                Command="{Binding $parent[ItemsControl].DataContext.SetThemeCommand}"
                                CommandParameter="{Binding Id}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="fieldLabel" Text="Interface font" VerticalAlignment="Center" />
                <ctl:InfoHint Description="Enter the exact name of any installed font family. Leave it blank for the Agnes default (Manrope). Code and terminal text keep the dedicated monospace font." />
            </StackPanel>
            <Grid ColumnDefinitions="280,Auto,Auto" ColumnSpacing="6" HorizontalAlignment="Left">
                <TextBox Grid.Column="0" Text="{Binding FontFamilyInput, Mode=TwoWay}"
                         Watermark="Default (Manrope)" Padding="9,5"
                         AutomationProperties.Name="Interface font family">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ApplyFontFamilyCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Apply" Command="{Binding ApplyFontFamilyCommand}" Classes="seg" />
                <Button Grid.Column="2" Content="Default" Command="{Binding UseDefaultFontCommand}" Classes="seg" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="fieldLabel" Text="UI scale" VerticalAlignment="Center" />
                <ctl:InfoHint Description="Scales the interface with the text so controls and spacing remain proportional." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Small" Command="{Binding SetScaleCommand}" CommandParameter="small" Classes.on="{Binding IsScaleSmall}" Classes="seg" />
                <Button Content="Default" Command="{Binding SetScaleCommand}" CommandParameter="default" Classes.on="{Binding IsScaleDefault}" Classes="seg" />
                <Button Content="Large" Command="{Binding SetScaleCommand}" CommandParameter="large" Classes.on="{Binding IsScaleLarge}" Classes="seg" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="fieldLabel" Text="Chat font size" VerticalAlignment="Center" />
                <ctl:InfoHint Description="Shared by every chat. Use the configurable Increase/Decrease chat font size commands (Cmd+Plus and Cmd+Minus by default on macOS) while a chat is focused." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding ChatFontScaleText}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" MinWidth="38" />
                <Button Content="Reset" Command="{Binding ResetChatFontScaleCommand}" Classes="seg" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox IsChecked="{Binding ReducedMotion, Mode=TwoWay}" Foreground="{DynamicResource Fg}" Content="Reduce motion" />
            <ctl:InfoHint Description="Minimises non-essential animation. Helpful for motion sensitivity or lower-powered displays." />
        </StackPanel>
    </StackPanel>
</UserControl>
