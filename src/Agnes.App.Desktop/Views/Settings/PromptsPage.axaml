<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             xmlns:km="using:Agnes.App.Desktop.Keymaps"
             x:Class="Agnes.App.Desktop.Views.Settings.PromptsPage">
    <!-- PROMPTS (host library). Three things, each its own section: the prompts you saved, the slash
         tokens that expand them in the composer, and the skill bundles installed from a registry. -->
    <StackPanel DataContext="{Binding PromptLibrary}" Spacing="16">
        <ctl:SettingsPageHeader Title="Prompts"
                                Purpose="Prompts you would otherwise retype, saved on the host. Bind a slash token to one and it drops into the composer as you type — or sends itself.">
            <ctl:SettingsPageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="New prompt" Command="{Binding NewPromptCommand}" IsVisible="{Binding IsEditingExistingPrompt}" />
                    <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
                        <ic:SymbolIcon Symbol="ArrowSync" />
                    </Button>
                </StackPanel>
            </ctl:SettingsPageHeader.Actions>
        </ctl:SettingsPageHeader>

        <TextBlock Classes="status" Text="{Binding Status}" />

        <!-- 1. Saved prompts. The preview line is what tells two similarly-named prompts apart; the tokens
             say how each is invoked without a trip to the templates section. -->
        <ctl:SettingsSection Title="Saved prompts"
                             Hint="A prompt marked as a system-prompt addition is prepended to every new session's system prompt at open, rather than inserted per message.">
            <StackPanel>
                <Border Classes="rows flat" IsVisible="{Binding HasPrompts}">
                    <ItemsControl ItemsSource="{Binding PromptRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="row" Padding="0,9">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <ic:SymbolIcon Grid.Column="0" Symbol="DocumentText" FontSize="17" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Title}" Classes="rowTitle" />
                                                <Border Classes="tag on" IsVisible="{Binding HasTokens}" ToolTip.Tip="Type this in the composer to insert the prompt">
                                                    <TextBlock Text="{Binding TokensLabel}" FontFamily="{DynamicResource MonoFont}" />
                                                </Border>
                                                <Border Classes="tag" IsVisible="{Binding IsSystemPromptAddition}"
                                                        ToolTip.Tip="Prepended to a session's system prompt at open, rather than inserted per message.">
                                                    <TextBlock Text="system prompt" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Preview}" Classes="meta" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Edit" Classes="seg" FontSize="11" Padding="9,3" VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].DataContext.EditPromptCommand}" CommandParameter="{Binding Prompt}" />
                                        <Button Grid.Column="3" Content="Delete" Classes="danger" FontSize="11" Padding="9,3" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Command="{Binding $parent[ItemsControl].DataContext.DeletePromptCommand}" CommandParameter="{Binding Prompt}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ctl:EmptyState Symbol="DocumentText" Title="No saved prompts yet" IsVisible="{Binding !HasPrompts}"
                                Text="Save a prompt you keep retyping below. Bind a slash token to it and typing /review in the composer inserts it." />
            </StackPanel>
        </ctl:SettingsSection>

        <!-- The editor. One set of fields serves both "new" and "edit", so which one it is doing is the
             card's title — otherwise Save silently overwrites whatever you last clicked Edit on. -->
        <ctl:SettingsSection Title="{Binding EditorHeading}">
            <ctl:SettingsSection.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="tag attention" IsVisible="{Binding IsEditingExistingPrompt}">
                        <TextBlock Text="Save replaces it" />
                    </Border>
                    <Button Content="Cancel edit" Classes="chip" FontSize="11" Padding="10,3" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditingExistingPrompt}" />
                </StackPanel>
            </ctl:SettingsSection.Actions>
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="Title" />
                    <TextBox Text="{Binding PromptTitle, Mode=TwoWay}" Watermark="Security review" FontSize="12" Padding="8,5" CornerRadius="6" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="Prompt" />
                    <TextBox Text="{Binding PromptBody, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                             Watermark="Review this diff for security issues…" FontSize="12" Padding="8,5" CornerRadius="6" />
                    <TextBlock Classes="help" Text="Markdown is fine; it goes to the agent as written." />
                </StackPanel>
                <StackPanel Spacing="2">
                    <CheckBox IsChecked="{Binding PromptIsSystemAddition, Mode=TwoWay}" Content="Use as a system-prompt addition" FontSize="12" />
                    <TextBlock Classes="help" Margin="28,0,0,0" Text="Prepended to every new session's system prompt at open, together with the other additions, instead of being inserted per message." />
                </StackPanel>
                <Button Content="{Binding SaveLabel}" Command="{Binding SavePromptCommand}" Classes="primary" HorizontalAlignment="Left" />
            </StackPanel>
        </ctl:SettingsSection>

        <!-- 2. Slash tokens. -->
        <ctl:SettingsSection Title="Slash templates" Description="A token you type in the composer, and the prompt it expands to.">
            <StackPanel Spacing="10">
                <Border Classes="rows flat" IsVisible="{Binding HasTemplates}">
                    <ItemsControl ItemsSource="{Binding Templates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="row" Padding="0,8">
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{Binding SlashLabel}" Foreground="{DynamicResource AccentText}"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <ic:SymbolIcon Symbol="ArrowRight" FontSize="12" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TargetLabel}" Classes="rowTitle" IsVisible="{Binding !IsBroken}" />
                                            <Border Classes="tag error" IsVisible="{Binding IsBroken}" ToolTip.Tip="The prompt this token pointed at was deleted.">
                                                <TextBlock Text="{Binding TargetLabel}" />
                                            </Border>
                                            <Border Classes="tag done" IsVisible="{Binding SendImmediately}" ToolTip.Tip="Inserts the prompt and sends it in one go.">
                                                <TextBlock Text="sends" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Delete" Classes="danger" FontSize="11" Padding="9,3" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Command="{Binding $parent[ItemsControl].DataContext.DeleteTemplateCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ctl:EmptyState Symbol="SlashForward" Title="No slash templates yet" IsVisible="{Binding !HasTemplates}"
                                Text="Bind a token to a saved prompt below. Typing it in the composer inserts the prompt; with Send on, it sends it too." />
                <Grid ColumnDefinitions="140,*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding TemplateToken, Mode=TwoWay}" Watermark="/review" FontSize="12" Padding="8,5" CornerRadius="6"
                             FontFamily="{DynamicResource MonoFont}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Prompts}" SelectedValue="{Binding TemplatePromptId, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Id}" HorizontalAlignment="Stretch" FontSize="12" PlaceholderText="Inserts this prompt">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Column="2" IsChecked="{Binding TemplateSendImmediately, Mode=TwoWay}" Content="Send" FontSize="12" VerticalAlignment="Center"
                              ToolTip.Tip="Insert the prompt and send it in one go" />
                    <Button Grid.Column="3" Content="Save template" Command="{Binding SaveTemplateCommand}" Classes="seg" />
                </Grid>
            </StackPanel>
        </ctl:SettingsSection>

        <!-- 3. Skills. Installing is the point — a delete-only list of skills you cannot acquire is a dead
             end — so every registry the host offers is searched from here, and the registry that could not
             answer is named without hiding the ones that did. -->
        <ctl:SettingsSection Title="Skills"
                             Hint="A skill is a SKILL.md plus its supporting files, installed from a registry the host offers and managed as one unit. Agents pick skills up by name when a task calls for one.">
            <StackPanel Spacing="10">
                <Border Classes="rows flat" IsVisible="{Binding HasSkills}">
                    <ItemsControl ItemsSource="{Binding Skills}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="row" Padding="0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <ic:SymbolIcon Grid.Column="0" Symbol="Book" FontSize="16" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}" Classes="rowTitle" />
                                            <TextBlock Classes="meta"><Run Text="{Binding SupportingFiles.Count}" /><Run Text=" supporting files" /></TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Delete" Classes="danger" FontSize="11" Padding="9,3" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Command="{Binding $parent[ItemsControl].DataContext.DeleteSkillCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Classes="help" Text="No skills installed yet. Search a registry below and install one." IsVisible="{Binding !HasSkills}" />

                <Border Height="1" Background="{DynamicResource Line}" IsVisible="{Binding HasSkillRegistries}" />
                <StackPanel Spacing="8" IsVisible="{Binding HasSkillRegistries}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding SkillQuery, Mode=TwoWay}" FontSize="12" Padding="8,5" CornerRadius="6"
                                 Watermark="Search every skill registry — pdf, terraform, code review…"
                                 km:KeymapBinder.Context="SettingsSkillSearchFocus">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding BrowseRegistryCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Search" Command="{Binding BrowseRegistryCommand}" Classes="seg" />
                        <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center"
                                     IsVisible="{Binding IsSearchingSkills}"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
                    </Grid>
                    <TextBlock Classes="status" Text="{Binding SkillStatus}" />
                    <TextBlock Classes="status error" Text="{Binding SkillFailure}" IsVisible="{Binding HasSkillFailure}" />
                    <Border Classes="rows flat" IsVisible="{Binding HasRegistrySkills}">
                        <ItemsControl ItemsSource="{Binding RegistrySkills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="row" Padding="0,9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Text="{Binding Title}" Classes="rowTitle" />
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                <!-- Publisher, popularity and source: a public index holds many skills of one
                                                     name, and this is how you tell them apart. -->
                                                <TextBlock Text="{Binding Provenance}" Classes="meta" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="seg" VerticalAlignment="Center" FontSize="11" Padding="10,3"
                                                    IsEnabled="{Binding CanInstall}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.InstallSkillCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <TextBlock Classes="status" Text="{Binding SkillStatus}" IsVisible="{Binding !HasSkillRegistries}" />
            </StackPanel>
        </ctl:SettingsSection>
    </StackPanel>
</UserControl>
