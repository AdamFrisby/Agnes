<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tr="using:Agnes.Ui.Core.Transcript"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:icx="using:FluentIcons.Avalonia.Markup"
             xmlns:vm="using:Agnes.Ui.Core.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctb="using:ColorTextBlock.Avalonia"
             xmlns:appconv="using:Agnes.App.Desktop.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             xmlns:km="using:Agnes.App.Desktop.Keymaps"
             xmlns:views="using:Agnes.App.Desktop.Views"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             x:Class="Agnes.App.Desktop.Views.SessionTabView"
             x:Name="SessionView"
             ChatFontScale="{DynamicResource ChatFontScale}"
             Background="{DynamicResource Bg}"
             FontFamily="{DynamicResource UiFont}"
             DragDrop.AllowDrop="True"
             km:KeymapBinder.Context="Session">

    <UserControl.Resources>
        <appconv:IndentConverter x:Key="AgentIndent" Step="16" />
        <appconv:SendPolicyLabelConverter x:Key="SendPolicyLabel" />
        <appconv:BoolToOpacityConverter x:Key="ActiveOpacity" TrueOpacity="1.0" FalseOpacity="0.5" />
        <!-- Plan entries arrive from ACP as free-form status strings, so the tone match is by name. -->
        <appconv:StringEqualsConverter x:Key="PlanDone" Match="completed" />
        <appconv:StringEqualsConverter x:Key="PlanRunning" Match="in_progress" />
        <!-- Where the context meter changes tone: comfortable → getting tight → nearly out. -->
        <appconv:AtLeastConverter x:Key="CtxTight" Threshold="70" />
        <appconv:AtLeastConverter x:Key="CtxCritical" Threshold="90" />
        <!-- Event-log kinds grouped by what they mean, so the log scans by colour like the rest of the app. -->
        <appconv:StringEqualsConverter x:Key="EventInMotion" Match="ToolCall,ToolCallUpdate,McpToolCall,TerminalOutput" />
        <appconv:StringEqualsConverter x:Key="EventBlocked" Match="PermissionRequested,QuestionAsked" />
        <appconv:StringEqualsConverter x:Key="EventSettled" Match="TurnEnded,PermissionResolved,QuestionAnswered" />
        <appconv:StringEqualsConverter x:Key="EventBroken" Match="AgentError" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.user">
            <Setter Property="Background" Value="{DynamicResource UserBubble}" />
        </Style>
        <Style Selector="TextBlock.thought">
            <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <!-- Pulsing dot for the "Thinking…" indicator. -->
        <Style Selector="Border.pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Per-message "⋯" actions: hidden until the pointer is over the message OR keyboard focus is
             within it (Opacity keeps layout stable). Touch/mouse users also get the same actions via the
             bubble's right-click / long-press ContextFlyout, so the menu is reachable without hover. -->
        <Style Selector="Border.msg Button.rowmenu">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.msg:pointerover Button.rowmenu">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.msg:focus-within Button.rowmenu">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Compact tool rows are chromeless; a faint hover fill keeps them discoverable as clickable. -->
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
        <Style Selector="Border.dot">
            <Setter Property="Background" Value="{DynamicResource FgFaint}" />
        </Style>
        <Style Selector="Border.dot.on">
            <Setter Property="Background" Value="{DynamicResource Good}" />
        </Style>
        <!-- activity chip -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        </Style>
        <Style Selector="Border.chip.attention">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        </Style>
        <Style Selector="Border.chip.attention TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <!-- agent-tree node selection -->
        <Style Selector="TreeView Button TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.sel TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- agent picker cards: accent border when chosen, dimmed when unavailable -->
        <Style Selector="Button.agent.sel">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <Style Selector="Button.agent:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <!-- diff rows -->
        <Style Selector="Border.add">
            <Setter Property="Background" Value="{DynamicResource DiffAddBg}" />
        </Style>
        <Style Selector="Border.del">
            <Setter Property="Background" Value="{DynamicResource DiffDelBg}" />
        </Style>
        <Style Selector="Border.hunk">
            <Setter Property="Background" Value="{DynamicResource HunkBg}" />
        </Style>
        <Style Selector="Border.hunk TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HunkFg}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Per-tab status bar -->
        <Border Grid.Row="0" IsVisible="{Binding ShowStatusBar}" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,7">
            <StackPanel Spacing="0">
                <!-- Left cluster is a flexible, clipped column so long host/agent names or many tags can
                     never push the action buttons (right, Auto) off-screen; the metadata yields first. -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                HorizontalAlignment="Left" ClipToBounds="True">
                        <Border Classes="dot" Classes.on="{Binding IsConnected}" Width="8" Height="8"
                                CornerRadius="4" VerticalAlignment="Center" />
                        <ic:SymbolIcon Symbol="Pin" IconVariant="Filled" Foreground="{DynamicResource Accent}" FontSize="14"
                                   IsVisible="{Binding Pinned}" ToolTip.Tip="Pinned" />
                        <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding HostName}" />
                        <TextBlock Text="·" Foreground="{DynamicResource FgFaint}" IsVisible="{Binding IsLive}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AgentName}" Foreground="{DynamicResource FgDim}" FontSize="12" IsVisible="{Binding IsLive}"
                                   VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource FgFaint}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Border Classes="status" IsVisible="{Binding IsLive}"
                                Classes.working="{Binding IsWorking}" Classes.attention="{Binding IsAwaitingInput}"
                                Classes.review="{Binding IsReadyForReview}" Classes.error="{Binding IsFaulted}"
                                Padding="8,2" VerticalAlignment="Center" Margin="2,0,0,0">
                            <TextBlock Text="{Binding ActivityText}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <!-- tag chips -->
                        <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" Margin="4,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" CornerRadius="10" Padding="8,1">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource FgDim}" FontSize="10" />
                                            <Button Content="{icx:SymbolIcon Symbol=Dismiss}" Command="{Binding $parent[ItemsControl].DataContext.RemoveTagCommand}"
                                                    CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource FgFaint}"
                                                    BorderThickness="0" Padding="0" FontSize="9" Cursor="Hand"
                                                    AutomationProperties.Name="Remove tag" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Classes="chip" Command="{Binding Session.ToggleToolsCommand}" IsVisible="{Binding Session.HasTools}"
                                Content="Tool output" Padding="9,3" FontSize="11"
                                ToolTip.Tip="Collapse / expand all tool output" AutomationProperties.Name="Toggle all tool output" />
                        <Button Classes="chip" Command="{Binding Session.ToggleLeftCommand}" IsVisible="{Binding Session.HasSidebarContent}"
                                Content="Panels" Padding="9,3" FontSize="11"
                                AutomationProperties.Name="Toggle side panels" />
                        <Button Classes="chip" Command="{Binding Session.ToggleInspectorCommand}" IsVisible="{Binding IsLive}"
                                Content="Event log" Padding="9,3" FontSize="11"
                                ToolTip.Tip="Show the raw event log" AutomationProperties.Name="Toggle raw event log" />
                        <Button Classes="chip" Command="{Binding Session.ToggleFileBrowserCommand}" IsVisible="{Binding IsLive}"
                                Content="Files" Padding="9,3" FontSize="11"
                                ToolTip.Tip="Browse the session's working directory" AutomationProperties.Name="Toggle file browser" />
                        <Button Classes="chip" Command="{Binding Session.ToggleTerminalCommand}" IsVisible="{Binding IsLive}"
                                Content="Terminal" Padding="9,3" FontSize="11"
                                ToolTip.Tip="Open a terminal in the session's working directory" AutomationProperties.Name="Toggle terminal" />
                        <!-- real context-window usage the agent reported (bar only when the window is known) -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding Usage.HasAnyContext, FallbackValue=false}"
                                    ToolTip.Tip="Context tokens used out of the current model window reported by the agent">
                            <TextBlock Text="ctx" Foreground="{DynamicResource FgFaint}" FontSize="10" VerticalAlignment="Center" />
                            <ProgressBar Classes="ctx" Minimum="0" Maximum="100" Value="{Binding Usage.ContextPercent, FallbackValue=0}"
                                         Classes.tight="{Binding Usage.ContextPercent, Converter={StaticResource CtxTight}, FallbackValue=False}"
                                         Classes.critical="{Binding Usage.ContextPercent, Converter={StaticResource CtxCritical}, FallbackValue=False}"
                                         Width="70" Height="6" VerticalAlignment="Center"
                                         IsVisible="{Binding Usage.HasContext, FallbackValue=false}"
                                         Background="{DynamicResource PanelAlt}" />
                            <TextBlock Text="{Binding Usage.ContextText}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UsageSummary}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                   VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                   IsVisible="{Binding UsageSummary, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                        <!-- Autonomous: agent runs tools without asking. Clickable so it isn't just a passive
                             badge — the flyout explains it and surfaces the live lever (switch the agent's
                             mode to one that pauses for approval, or stop the current turn). Defect #3. -->
                        <Button IsVisible="{Binding Session.IsAutonomous}" Background="{DynamicResource AccentSoft}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="9,3"
                                VerticalAlignment="Center" AutomationProperties.Name="Autonomy"
                                ToolTip.Tip="This session runs tool calls without asking. Click to change how it asks.">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                    <ic:SymbolIcon Symbol="Flash" IconVariant="Filled" Foreground="{DynamicResource Accent}" FontSize="13" />
                                    <TextBlock Text="autonomous" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="300" Spacing="10" DataContext="{Binding Session}">
                                        <TextBlock Text="Running autonomously" Foreground="{DynamicResource Fg}"
                                                   FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="The agent runs tool calls without asking for approval."
                                                   Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap" />
                                        <!-- Live lever: switch the agent to a mode that pauses for approval. -->
                                        <StackPanel Spacing="6" IsVisible="{Binding HasModes}">
                                            <TextBlock Text="Switch mode (takes effect immediately)"
                                                       Foreground="{DynamicResource FgDim}" FontSize="11" />
                                            <ItemsControl ItemsSource="{Binding Modes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="chip" Content="{Binding Name}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.SetModeCommand}"
                                                                CommandParameter="{Binding}" Margin="0,0,6,6" Padding="10,4" FontSize="12"
                                                                AutomationProperties.Name="Switch mode" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CurrentModeName, StringFormat='Current mode: {0}'}"
                                                       Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock IsVisible="{Binding !HasModes}"
                                                   Text="This agent doesn't expose live modes. Use Stop to halt the current turn, or Fork to start a fresh session that asks for approval."
                                                   Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Sandbox: isolation status + lifecycle -->
                        <Button Classes="chip" IsVisible="{Binding Session.HasSandbox}" Padding="9,3" FontSize="11"
                                AutomationProperties.Name="Sandbox">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <ic:SymbolIcon Symbol="Shield" FontSize="13" />
                                <TextBlock Text="{Binding Session.SandboxSummary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="280" Spacing="8">
                                        <TextBlock Text="{Binding Session.Sandbox.Id, StringFormat='Sandbox: {0}'}"
                                                   Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="12"
                                                   FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Session.Sandbox.Provider, StringFormat='Provider: {0}'}"
                                                   Foreground="{DynamicResource FgDim}" FontSize="11" />
                                        <TextBlock Text="{Binding Session.Sandbox.State, StringFormat='State: {0}'}"
                                                   Foreground="{DynamicResource FgDim}" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Pause" Command="{Binding Session.PauseSandboxCommand}"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,5" FontSize="12" />
                                            <Button Content="Resume" Command="{Binding Session.ResumeSandboxCommand}"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,5" FontSize="12" />
                                            <Button Classes="danger" Content="Delete" Command="{Binding Session.DeleteSandboxCommand}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,5" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- session menu -->
                        <!-- Git: branch + commit -->
                        <Button Classes="chip" IsVisible="{Binding Session.HasGit}" Padding="9,3" FontSize="11"
                                AutomationProperties.Name="Git">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="Branch" FontSize="14" />
                                <TextBlock Text="{Binding Session.GitBranch}" />
                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Accent}"
                                        VerticalAlignment="Center" IsVisible="{Binding Session.GitDirty}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="340" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Session.GitBranch, StringFormat='Branch: {0}'}"
                                                       Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Session.GitSummary}" Foreground="{DynamicResource FgDim}" FontSize="11" />
                                        </Grid>
                                        <ComboBox ItemsSource="{Binding Session.ChangedFileScopes}"
                                                  SelectedItem="{Binding Session.ChangedFileScope, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" FontSize="11"
                                                  AutomationProperties.Name="Changed-file scope" />
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Session.GitChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" FontSize="11"
                                                                   Width="26" FontFamily="{StaticResource MonoFont}" />
                                                        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                                   FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>
                                        <TextBox Text="{Binding Session.CommitMessage, Mode=TwoWay}" Watermark="Commit message"
                                                 Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                 BorderBrush="{DynamicResource Line}" CornerRadius="7" Padding="9,5" FontSize="12"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                                                 AutomationProperties.Name="Commit message" />
                                        <Button Content="Generate message" Command="{Binding Session.GenerateCommitMessageCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,5" FontSize="12"
                                                AutomationProperties.Name="Generate commit message" />
                                        <Button Classes="accent" Content="Commit all changes" Command="{Binding Session.CommitCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,6" />

                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,2" />

                                        <!-- Stash / restore -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <Button Grid.Column="0" Content="Stash changes" Command="{Binding Session.StashCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,5" FontSize="12" />
                                            <Button Grid.Column="1" Content="Restore stash" Command="{Binding Session.PopStashCommand}"
                                                    IsVisible="{Binding Session.HasStash}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,5" FontSize="12" />
                                        </Grid>

                                        <!-- Branch switcher (carry-stash optional) -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBox Grid.Column="0" Text="{Binding Session.TargetBranch, Mode=TwoWay}" Watermark="Switch to branch…"
                                                     Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                     BorderBrush="{DynamicResource Line}" CornerRadius="7" Padding="9,5" FontSize="12"
                                                     AutomationProperties.Name="Target branch" />
                                            <Button Grid.Column="1" Content="Switch" Command="{Binding Session.SwitchBranchCommand}"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,5" FontSize="12" />
                                        </Grid>
                                        <CheckBox IsChecked="{Binding Session.CarryStash, Mode=TwoWay}" Content="Carry uncommitted changes across"
                                                  Foreground="{DynamicResource FgDim}" FontSize="11" />

                                        <!-- Pull (fast-forward only) / push -->
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                            <Button Grid.Column="0" Content="Pull (FF)" Command="{Binding Session.PullCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,5" FontSize="12" />
                                            <Button Grid.Column="1" Content="Push" Command="{Binding Session.PushCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,5" FontSize="12" />
                                            <Button Grid.Column="2" Content="Publish" Command="{Binding Session.PublishBranchCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,5" FontSize="12" />
                                        </Grid>

                                        <!-- Last git-operation status (a refused pull renders in the accent/error tone) -->
                                        <TextBlock Text="{Binding Session.GitOpMessage}" IsVisible="{Binding Session.HasGitOpMessage}"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgDim}" />

                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,2" />

                                        <!-- Pull requests on the session's forge -->
                                        <Button Content="Load pull requests" Command="{Binding Session.RefreshPullRequestsCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,5" FontSize="12" />
                                        <ItemsControl ItemsSource="{Binding Session.PullRequests}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" ColumnSpacing="6">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SourceBranch}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                                       FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Checkout"
                                                                Command="{Binding $parent[ItemsControl].DataContext.Session.CheckoutPullRequestCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,4" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Classes="chip" Content="{icx:SymbolIcon Symbol=MoreHorizontal}" Padding="9,2" FontSize="12"
                                VerticalContentAlignment="Center" IsVisible="{Binding IsLive}" AutomationProperties.Name="Session menu">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Rename / tag…" Command="{Binding BeginRenameCommand}" />
                                    <MenuItem Header="Pin tab" Command="{Binding TogglePinCommand}" />
                                    <MenuItem Header="Copy session link (hand off to another device)" Click="OnCopySessionLink" />
                                    <MenuItem Header="Copy share link (for a colleague who has access)" Click="OnCopyShareLink" />
                                    <MenuItem Header="Schedule the composer prompt (every 5 min)" Command="{Binding Session.ScheduleCommand}" />
                                    <Separator />
                                    <MenuItem Header="Compact context" Command="{Binding Session.CompactCommand}"
                                              ToolTip.Tip="Ask the agent to summarise and free up its context window." />
                                    <MenuItem Header="Clear conversation" Command="{Binding Session.ClearContextCommand}"
                                              ToolTip.Tip="Ask the agent to start fresh (clears its context)." />
                                    <MenuItem Header="Restart agent" Command="{Binding Session.RestartAgentCommand}"
                                              ToolTip.Tip="Relaunch the agent process and resume the conversation — recovers a crashed or hung agent." />
                                    <Separator />
                                    <MenuItem Header="Show QR to connect a device to this session…"
                                              Command="{Binding ConnectQr.ShowCommand}"
                                              ToolTip.Tip="Displays a one-time code a phone can scan to pair with this host and open this session. It is a credential — hide it when you're done." />
                                    <Separator />
                                    <MenuItem Header="Open in new window" Command="{Binding MoveToWindowCommand}" />
                                    <Separator />
                                    <MenuItem Header="Duplicate (same session)" Command="{Binding DuplicateCommand}" />
                                    <MenuItem Header="New session (same setup)" Command="{Binding SameSetupCommand}" />
                                    <MenuItem Header="Fork (copy working folder)…" Command="{Binding ForkCommand}" />
                                    <Separator />
                                    <MenuItem Header="Archive" Command="{Binding ArchiveCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- inline rename / tag editor -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsRenaming}">
                    <TextBox Text="{Binding RenameText, Mode=TwoWay}" Width="240" Watermark="Tab name"
                             Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                             BorderBrush="{DynamicResource Line}" CornerRadius="7" Padding="9,4" FontSize="12"
                             AutomationProperties.Name="Rename tab"
                             km:KeymapBinder.Context="SessionRenameFocus" />
                    <Button Classes="accent" Content="Save" Command="{Binding CommitRenameCommand}" Padding="12,4" FontSize="12" />
                    <TextBox Text="{Binding TagInput, Mode=TwoWay}" Width="160" Watermark="Add tag + Enter"
                             Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                             BorderBrush="{DynamicResource Line}" CornerRadius="7" Padding="9,4" FontSize="12"
                             AutomationProperties.Name="Add tag"
                             km:KeymapBinder.Context="SessionTagFocus" />
                    <Button Classes="chip" Content="Done" Command="{Binding CancelRenameCommand}" Padding="12,4" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">

            <!-- Stage 1: pick a host -->
            <Border Padding="24" IsVisible="{Binding IsPickingHost}">
                <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="New session" Classes="display" FontSize="22"
                               Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" />
                    <TextBlock Text="Choose a host" Foreground="{DynamicResource FgDim}" HorizontalAlignment="Center" />
                    <!-- While connecting, disable the picker and show progress so it doesn't look frozen (defect #8). -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                IsVisible="{Binding IsConnectingHost}">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding !IsConnectingHost}">
                    <ItemsControl ItemsSource="{Binding Hosts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Button Command="{Binding Select}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" CornerRadius="10"
                                            Padding="14,12" Background="{DynamicResource Panel}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Url}" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Remove a saved host (built-in hosts have no Forget command → hidden). Defect #7. -->
                                    <Button Command="{Binding Forget}" IsVisible="{Binding CanForget}" Content="{icx:SymbolIcon Symbol=Dismiss}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Background="Transparent" Foreground="{DynamicResource FgFaint}" BorderThickness="0"
                                            Padding="7,3" FontSize="12" Cursor="Hand"
                                            ToolTip.Tip="Remove this host" AutomationProperties.Name="Remove host" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <Button Classes="chip" Command="{Binding ToggleAddHostCommand}" HorizontalAlignment="Left" Padding="10,6" FontSize="12"
                            Content="+ Add host" />
                    <StackPanel Spacing="6" IsVisible="{Binding ShowAddHost}">
                        <TextBox Text="{Binding NewHostName, Mode=TwoWay}" Watermark="Name (optional)"
                                 Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                 BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="10,8" />
                        <TextBox Text="{Binding NewHostUrl, Mode=TwoWay}" Watermark="https://host:5081"
                                 Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                 BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="10,8" />

                        <!-- GitHub SSO — shown when the host advertises it (GET /auth/methods). -->
                        <Button Content="Sign in with GitHub" Command="{Binding SignInWithGitHubCommand}"
                                IsVisible="{Binding HostSupportsGitHub}" IsEnabled="{Binding !IsGitHubAuthorizing}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8" FontWeight="SemiBold" />
                        <Border IsVisible="{Binding IsGitHubAuthorizing}" Background="{DynamicResource PanelAlt}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Enter this code at github.com/login/device (opened in your browser):"
                                           Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                                <SelectableTextBlock Text="{Binding GitHubUserCode}" Foreground="{DynamicResource Accent}"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{Binding GitHubVerificationUri}" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Panel}" />
                                    <TextBlock Text="Waiting for you to authorize…" Foreground="{DynamicResource FgFaint}"
                                               FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Keypair (SSH authorized_keys style) — shown when the host advertises it. -->
                        <Button Content="Sign in with a key" Command="{Binding SignInWithKeyCommand}"
                                IsVisible="{Binding HostSupportsKeypair}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8" FontWeight="SemiBold" />
                        <Border IsVisible="{Binding ShowKeyInfo}" Background="{DynamicResource PanelAlt}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="If the host rejects the key, add this line to its ~/.agnes/authorized_keys and retry:"
                                           Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                                <SelectableTextBlock Text="{Binding PublicKeyLine}" Foreground="{DynamicResource Fg}"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="10" TextWrapping="Wrap"
                                                     ctl:SelectionContextMenu.Enable="True" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="— or use a pairing code —" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                   HorizontalAlignment="Center" IsVisible="{Binding HostSupportsGitHub}" />

                        <!-- Pairing code — shown unless the host disabled it. -->
                        <StackPanel Spacing="6" IsVisible="{Binding HostSupportsPairing}">
                            <TextBox Text="{Binding NewHostToken, Mode=TwoWay}" Watermark="Pairing code (from the host)"
                                     Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                     BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="10,8"
                                     ToolTip.Tip="Enter the pairing code the host prints at startup. A per-device token is issued and stored." />
                            <Button Classes="accent" Content="Connect" Command="{Binding AddHostCommand}" HorizontalAlignment="Stretch" Padding="12,8" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgFaint}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <!-- First-run guidance -->
                    <TextBlock Text="First time? Start a host (docker compose up, or dotnet run in src/Agnes.Host), then Add host with the pairing code it prints. Or try the Simulated host above."
                               Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="380" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Stage 2: configure the session (working dir · permissions · git push · agent) -->
            <Border Padding="24" IsVisible="{Binding IsPickingAgent}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="Transparent"
                            Foreground="{DynamicResource FgDim}" BorderThickness="0" Padding="0" FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ic:SymbolIcon Symbol="ChevronLeft" FontSize="13" />
                            <TextBlock Text="Hosts" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Configure session" Classes="display" FontSize="22"
                                   Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" />
                        <TextBlock Text="Set the project and options, choose an agent, then start."
                                   Foreground="{DynamicResource FgDim}" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Already running on this host: the sessions this device may reach, listed as soon as the
                         host connects. Rejoining work in progress is the first question after pairing, so it sits
                         above the new-session controls rather than behind them. -->
                    <StackPanel Spacing="6" IsVisible="{Binding HostSessions.HasSessions}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="ALREADY RUNNING ON THIS HOST" Foreground="{DynamicResource FgDim}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding HostSessions.Status}" Foreground="{DynamicResource FgFaint}"
                                       FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                            <Button Classes="chip" Grid.Column="2" Content="Refresh" Command="{Binding HostSessions.RefreshCommand}"
                                    Padding="8,3" FontSize="11" AutomationProperties.Name="Refresh the session list" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HostSessions.Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" CornerRadius="8" Padding="12,8" Background="{DynamicResource Panel}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" Classes="statusdot" VerticalAlignment="Center"
                                                    Classes.working="{Binding IsWorking}"
                                                    Classes.attention="{Binding IsBlocked}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10" FontFamily="{StaticResource MonoFont}">
                                                    <Run Text="{Binding AdapterId}" /><Run Text=" · " /><Run Text="{Binding WorkingDirectory}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StateText}" FontSize="11" Classes="tone"
                                                           Classes.working="{Binding IsWorking}"
                                                           Classes.attention="{Binding IsBlocked}" />
                                                <TextBlock Text="{Binding Age}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <Button Grid.Column="3" VerticalAlignment="Center" Padding="12,4" FontSize="11"
                                                    Command="{Binding $parent[ItemsControl].DataContext.HostSessions.AttachCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6"
                                                    ToolTip.Tip="Join this session in this tab"
                                                    AutomationProperties.Name="Join this session">
                                                <Panel>
                                                    <TextBlock Text="Join" IsVisible="{Binding !IsAlreadyOpen}" />
                                                    <TextBlock Text="Go to it" IsVisible="{Binding IsAlreadyOpen}" />
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Working directory (the project the agent works on, on the host) -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Working directory (on the host)" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center" />
                            <ctl:InfoHint Description="The project folder the agent works in — a path on the host running the daemon. It becomes the agent's working directory; in a sandbox it's bind-mounted to /work, so the agent sees exactly these files and its edits/commits write back here. Its git remote also scopes what the agent may push."
                                          Security="Only this folder is exposed to a sandboxed agent — everything else on the host stays isolated. Because it's the real folder (not a copy), branch/checkout actions move your host checkout too; use the worktree option to insulate it." />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding WorkingDirectory, Mode=TwoWay}" Watermark="/path/to/your/project"
                                     Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                     BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="10,8" FontSize="12"
                                     FontFamily="{StaticResource MonoFont}" />
                            <Button Classes="chip" Grid.Column="1" Content="Browse…" Click="OnBrowseWorkingDirectory" Padding="10,8" FontSize="12"
                                    ToolTip.Tip="Pick a folder on this machine (for a local host)" />
                        </Grid>
                    </StackPanel>

                    <!-- Sandbox: isolate the agent in a per-session VM. Defaults on when the host supports it. -->
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ic:SymbolIcon Grid.Column="0" Classes="lead" Symbol="Box" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Foreground="{DynamicResource Fg}" FontSize="13" FontWeight="SemiBold" Text="Sandbox" />
                                    <ctl:InfoHint Description="Run the agent inside an isolated per-session VM, with only the chosen project directory mounted. On by default when the host supports it."
                                                  Security="A sandbox contains what the agent can reach — it can't touch the rest of your machine, even in Autonomous mode. Strongly recommended." />
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap"
                                           IsVisible="{Binding SandboxAvailable}"
                                           Text="Isolate the agent in a per-session VM — only the project directory is mounted." />
                                <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap"
                                           IsVisible="{Binding !SandboxAvailable}"
                                           Text="Not available on this host — start it with a sandbox provider (Agnes:Sandbox:Provider=incus) to isolate sessions." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        IsEnabled="{Binding SandboxAvailable}">
                                <Button Content="On" Command="{Binding SetSandboxModeCommand}" CommandParameter="On"
                                        Classes.on="{Binding SandboxOn}" Classes="seg" />
                                <Button Content="Off" Command="{Binding SetSandboxModeCommand}" CommandParameter="Off"
                                        Classes.on="{Binding SandboxOff}" Classes="seg" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Permissions: fixed label/description on the left; the segmented control on the right is the state -->
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" >
                            <ic:SymbolIcon Grid.Column="0" Classes="lead" Symbol="Shield" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Foreground="{DynamicResource Fg}" FontSize="13" FontWeight="SemiBold" Text="Permissions" />
                                    <ctl:InfoHint Description="Whether the agent asks before each tool call. Ask: you approve every file edit, command, and other tool use as it happens. Autonomous: the agent runs tools without asking."
                                                  Security="Autonomous mode lets the agent edit files and run commands with no approval. Use it only for work you trust, and prefer a sandbox so it can't touch anything outside the mounted project." />
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap"
                                           Text="Whether the agent asks you before running each tool." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Ask" Command="{Binding SetPermissionModeCommand}" CommandParameter="Ask"
                                        Classes.on="{Binding PermAsk}" Classes="seg" />
                                <Button Content="Autonomous" Command="{Binding SetPermissionModeCommand}" CommandParameter="Autonomous"
                                        Classes.on="{Binding PermAutonomous}" Classes="seg" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Git push for a sandboxed session: fixed label/description; the Off/Ask/Trust segment is the state -->
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ic:SymbolIcon Grid.Column="0" Classes="lead" Symbol="BranchFork" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Foreground="{DynamicResource Fg}" FontSize="13" FontWeight="SemiBold" Text="GitHub access" />
                                    <ctl:InfoHint Description="Whether a sandboxed agent may use your linked GitHub account to clone, fetch and push. Off: no credentials. Ask: allowed, but you approve each repository once (the first time the agent touches it). Trust: allowed for every repo without asking. The credential is a scoped, short-lived, per-repo token minted on the host."
                                                  Security="The token never enters the sandbox and is scoped to the specific repo requested, so access to one repo can't reach your others. Cloning/pushing only works for repos your linked account can access." />
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap"
                                           Text="Let the agent clone/push private repos — approved once per repository." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Off" Command="{Binding SetGitCredentialModeCommand}" CommandParameter="Off"
                                        Classes.on="{Binding GitCredOff}" Classes="seg" />
                                <Button Content="Ask" Command="{Binding SetGitCredentialModeCommand}" CommandParameter="Ask"
                                        Classes.on="{Binding GitCredAsk}" Classes="seg" />
                                <Button Content="Trust" Command="{Binding SetGitCredentialModeCommand}" CommandParameter="Trust"
                                        Classes.on="{Binding GitCredTrust}" Classes="seg" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Launch profiles: pick a saved config to prefill everything below, or save the current one -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="PROFILE" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasLaunchProfiles}">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding LaunchProfiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="12" PlaceholderText="Apply a saved profile…">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Apply" Command="{Binding ApplyProfileCommand}" Classes="seg" Margin="6,0,0,0" />
                            <Button Grid.Column="2" Content="Save current…" Command="{Binding ToggleSaveProfileCommand}" Classes="seg" Margin="6,0,0,0" />
                        </Grid>
                        <!-- When there are no profiles yet, still offer to save the current selections as the first one -->
                        <Button Content="Save current as profile…" Command="{Binding ToggleSaveProfileCommand}" Classes="seg"
                                HorizontalAlignment="Left" IsVisible="{Binding !HasLaunchProfiles}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowSaveProfile}">
                            <TextBox Grid.Column="0" Text="{Binding NewProfileName, Mode=TwoWay}" PlaceholderText="Profile name (e.g. Scratch OpenCode)"
                                     Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                     BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="9,5" FontSize="12"
                                     AutomationProperties.Name="New profile name" />
                            <Button Grid.Column="1" Content="Save" Command="{Binding SaveProfileCommand}" Classes="seg" Margin="6,0,0,0" />
                            <Button Grid.Column="2" Content="Cancel" Command="{Binding ToggleSaveProfileCommand}" Classes="seg" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Discovered sessions: sessions a CLI created OUTSIDE Agnes for this folder, offered for a
                         read-only "Watch" (sessions/02). Hidden until Look is pressed and something is found. -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="RUNNING OUTSIDE AGNES" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DiscoverStatus}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                            <Button Classes="chip" Grid.Column="2" Content="Look for sessions" Command="{Binding DiscoverExternalSessionsCommand}" Padding="8,3" FontSize="11"
                                    ToolTip.Tip="Find sessions a CLI started outside Agnes in this folder"
                                    AutomationProperties.Name="Look for external sessions" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DiscoveredSessions}" IsVisible="{Binding HasDiscoveredSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" CornerRadius="8" Padding="12,8" Background="{DynamicResource Panel}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10" FontFamily="{StaticResource MonoFont}">
                                                    <Run Text="{Binding AdapterId}" /><Run Text=" · " /><Run Text="{Binding MessageCount}" /><Run Text=" msgs · " /><Run Text="{Binding LastActivity}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Watch" VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].DataContext.WatchExternalSessionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,4" FontSize="11"
                                                    ToolTip.Tip="Open a live, read-only view of this session" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Agent: label + search (scales past a handful) + selectable list; opens only on Start -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="AGENT" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding AgentFilter, Mode=TwoWay}" Watermark="Search agents…"
                                     Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                     BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="9,5" FontSize="12" MaxWidth="220"
                                     HorizontalAlignment="Right" AutomationProperties.Name="Search agents" />
                        </Grid>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="agent" Classes.sel="{Binding IsSelected}"
                                            Command="{Binding $parent[ItemsControl].DataContext.SelectAgentChoiceCommand}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding Available}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" CornerRadius="8"
                                            Padding="12,8" Background="{DynamicResource Panel}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            ToolTip.Tip="{Binding StatusText}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- Login badge: only shown when the adapter reports a reliable signal (HasAuth).
                                                     Dot goes green when signed in; the label + tooltip carry the detail. -->
                                                <Border IsVisible="{Binding HasAuth}" CornerRadius="9" Padding="7,2" VerticalAlignment="Center"
                                                        Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        ToolTip.Tip="{Binding AuthTooltip}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <Border Classes="dot" Classes.on="{Binding IsLoggedIn}" Width="7" Height="7"
                                                                CornerRadius="4" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AuthBadgeText}" Foreground="{DynamicResource FgDim}" FontSize="10" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- Interactive provider login: opens the CLI's login in a terminal on the tab.
                                                     Only offered when signed out (and the host can run the login). -->
                                                <Button Content="Log in" Command="{Binding LogInCommand}"
                                                        IsVisible="{Binding IsLoggedOut}" IsEnabled="{Binding CanLogIn}"
                                                        Background="Transparent" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8,2" FontSize="10" VerticalAlignment="Center"
                                                        ToolTip.Tip="Sign this agent in by running its login in a terminal here"
                                                        AutomationProperties.Name="Log in to this agent" />
                                                <!-- Force a fresh, cache-bypassing login check. -->
                                                <Button Classes="chip" Content="Check now" Command="{Binding CheckAuthCommand}" IsVisible="{Binding CanCheckAuth}" Padding="8,2" FontSize="10" VerticalAlignment="Center"
                                                        ToolTip.Tip="Check whether this agent is signed in on the host"
                                                        AutomationProperties.Name="Check login status" />
                                                <ic:SymbolIcon Symbol="Checkmark" Foreground="{DynamicResource Accent}"
                                                           FontSize="16" IsVisible="{Binding IsSelected}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Model: the per-agent catalog (live-probed or static). Only shown when the selected
                         agent exposes models; a free-text entry covers models newer than Agnes's list. -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasModels}">
                        <TextBlock Text="MODEL" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Models}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <Button Grid.Column="0" Classes="agent" Classes.sel="{Binding IsSelected}"
                                                Command="{Binding $parent[ItemsControl].DataContext.SelectModelChoiceCommand}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding IsAvailable}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8"
                                                Padding="12,8" Background="{DynamicResource Panel}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding Id}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                               FontFamily="{StaticResource MonoFont}" />
                                                </StackPanel>
                                                <ic:SymbolIcon Grid.Column="1" Symbol="Checkmark" Foreground="{DynamicResource Accent}"
                                                           FontSize="16" IsVisible="{Binding IsSelected}" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding ToggleFavoriteCommand}"
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}"
                                                Padding="8,0" VerticalAlignment="Center"
                                                ToolTip.Tip="Favorite this model" AutomationProperties.Name="Toggle favorite model">
                                                    <ic:SymbolIcon Symbol="Star" IconVariant="{Binding FavoriteVariant}" FontSize="17" />
                                                </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                        <TextBox Text="{Binding CustomModelId, Mode=TwoWay}" Watermark="Custom model id (optional)"
                                 IsEnabled="{Binding CustomEntryAllowed}"
                                 Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                 BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="9,5" FontSize="12"
                                 FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Custom model id" />
                    </StackPanel>

                    <!-- Explicit start: no surprise auto-progress when an agent is clicked -->
                    <Button Classes="primary" Content="Start session" Command="{Binding StartSessionCommand}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Padding="12,9" FontSize="13"
                            AutomationProperties.Name="Start session" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Stage 2b: starting — opening the session (the host may be baking the sandbox image) -->
            <Border Padding="24" IsVisible="{Binding IsStarting}">
                <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="Starting session" Classes="display" FontSize="20"
                               Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="6" MinWidth="300"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgDim}" FontSize="12"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="The host may be building the sandbox image — installing tools and the agent CLIs into a fresh VM. This can take a few minutes the first time; it's cached afterwards."
                               Foreground="{DynamicResource FgFaint}" FontSize="11" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                    <!-- Never trap the user on an opaque wait: Cancel drops back to the agent picker (defect #8/#10). -->
                    <Button Classes="chip" Content="Cancel" Command="{Binding CancelStartCommand}" HorizontalAlignment="Center" Padding="16,5" FontSize="12"
                            AutomationProperties.Name="Cancel starting the session" />
                </StackPanel>
            </Border>

            <!-- Stage 3: live conversation — resizable multi-column workspace -->
            <Grid IsVisible="{Binding IsLive}" RowDefinitions="Auto,*">

                <!-- Clear connection / session state banner. It always says something is wrong or needs a
                     decision from you, so it wears the attention amber rather than the selection violet. -->
                <Border Grid.Row="0" DataContext="{Binding Session}" IsVisible="{Binding ShowBanner}"
                        Background="{DynamicResource StatusAttentionSoft}" BorderBrush="{DynamicResource StatusAttention}"
                        BorderThickness="0,0,0,1" Padding="16,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Border Grid.Column="0" Classes="statusdot attention" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding BannerText}" Foreground="{DynamicResource Fg}"
                                   VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button Classes="accent" Grid.Column="2" Content="Retry" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Padding="12,4"
                                FontSize="12" Margin="8,0,0,0" ToolTip.Tip="Retry the connection or resend the interrupted turn" />
                        <Button Classes="chip" Grid.Column="3" Content="Dismiss" Command="{Binding DismissBannerCommand}" Padding="12,4"
                                FontSize="12" Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" x:Name="Workspace" DataContext="{Binding Session}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" MinWidth="0" MaxWidth="560" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" MinWidth="0" MaxWidth="760" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: plan, files modified, tools run -->
                    <Border Grid.Column="0" IsVisible="{Binding ShowLeftPanel}"
                            Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                        <!-- The right padding clears the overlay scrollbar. Fluent draws it *over* the
                             content rather than taking width from it, so text laid out to the full
                             viewport loses its last couple of characters underneath — which reads as
                             wrapping that doesn't quite work rather than as a scrollbar. -->
                        <ScrollViewer Padding="14,16,22,16" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="18">
                                <!-- Session name: the agent's auto-generated title when it has one, else the folder -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="SESSION" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource Fg}" FontSize="14"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- PLAN sits directly under the session name: what the agent is doing now
                                     is the first thing you look for, and it ticks along in place as entries
                                     are completed or added. Foldable like every other section, and it shows
                                     the outstanding work plus the last thing finished — the rest of the
                                     completed run is under "Show n completed", because a plan only ever
                                     grows and would otherwise end the session as a wall of ticks. -->
                                <StackPanel Spacing="4" IsVisible="{Binding Plan, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                    <Button Command="{Binding TogglePlanCommand}" Background="Transparent" BorderThickness="0"
                                            Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronDown"
                                                       IsVisible="{Binding PlanExpanded}" />
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronRight"
                                                       IsVisible="{Binding !PlanExpanded}" />
                                            <TextBlock Text="PLAN" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="4" IsVisible="{Binding PlanExpanded}">
                                        <Button Content="{Binding Plan.MoreLabel}" Command="{Binding ShowAllPlanCommand}"
                                                IsVisible="{Binding Plan.HasHidden}" HorizontalAlignment="Left" Cursor="Hand"
                                                Background="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0"
                                                Padding="6,3" FontSize="11" />
                                        <ItemsControl ItemsSource="{Binding Plan.VisibleEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Status}" Classes="tone" FontSize="10"
                                                                   VerticalAlignment="Top" TextWrapping="Wrap"
                                                                   Classes.done="{Binding Status, Converter={StaticResource PlanDone}}"
                                                                   Classes.working="{Binding Status, Converter={StaticResource PlanRunning}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Content}" Foreground="{DynamicResource Fg}"
                                                                   FontSize="12" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Agent roster: flattened so the root and its direct subagents share one
                                     visual level (only deeper nesting indents), styled like Files/Tools rows.
                                     Collapsible, and shows only RUNNING agents until "show all" reveals finished
                                     ones (the separate PARTICIPANTS section was redundant and was removed). -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasSubagents}">
                                    <Button Command="{Binding ToggleAgentsCommand}" Background="Transparent" BorderThickness="0"
                                            Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronDown"
                                                       IsVisible="{Binding AgentsExpanded}" />
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronRight"
                                                       IsVisible="{Binding !AgentsExpanded}" />
                                            <TextBlock Text="AGENTS" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="4" IsVisible="{Binding AgentsExpanded}">
                                        <ItemsControl ItemsSource="{Binding VisibleAgentRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:AgentNode">
                                                    <Button Command="{Binding SelectCommand}" Classes.sel="{Binding IsSelected}"
                                                            Margin="{Binding Depth, Converter={StaticResource AgentIndent}}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            Background="Transparent" BorderThickness="0" Padding="6,5" CornerRadius="6" Cursor="Hand">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                            <ic:SymbolIcon Grid.Column="0" Symbol="Diamond" IconVariant="Filled" FontSize="10" VerticalAlignment="Top" Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource Good}" IsVisible="{Binding IsMain}" />
                                                            <ic:SymbolIcon Grid.Column="0" Symbol="Circle" IconVariant="Filled" FontSize="10" VerticalAlignment="Top" Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource FgFaint}" IsVisible="{Binding !IsMain}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource Fg}" Opacity="{Binding IsActive, Converter={StaticResource ActiveOpacity}}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding MoreAgentsLabel}" Command="{Binding ShowAllAgentsCommand}"
                                                IsVisible="{Binding HasInactiveAgents}" HorizontalAlignment="Left" Cursor="Hand"
                                                Background="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0"
                                                Padding="6,3" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding HasFiles}">
                                    <Button Command="{Binding ToggleFilesCommand}" Background="Transparent" BorderThickness="0"
                                            Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronDown"
                                                       IsVisible="{Binding FilesExpanded}" />
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronRight"
                                                       IsVisible="{Binding !FilesExpanded}" />
                                            <TextBlock Text="FILES MODIFIED" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ModifiedFiles}" IsVisible="{Binding FilesExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- A horizontal StackPanel measures its children with infinite
                                                     width, so a long path neither wraps nor ellipsizes — it just
                                                     runs off the edge of the panel. A Grid gives the name the real
                                                     width, and it wraps into it. Same shape for every list below. -->
                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowFilePreviewCommand}"
                                                        CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                        Padding="6,5" CornerRadius="6" Cursor="Hand" ToolTip.Tip="Open the diff">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                                   FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="tone" FontSize="10"
                                                                   VerticalAlignment="Top"
                                                                   Classes.working="{Binding IsRunning}" Classes.done="{Binding IsDone}"
                                                                   Classes.error="{Binding IsFailed}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- REVIEW COMMENTS: project-scoped file+line feedback, grouped by file -->
                                <StackPanel Spacing="6" IsVisible="{Binding HasReviewComments}">
                                    <TextBlock Text="REVIEW COMMENTS" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ReviewComments.Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="3" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                               FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding Comments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                                                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2">
                                                                    <StackPanel Spacing="4">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="{Binding LineLabel}" Foreground="{DynamicResource FgFaint}"
                                                                                       FontSize="10" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                                                            <Border Background="{DynamicResource DiffDelBg}" CornerRadius="4" Padding="5,1"
                                                                                    IsVisible="{Binding IsStale}" ToolTip.Tip="The anchored line has changed or moved since this comment was left.">
                                                                                <TextBlock Text="stale" Foreground="{DynamicResource Fg}" FontSize="10" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Fg}" FontSize="12" TextWrapping="Wrap" />
                                                                        <!-- Wraps: three actions don't fit a narrowed sidebar side by side. -->
                                                                        <WrapPanel ItemSpacing="10" LineSpacing="4">
                                                                            <Button Content="Jump" Command="{Binding #Workspace.DataContext.ReviewComments.JumpCommand}"
                                                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                                                    Padding="0" Foreground="{DynamicResource Accent}" FontSize="11" Cursor="Hand" />
                                                                            <Button Content="Send to session"
                                                                                    Command="{Binding #Workspace.DataContext.ReviewComments.SendCommand}"
                                                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                                                    Padding="0" Foreground="{DynamicResource Accent}" FontSize="11" Cursor="Hand" />
                                                                            <Button Content="Delete"
                                                                                    Command="{Binding #Workspace.DataContext.ReviewComments.RemoveCommand}"
                                                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                                                    Padding="0" Foreground="{DynamicResource FgDim}" FontSize="11" Cursor="Hand" />
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ReviewComments.Status}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                               TextWrapping="Wrap" IsVisible="{Binding ReviewComments.Status, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding HasTools}">
                                    <Button Command="{Binding ToggleToolsListCommand}" Background="Transparent" BorderThickness="0"
                                            Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronDown"
                                                       IsVisible="{Binding ToolsListExpanded}" />
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronRight"
                                                       IsVisible="{Binding !ToolsListExpanded}" />
                                            <TextBlock Text="TOOLS RUN" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="4" IsVisible="{Binding ToolsListExpanded}">
                                        <ItemsControl ItemsSource="{Binding VisibleToolActivity}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- The whole command, wrapped: this list is the session's
                                                         record of what ran, and a clipped one records nothing. -->
                                                    <Button Command="{Binding $parent[ItemsControl].DataContext.ShowFilePreviewCommand}"
                                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                            Padding="6,5" CornerRadius="6" Cursor="Hand">
                                                        <Grid ColumnDefinitions="52,*" ColumnSpacing="8">
                                                            <TextBlock Grid.Column="0" Text="{Binding KindLabel}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                                                       FontFamily="{StaticResource MonoFont}" VerticalAlignment="Top" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                                       FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Only the most recent 50 render until asked for the rest. -->
                                        <Button Content="{Binding MoreToolsLabel}" Command="{Binding ShowAllToolsCommand}"
                                                IsVisible="{Binding HasMoreTools}" HorizontalAlignment="Left" Cursor="Hand"
                                                Background="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0"
                                                Padding="6,3" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Audit trail: capabilities granted / denied -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasApprovals}">
                                    <TextBlock Text="APPROVALS" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Approvals}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,3">
                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Top" Margin="0,4,0,0"
                                                            Background="{DynamicResource Good}" IsVisible="{Binding Allowed}" />
                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Top" Margin="0,4,0,0"
                                                            Background="{DynamicResource Accent}" IsVisible="{Binding !Allowed}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- MCP CALLS: forwarded host MCP tools a sandboxed agent invoked -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasMcpCalls}">
                                    <TextBlock Text="MCP CALLS" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding McpCalls}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                               FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- CREDENTIALS: brokered git-credential grants — collapsible, and capped to the
                                     past hour with "show all" (they pile up in a long-running session). -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasCredentialUses}">
                                    <Button Command="{Binding ToggleCredentialsCommand}" Background="Transparent" BorderThickness="0"
                                            Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronDown"
                                                       IsVisible="{Binding CredentialsExpanded}" />
                                            <ic:SymbolIcon Classes="hint" Symbol="ChevronRight"
                                                       IsVisible="{Binding !CredentialsExpanded}" />
                                            <TextBlock Text="CREDENTIALS" Foreground="{DynamicResource FgDim}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="4" IsVisible="{Binding CredentialsExpanded}">
                                        <ItemsControl ItemsSource="{Binding VisibleCredentialUses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                                   FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="tone" FontSize="10" VerticalAlignment="Top"
                                                                   Margin="0,2,0,0"
                                                                   Classes.working="{Binding IsRunning}" Classes.done="{Binding IsDone}"
                                                                   Classes.error="{Binding IsFailed}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding MoreCredentialsLabel}" Command="{Binding ShowAllCredentialsCommand}"
                                                IsVisible="{Binding HasMoreCredentialUses}" HorizontalAlignment="Left" Cursor="Hand"
                                                Background="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0"
                                                Padding="6,3" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                                  Background="{DynamicResource Line}" IsVisible="{Binding ShowLeftPanel}" />

                    <!-- MIDDLE: chat. The layout-transform root is sized to the inverse of ChatFontScale
                         in code-behind, so zoom changes wrapping without clipping or resizing side panels. -->
                    <Grid Grid.Column="2" x:Name="ChatViewport" ClipToBounds="True" IsVisible="{Binding ShowChat}"
                          km:KeymapBinder.Context="Chat">
                    <LayoutTransformControl>
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding #SessionView.ChatFontScale}"
                                            ScaleY="{Binding #SessionView.ChatFontScale}" />
                        </LayoutTransformControl.LayoutTransform>
                    <Grid x:Name="ChatScaleRoot" RowDefinitions="Auto,*,Auto,Auto">

                        <!-- within-session search -->
                        <Border Grid.Row="0" IsVisible="{Binding IsSearchOpen}" Background="{DynamicResource Panel}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,8">
                            <StackPanel MaxWidth="768" HorizontalAlignment="Center" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Search this session…"
                                             Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                             BorderBrush="{DynamicResource Line}" CornerRadius="7" Padding="9,4" FontSize="12"
                                             AutomationProperties.Name="Search this session"
                                             km:KeymapBinder.Context="SessionFindFocus" />
                                    <TextBlock Grid.Column="1" Text="{Binding MatchSummary}" Foreground="{DynamicResource FgFaint}"
                                               FontSize="11" VerticalAlignment="Center" MinWidth="52" />
                                    <Button Classes="chip" Grid.Column="2" Content="{icx:SymbolIcon Symbol=ChevronUp}" Command="{Binding PrevMatchCommand}" Padding="9,2"
                                            AutomationProperties.Name="Previous match" />
                                    <Button Classes="chip" Grid.Column="3" Content="{icx:SymbolIcon Symbol=ChevronDown}" Command="{Binding NextMatchCommand}" Padding="9,2"
                                            AutomationProperties.Name="Next match" />
                                    <Button Grid.Column="4" Content="{icx:SymbolIcon Symbol=Dismiss}" Command="{Binding CloseSearchCommand}"
                                            Background="Transparent" Foreground="{DynamicResource FgDim}" BorderThickness="0"
                                            Padding="8,2" AutomationProperties.Name="Close search" />
                                </Grid>
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Matches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding $parent[ItemsControl].DataContext.SelectHitCommand}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                                    Padding="6,3" CornerRadius="5" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                                               Width="56" FontFamily="{StaticResource MonoFont}" />
                                                    <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Transcript: a virtualizing ListBox so a long conversation only realizes the
                             rows on screen. Full-width (scrollbar at the window edge) with each row
                             centred at the 768px reading width. Selection is disabled — the rows carry
                             their own buttons. -->
                        <!-- Empty state: a fresh session shows a cue instead of a blank column (defect #10). -->
                        <StackPanel Grid.Row="1" IsHitTestVisible="False" IsVisible="{Binding IsTranscriptEmpty}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="420">
                            <TextBlock Text="No messages yet" Foreground="{DynamicResource FgDim}" FontSize="14"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Send a message below to start the conversation."
                                       Foreground="{DynamicResource FgFaint}" FontSize="12"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <ListBox Grid.Row="1" x:Name="Transcript" ItemsSource="{Binding DisplayItems}"
                                 IsVisible="{Binding !IsInspectorOpen}"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="24,16,24,48" HorizontalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <!-- The transcript is read-only: rows don't select or take focus, so it
                                     behaves like a plain list while still virtualizing. -->
                                <Style Selector="ListBoxItem">
                                    <Setter Property="MaxWidth" Value="768" />
                                    <!-- Stretch (not Center): a stretch item clamped by MaxWidth fills the
                                         768px column and is centred, rather than shrinking to its content. -->
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.DataTemplates>

                                    <DataTemplate DataType="tr:MessageBubbleItem">
                                        <Border Classes="msg" Classes.user="{Binding IsUser}" CornerRadius="12" Padding="14,10" Margin="0,6">
                                            <!-- Right-click / long-press anywhere on the bubble → the same per-message
                                                 actions, so touch and mouse reach them without the hover-only ⋯. -->
                                            <Border.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Copy message" Click="OnCopyMessage" />
                                                    <MenuItem Header="Copy link to this message" Click="OnCopyMessageLink" />
                                                    <MenuItem Header="View from here"
                                                              Command="{Binding $parent[ItemsControl].DataContext.RewindToCommand}"
                                                              CommandParameter="{Binding}" />
                                                </MenuFlyout>
                                            </Border.ContextFlyout>
                                            <StackPanel>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding Speaker}" FontSize="11"
                                                               Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" />
                                                    <!-- Per-message actions; only visible on hover (see Border.msg styles). -->
                                                    <Button Grid.Column="1" Classes="rowmenu" Content="{icx:SymbolIcon Symbol=MoreHorizontal}" Background="Transparent"
                                                            Foreground="{DynamicResource FgDim}" BorderThickness="0" Padding="6,0" FontSize="15"
                                                            Cursor="Hand" VerticalAlignment="Center" AutomationProperties.Name="Message actions">
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuItem Header="Copy message" Click="OnCopyMessage" />
                                                    <MenuItem Header="Copy link to this message" Click="OnCopyMessageLink" />
                                                                <MenuItem Header="View from here"
                                                                          Command="{Binding $parent[ItemsControl].DataContext.RewindToCommand}"
                                                                          CommandParameter="{Binding}" />
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                                <!-- Full message rendered as selectable Markdown; thoughts stay plain italic. -->
                                                <mdxaml:MarkdownScrollViewer Markdown="{Binding Text}" IsVisible="{Binding !IsThought}"
                                                                             SelectionEnabled="True" ctl:SelectionContextMenu.Enable="True">
                                                    <mdxaml:MarkdownScrollViewer.Styles>
                                                        <!-- The built-in Markdown theme is attached as this control's own styles, so
                                                             it can only be overridden from here — not app-wide. -->
                                                        <StyleInclude Source="avares://Agnes.App.Desktop/Themes/MarkdownStyles.axaml" />
                                                    </mdxaml:MarkdownScrollViewer.Styles>
                                                </mdxaml:MarkdownScrollViewer>
                                                <SelectableTextBlock Text="{Binding Text}" Classes="thought" IsVisible="{Binding IsThought}"
                                                                     TextWrapping="Wrap" ctl:SelectionContextMenu.Enable="True" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>

                                    <!-- Dense tool call (this is a developer tool): no card chrome, tight
                                         margins. The command WRAPS rather than ellipsizing — a shell line you
                                         can only read the first 60 characters of can't be overseen, and the
                                         tail is where the damage usually is. Small edits show their diff right
                                         here; anything longer opens in the preview pane on click, as does the
                                         full output. The "Tool output" toggle reveals a summary under each. -->
                                    <DataTemplate DataType="tr:ToolCallItem">
                                        <Button Classes="tool" Command="{Binding $parent[ItemsControl].DataContext.ShowToolPreviewCommand}"
                                                CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" Margin="0,1" Padding="4,2" CornerRadius="4"
                                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Open the full tool output">
                                            <StackPanel Spacing="1">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                                    <ic:SymbolIcon Grid.Column="0" Symbol="ChevronRight" Classes="tone"
                                                               Classes.working="{Binding IsRunning}" Classes.done="{Binding IsDone}"
                                                               Classes.error="{Binding IsFailed}"
                                                               FontSize="12" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Foreground="{DynamicResource FgDim}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Top" />
                                                    <SelectableTextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource Fg}"
                                                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                         TextWrapping="Wrap" ctl:SelectionContextMenu.Enable="True" />
                                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Classes="tone"
                                                               Classes.working="{Binding IsRunning}" Classes.error="{Binding IsFailed}"
                                                               FontSize="11" VerticalAlignment="Top" IsVisible="{Binding ShowStatus}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{DynamicResource FgFaint}"
                                                               FontSize="11" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Top"
                                                               IsVisible="{Binding HasDuration}" />
                                                </Grid>

                                                <!-- A small edit, in place: quicker to read here than to open,
                                                     and watching changes go by is the point of watching an agent. -->
                                                <Border Margin="20,3,0,3" CornerRadius="6" IsVisible="{Binding HasInlineDiff}"
                                                        Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                                        BorderThickness="1" Padding="0,4">
                                                    <ItemsControl ItemsSource="{Binding InlineDiffLines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Classes.add="{Binding IsAdded}" Classes.del="{Binding IsRemoved}">
                                                                    <Grid ColumnDefinitions="14,*">
                                                                        <TextBlock Grid.Column="0" Text="{Binding Marker}" Foreground="{DynamicResource FgDim}"
                                                                                   FontFamily="{StaticResource MonoFont}" FontSize="11" Padding="4,1,0,1" />
                                                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource Fg}"
                                                                                             FontFamily="{StaticResource MonoFont}" FontSize="11" Padding="2,1,8,1"
                                                                                             TextWrapping="Wrap" ctl:SelectionContextMenu.Enable="True" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>

                                                <!-- A larger edit states its size and stays one click away. -->
                                                <TextBlock Text="{Binding DiffSummary}" Foreground="{DynamicResource FgFaint}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="20,0,0,0"
                                                           IsVisible="{Binding HasCollapsedDiff}" />

                                                <!-- Shown when "Tool output" is on — but not under an inline
                                                     diff, where it would only repeat the diff's first line. -->
                                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource FgFaint}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="20,0,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1">
                                                    <TextBlock.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                            <Binding Path="$parent[ItemsControl].DataContext.ToolsExpanded" />
                                                            <Binding Path="ShowSummary" />
                                                        </MultiBinding>
                                                    </TextBlock.IsVisible>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>

                                    <DataTemplate DataType="tr:PlanItemView">
                                        <Border Margin="0,6" Padding="12,9" CornerRadius="8"
                                                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Plan" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="8" Margin="0,2">
                                                                <TextBlock Grid.Column="0" Text="{Binding Status}" Classes="tone" FontSize="11"
                                                                           VerticalAlignment="Top"
                                                                           Classes.done="{Binding Status, Converter={StaticResource PlanDone}}"
                                                                           Classes.working="{Binding Status, Converter={StaticResource PlanRunning}}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Content}" Foreground="{DynamicResource Fg}"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>

                                    <!-- Structured "ask the user" card (AskUserQuestion / requestUserInput). -->
                                    <DataTemplate DataType="tr:QuestionItem">
                                        <Border Margin="0,6" Padding="14,12" CornerRadius="10"
                                                Background="{DynamicResource StatusAttentionSoft}" BorderBrush="{DynamicResource StatusAttention}" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="The agent needs your input" Foreground="{DynamicResource StatusAttention}"
                                                           FontWeight="SemiBold" FontSize="12" />
                                                <ItemsControl ItemsSource="{Binding Questions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Spacing="6" Margin="0,0,0,6">
                                                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="7,2"
                                                                        HorizontalAlignment="Left" IsVisible="{Binding Header, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                                    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Prompt}" Foreground="{DynamicResource Fg}" FontSize="13" TextWrapping="Wrap" />
                                                                <ItemsControl ItemsSource="{Binding Options}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Panel Margin="0,2">
                                                                                <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                             GroupName="{Binding $parent[ItemsControl].DataContext.GroupName}"
                                                                                             IsVisible="{Binding $parent[ItemsControl].DataContext.SingleSelect}">
                                                                                    <StackPanel Spacing="1">
                                                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                                                                                    </StackPanel>
                                                                                </RadioButton>
                                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                          IsVisible="{Binding $parent[ItemsControl].DataContext.MultiSelect}">
                                                                                    <StackPanel Spacing="1">
                                                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                                                                                    </StackPanel>
                                                                                </CheckBox>
                                                                            </Panel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBox Text="{Binding Notes, Mode=TwoWay}" Watermark="Notes (optional)"
                                                                         IsVisible="{Binding AllowFreeText}" AcceptsReturn="True" TextWrapping="Wrap"
                                                                         Background="{DynamicResource Panel}" Foreground="{DynamicResource Fg}"
                                                                         BorderBrush="{DynamicResource Line}" CornerRadius="7" Padding="9,5" FontSize="12" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Resolved}">
                                                    <Button Classes="accent" Content="Submit" Command="{Binding $parent[ItemsControl].DataContext.AnswerQuestionCommand}"
                                                            CommandParameter="{Binding}" Padding="16,6" />
                                                    <Button Classes="chip" Content="Dismiss" Command="{Binding $parent[ItemsControl].DataContext.DismissQuestionCommand}"
                                                            CommandParameter="{Binding}" Padding="16,6" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding Resolved}">
                                                               <ic:SymbolIcon Symbol="Checkmark" Foreground="{DynamicResource Good}" FontSize="13" />
                                                               <TextBlock Text="Answered" Foreground="{DynamicResource Good}" FontSize="11" VerticalAlignment="Center" />
                                                           </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>

                                    <DataTemplate DataType="tr:PermissionItem">
                                        <Border Margin="0,6" Padding="12,9" CornerRadius="8"
                                                Background="{DynamicResource StatusAttentionSoft}" BorderBrush="{DynamicResource StatusAttention}" BorderThickness="1">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="Permission requested" Foreground="{DynamicResource StatusAttention}"
                                                           FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" FontWeight="SemiBold" />

                                                <!-- Exactly what is being approved, verbatim and wrapped. This is
                                                     the last point at which a command can be stopped, so it is
                                                     never ellipsized: the tail of a long line is where the harm
                                                     hides. Tall requests scroll rather than push the buttons off. -->
                                                <Border IsVisible="{Binding HasDetail}" MaxHeight="220" CornerRadius="6"
                                                        Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                                        BorderThickness="1" Padding="9,7">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <SelectableTextBlock Text="{Binding Detail}" Foreground="{DynamicResource Fg}"
                                                                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                             TextWrapping="Wrap" ctl:SelectionContextMenu.Enable="True" />
                                                    </ScrollViewer>
                                                </Border>

                                                <!-- the five facts -->
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Touches" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResourceText}" Foreground="{DynamicResource FgDim}"
                                                               FontSize="11" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Reversible" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReversibleText}" Foreground="{DynamicResource FgDim}"
                                                               FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Why" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Rationale}" Foreground="{DynamicResource FgDim}"
                                                               FontSize="11" TextWrapping="Wrap" />
                                                </Grid>
                                                <TextBlock Text="{Binding NarrowestOptionHint}" Foreground="{DynamicResource StatusAttention}" FontSize="11"
                                                           IsVisible="{Binding HasNarrowestHint}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ResolutionText}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                                           IsVisible="{Binding ResolutionText, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>

                                    <DataTemplate DataType="tr:NoticeItem">
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource FgDim}"
                                                   FontStyle="Italic" Margin="0,6" TextWrapping="Wrap" />
                                    </DataTemplate>

                            </ListBox.DataTemplates>
                        </ListBox>

                        <!-- Sticky context: pin the last human/agent message above a run of tool calls when
                             no message is on screen, so you keep the thread while scrolling (defect #6).
                             Shown/populated from code-behind as the transcript scrolls. -->
                        <Border Grid.Row="1" x:Name="StickyHeader" IsVisible="False" VerticalAlignment="Top" ZIndex="4"
                                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                Padding="24,6" IsHitTestVisible="False">
                            <StackPanel MaxWidth="768" HorizontalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="StickySpeaker" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                <TextBlock x:Name="StickyText" Foreground="{DynamicResource FgDim}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Border>

                        <!-- Index scrollbar: past ~500 rows the transcript is scrolled by message index
                             rather than by pixel, because a virtualizing list's pixel extent is an
                             estimate that keeps being revised under the cursor. This bar's units are
                             messages, so a drag lands where it was aimed. Hidden (and the ListBox's own
                             bar shown instead) below the threshold — see TranscriptIndexScroll. -->
                        <ScrollBar Grid.Row="1" x:Name="IndexScroll" Orientation="Vertical"
                                   Visibility="Hidden" AllowAutoHide="False" ZIndex="6"
                                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                   Minimum="0" SmallChange="1" Scroll="OnIndexScroll" />

                        <!-- Scroll-position hint: the timestamp of what you're looking at, shown only while
                             scrolled up from the live tail (toggled in code-behind), so long conversations
                             aren't disorienting. In index mode it also carries the row you're on, which is
                             the feedback a message-indexed drag needs. -->
                        <Border Grid.Row="1" x:Name="ScrollHint" IsVisible="False" VerticalAlignment="Top"
                                HorizontalAlignment="Center" Margin="0,10,0,0" ZIndex="5" IsHitTestVisible="False"
                                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="10,3" BoxShadow="0 4 12 -4 #4D120C2E">
                            <TextBlock x:Name="ScrollHintText" Foreground="{DynamicResource FgDim}" FontSize="11"
                                       FontFamily="{StaticResource MonoFont}" />
                        </Border>

                        <!-- Thinking indicator: the agent is working even when it hasn't emitted output yet,
                             so there's always a sign it's still going (vs. stopped) — defect #4. -->
                        <Border Grid.Row="1" IsVisible="{Binding IsTurnActive}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,10" ZIndex="4" IsHitTestVisible="False"
                                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="12,5" BoxShadow="0 4 12 -4 #4D120C2E">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Classes="pulse" Width="7" Height="7" CornerRadius="4"
                                        Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="Thinking…" Foreground="{DynamicResource FgDim}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Rewind (viewing history) banner -->
                        <Border Grid.Row="1" VerticalAlignment="Top" IsVisible="{Binding IsRewound}"
                                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}"
                                BorderThickness="0,0,0,1" Padding="24,7" ZIndex="5">
                            <Grid ColumnDefinitions="*,Auto" MaxWidth="768" HorizontalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Viewing earlier history (read-only)" Foreground="{DynamicResource Fg}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <Button Classes="accent" Grid.Column="1" Content="Resume" Command="{Binding ResumeCommand}" Padding="12,4" FontSize="12" />
                            </Grid>
                        </Border>

                        <!-- Raw event / debug inspector (over the transcript) -->
                        <Border Grid.Row="1" IsVisible="{Binding IsInspectorOpen}" Background="{DynamicResource Bg}">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="0,0,0,1" Padding="24,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Event log" Foreground="{DynamicResource Fg}"
                                                   FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{icx:SymbolIcon Symbol=Dismiss}" Command="{Binding ToggleInspectorCommand}"
                                                Background="Transparent" Foreground="{DynamicResource FgDim}" BorderThickness="0"
                                                Padding="8,2" AutomationProperties.Name="Close event log" />
                                    </Grid>
                                </Border>
                                <!-- Virtualized: a long session accumulates thousands of rows; a plain
                                     ItemsControl realized every one and froze the UI. The ListBox brings its
                                     own (virtualizing) scroll viewer. -->
                                <ListBox Grid.Row="1" ItemsSource="{Binding RawEvents}" Padding="16,8"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="44,86,120,*" Margin="0,1">
                                                <TextBlock Grid.Column="0" Text="{Binding Sequence}" Foreground="{DynamicResource Gutter}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11" TextAlignment="Right" Padding="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{DynamicResource FgFaint}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                                <TextBlock Grid.Column="2" Text="{Binding Kind}" Classes="tone"
                                                           Classes.working="{Binding Kind, Converter={StaticResource EventInMotion}}"
                                                           Classes.attention="{Binding Kind, Converter={StaticResource EventBlocked}}"
                                                           Classes.done="{Binding Kind, Converter={StaticResource EventSettled}}"
                                                           Classes.error="{Binding Kind, Converter={StaticResource EventBroken}}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <!-- One line per event is what makes this readable as an index,
                                                     so the summary ellipsizes — but the whole of it is on the
                                                     tooltip, since a clipped command is unreviewable. -->
                                                <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="{DynamicResource FgDim}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Summary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- The pinned "answer me" bar is the same state as the card above it, so it wears
                             the same amber rather than the selection violet. -->
                        <Border Grid.Row="2" Margin="24,4" Padding="14,10" CornerRadius="10"
                                Background="{DynamicResource StatusAttentionSoft}" BorderBrush="{DynamicResource StatusAttention}" BorderThickness="1"
                                IsVisible="{Binding PendingPermission, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="*,Auto,Auto" MaxWidth="768" HorizontalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PendingPermission.Title}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <!-- The bar answers the request without scrolling to the card, so it has to
                                         show the same full command the card does — approving from here must not
                                         mean approving less than you read. -->
                                    <Border IsVisible="{Binding PendingPermission.HasDetail}" MaxHeight="132" CornerRadius="6"
                                            Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" Padding="8,6" Margin="0,2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <SelectableTextBlock Text="{Binding PendingPermission.Detail}" Foreground="{DynamicResource Fg}"
                                                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                 TextWrapping="Wrap" ctl:SelectionContextMenu.Enable="True" />
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding PendingPermission.ResourceText}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                                   FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                        <TextBlock Text="·" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                        <TextBlock Text="{Binding PendingPermission.ReversibleText}" Foreground="{DynamicResource FgDim}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding PendingPermission.NarrowestOptionHint}" Foreground="{DynamicResource StatusAttention}" FontSize="11"
                                               IsVisible="{Binding PendingPermission.HasNarrowestHint}" />
                                </StackPanel>
                                <ItemsControl Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding PendingPermission.Options}"
                                              VerticalAlignment="Center" Margin="8,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RespondWithCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="{DynamicResource Fg}"
                                                    BorderBrush="{DynamicResource StatusAttention}" BorderThickness="1" CornerRadius="8" Padding="12,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,1,0,0" Padding="24,12">
                            <!-- Stretch (not Center) + MaxWidth: a fixed 768px block, centred — otherwise the
                                 panel sizes to content and the composer visibly resizes as you type. -->
                            <StackPanel Spacing="8" MaxWidth="768" HorizontalAlignment="Stretch">

                                <!-- Queued prompts (added while a turn runs; sent in order as turns end) -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasQueue}">
                                    <TextBlock Text="QUEUED" Foreground="{DynamicResource FgDim}" FontSize="10" FontWeight="SemiBold" />
                                    <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PendingPrompts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,2">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                        <ic:SymbolIcon Grid.Column="0" Symbol="MoreVertical" Foreground="{DynamicResource FgFaint}"
                                                                   FontSize="14" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource Fg}"
                                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Content="{icx:SymbolIcon Symbol=ArrowUp}" Padding="6,1" FontSize="11" Background="Transparent"
                                                                Foreground="{DynamicResource FgDim}" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding $parent[ItemsControl].DataContext.MoveQueuedUpCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Move up" />
                                                        <Button Grid.Column="3" Content="{icx:SymbolIcon Symbol=ArrowDown}" Padding="6,1" FontSize="11" Background="Transparent"
                                                                Foreground="{DynamicResource FgDim}" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding $parent[ItemsControl].DataContext.MoveQueuedDownCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Move down" />
                                                        <Button Grid.Column="4" Content="{icx:SymbolIcon Symbol=Dismiss}" Padding="6,1" FontSize="11" Background="Transparent"
                                                                Foreground="{DynamicResource FgFaint}" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveQueuedCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Remove from queue" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Host-side pending queue (sessions/03): the authoritative, multi-client
                                     queue synced from PendingQueueEvent — reorder / remove / send-now act on
                                     the host so every connected client converges. -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasHostPending}">
                                    <TextBlock Text="PENDING (SHARED)" Foreground="{DynamicResource FgDim}" FontSize="10" FontWeight="SemiBold" />
                                    <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding HostPending}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,2">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                                        <ic:SymbolIcon Grid.Column="0" Symbol="MoreVertical" Foreground="{DynamicResource FgFaint}"
                                                                   FontSize="14" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource Fg}"
                                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Content="{icx:SymbolIcon Symbol=ArrowUp}" Padding="6,1" FontSize="11" Background="Transparent"
                                                                Foreground="{DynamicResource FgDim}" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding $parent[ItemsControl].DataContext.HostMoveUpCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Move up" />
                                                        <Button Grid.Column="3" Content="{icx:SymbolIcon Symbol=ArrowDown}" Padding="6,1" FontSize="11" Background="Transparent"
                                                                Foreground="{DynamicResource FgDim}" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding $parent[ItemsControl].DataContext.HostMoveDownCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Move down" />
                                                        <Button Grid.Column="4" Content="{icx:SymbolIcon Symbol=Play}" Padding="6,1" FontSize="11" Background="Transparent"
                                                                Foreground="{DynamicResource Accent}" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding $parent[ItemsControl].DataContext.HostSendNowCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Send now"
                                                                ToolTip.Tip="Interrupt the current turn and send this now" />
                                                        <Button Grid.Column="5" Content="{icx:SymbolIcon Symbol=Dismiss}" Padding="6,1" FontSize="11" Background="Transparent"
                                                                Foreground="{DynamicResource FgFaint}" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding $parent[ItemsControl].DataContext.HostRemoveCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Remove from queue" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Discarded: written-but-undeliverable messages (never silently dropped),
                                     collapsed by default so they stay visible and copyable. -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasDiscarded}">
                                    <Button Command="{Binding ToggleDiscardedCommand}" HorizontalAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            AutomationProperties.Name="Toggle discarded messages">
                                        <TextBlock Text="DISCARDED" Foreground="{DynamicResource FgFaint}" FontSize="10" FontWeight="SemiBold" />
                                    </Button>
                                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowDiscarded}">
                                    <ItemsControl ItemsSource="{Binding DiscardedMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" BorderBrush="{DynamicResource Line}"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,2">
                                                    <TextBlock Text="{Binding Text}" Foreground="{DynamicResource FgFaint}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Slash-command suggestions -->
                                <Border IsVisible="{Binding ShowSlash}" Background="{DynamicResource PanelAlt}"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="4">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SlashSuggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ApplySlashCommand}"
                                                        CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                                        Padding="8,5" CornerRadius="6" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding Name, StringFormat='/{0}'}" Foreground="{DynamicResource Accent}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="12" Width="90" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                                   Foreground="{DynamicResource FgDim}" IsVisible="{Binding !IsBroken}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                                   Foreground="{DynamicResource Danger}" IsVisible="{Binding IsBroken}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Attached context chips -->
                                <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,6,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource Accent}" FontSize="10"
                                                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Fg}" FontSize="11"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                    <Button Content="{icx:SymbolIcon Symbol=Dismiss}" Command="{Binding $parent[ItemsControl].DataContext.RemoveAttachmentCommand}"
                                                            CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource FgFaint}"
                                                            BorderThickness="0" Padding="0" FontSize="9" Cursor="Hand"
                                                            AutomationProperties.Name="Remove attachment" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Context toolbar: @-reference + attach file · mode selector.
                                     A WrapPanel so the controls reflow (never overlap) in narrow columns. -->
                                <WrapPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding ReferenceInput, Mode=TwoWay}" Width="180" Watermark="@ file or url…"
                                             Margin="0,0,6,6"
                                             Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                             BorderBrush="{DynamicResource Line}" CornerRadius="7" Padding="9,4" FontSize="12"
                                             AutomationProperties.Name="Add a context reference"
                                             km:KeymapBinder.Context="SessionReferenceFocus" />
                                    <Button Classes="chip" Content="Add" Command="{Binding AddReferenceCommand}" Margin="0,0,6,6" Padding="10,4" FontSize="12" />
                                    <Button Classes="chip" Content="Attach file…" Click="OnAttachFile" Margin="0,0,6,6" Padding="10,4" FontSize="12"
                                            AutomationProperties.Name="Attach a file or image" />

                                    <!-- mode selector (Ask / Code / …) -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                Margin="4,0,0,6" IsVisible="{Binding HasModes}">
                                        <TextBlock Text="Mode" Foreground="{DynamicResource FgFaint}" FontSize="11" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding Modes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Classes="chip" Content="{Binding Name}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.SetModeCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,4" FontSize="12" AutomationProperties.Name="Switch mode" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding CurrentModeName}" Foreground="{DynamicResource Accent}" FontSize="11"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </StackPanel>

                                    <!-- model picker: switch the agent's model mid-session (relaunches + resumes on the
                                         host). Hidden for adapters with no model axis. -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                Margin="4,0,0,6" IsVisible="{Binding HasModelPicker}">
                                        <TextBlock Text="Model" Foreground="{DynamicResource FgFaint}" FontSize="11" VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                                  FontSize="12" MinHeight="30" Padding="8,2" AutomationProperties.Name="Switch model">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Send policy: what "send" does while a turn is active (sessions/03). -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0,0,6">
                                        <TextBlock Text="When busy" Foreground="{DynamicResource FgFaint}" FontSize="11" VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{Binding SendPolicies}" SelectedItem="{Binding SendPolicy, Mode=TwoWay}"
                                                  FontSize="12" MinHeight="30" Padding="8,2"
                                                  AutomationProperties.Name="Send policy while a turn is active">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource SendPolicyLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Read-only Direct/watch (sessions/02): no composer — a live tail of a session
                                     running outside Agnes. A clear indicator replaces the send box. -->
                                <Border IsVisible="{Binding IsReadOnly}" CornerRadius="10" Padding="12,10"
                                        Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="Eye" FontSize="17" />
                                        <TextBlock Text="Watching (read-only) — this session is running outside Agnes, so sending is disabled."
                                                   Foreground="{DynamicResource FgDim}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding !IsReadOnly}">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBox x:Name="Composer" Text="{Binding PromptText, Mode=TwoWay}"
                                             Watermark="Message the agent…    (drag files or paste an image/file to attach)"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="88" MaxHeight="280" VerticalContentAlignment="Top"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                             BorderBrush="{DynamicResource Line}" CornerRadius="10" Padding="12,10"
                                             AutomationProperties.Name="Message the agent"
                                             km:KeymapBinder.Context="ComposerFocus" />
                                    <!-- The code-behind derives this live hint from the effective keymap and
                                         whether sending would send or queue, so display and execution stay aligned. -->
                                    <TextBlock x:Name="ComposerSendHint" Foreground="{DynamicResource FgFaint}"
                                               FontSize="10" Margin="2,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="6" Width="92">
                                        <!-- Idle: Send -->
                                        <Button Classes="primary" Content="Send" Command="{Binding SendCommand}" IsVisible="{Binding !IsTurnActive}"
                                                Height="40" HorizontalAlignment="Stretch"
                                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center" AutomationProperties.Name="Send message" />
                                        <!-- Running: Queue / Send now / Stop -->
                                        <Button Classes="primary" Content="Queue" Command="{Binding SendCommand}" IsVisible="{Binding IsTurnActive}"
                                                Height="34" HorizontalAlignment="Stretch"
                                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center" AutomationProperties.Name="Queue this prompt"
                                                ToolTip.Tip="Send after the current turn finishes" />
                                        <Button Classes="chip" Content="Send now" Command="{Binding SendNowCommand}" IsVisible="{Binding IsTurnActive}"
                                                Height="30" HorizontalAlignment="Stretch" FontSize="12"
                                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                AutomationProperties.Name="Stop the current turn and send now"
                                                ToolTip.Tip="Stop the current turn and send now" />
                                        <Button Command="{Binding CancelCommand}" IsVisible="{Binding IsTurnActive}"
                                                Height="30" HorizontalAlignment="Stretch"
                                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                Background="Transparent" Foreground="{DynamicResource Fg}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                                                AutomationProperties.Name="Stop the running turn" ToolTip.Tip="Stop the running turn">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Accent}" />
                                                <TextBlock Text="Stop" VerticalAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </LayoutTransformControl>
                    </Grid>

                    <GridSplitter Grid.Column="3" Width="5" ResizeDirection="Columns"
                                  Background="{DynamicResource Line}" IsVisible="{Binding ShowRightPanel}" />

                    <!-- RIGHT: full preview (diff viewer or text) -->
                    <Border Grid.Column="4" IsVisible="{Binding ShowRightPanel}"
                            Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                    <!-- Wraps: this header is often the whole command, and the buttons beside
                                         it keep their own width, so it grows downward rather than cutting off. -->
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedPreview.Title}" Foreground="{DynamicResource Fg}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                               TextWrapping="Wrap" Margin="0,0,10,0" MaxHeight="72" />
                                    <Button Classes="chip" Grid.Column="1" Command="{Binding SelectedPreview.ToggleSplitCommand}"
                                            IsVisible="{Binding SelectedPreview.IsDiff}"
                                            Padding="9,2" FontSize="11" Margin="0,0,8,0"
                                            ToolTip.Tip="Toggle split / unified diff" AutomationProperties.Name="Toggle split diff">
                                        <Panel>
                                            <TextBlock Text="Split" IsVisible="{Binding SelectedPreview.ShowUnified}" />
                                            <TextBlock Text="Unified" IsVisible="{Binding SelectedPreview.ShowSplit}" />
                                        </Panel>
                                    </Button>
                                    <Button Classes="chip" Grid.Column="2" Content="Copy" Click="OnCopyPreview"
                                            Padding="9,2" FontSize="11" Margin="0,0,8,0"
                                            ToolTip.Tip="Copy the contents to the clipboard" AutomationProperties.Name="Copy preview contents" />
                                    <Button Classes="chip" Grid.Column="3" Content="Full screen" Command="{Binding ToggleFullScreenCommand}"
                                            Padding="9,2" FontSize="11" Margin="0,0,8,0"
                                            ToolTip.Tip="Toggle full-screen review" AutomationProperties.Name="Toggle full-screen review" />
                                    <Button Grid.Column="4" Content="{icx:SymbolIcon Symbol=Dismiss}" Command="{Binding ClosePreviewCommand}"
                                            Background="Transparent" Foreground="{DynamicResource FgDim}" BorderThickness="0"
                                            Padding="8,2" FontSize="13" AutomationProperties.Name="Close preview" />
                                </Grid>
                            </Border>

                            <!-- Body area: an optional full command block (the title bar truncates a long
                                 command/path) above the result. The four result views below stay Grid.Row="1"
                                 within this nested grid, so no re-numbering was needed. -->
                            <Grid Grid.Row="1" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" IsVisible="{Binding SelectedPreview.HasCommand}"
                                    Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="0,0,0,1" Padding="14,8" MaxHeight="180">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <SelectableTextBlock Text="{Binding SelectedPreview.Command}" Foreground="{DynamicResource FgDim}"
                                                         FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                                                         ctl:SelectionContextMenu.Enable="True" />
                                </ScrollViewer>
                            </Border>

                            <!-- Unified diff view -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding SelectedPreview.ShowUnified}">
                                <ItemsControl ItemsSource="{Binding SelectedPreview.Diff}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes.add="{Binding IsAdded}" Classes.del="{Binding IsRemoved}"
                                                    Classes.hunk="{Binding IsHunk}">
                                                <Grid ColumnDefinitions="40,40,14,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding OldLineText}" TextAlignment="Right"
                                                               Foreground="{DynamicResource Gutter}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11" Padding="0,1,6,1" />
                                                    <TextBlock Grid.Column="1" Text="{Binding NewLineText}" TextAlignment="Right"
                                                               Foreground="{DynamicResource Gutter}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11" Padding="0,1,6,1" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Marker}" Foreground="{DynamicResource FgDim}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,1" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Foreground="{DynamicResource Fg}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="2,1,8,1"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Split (side-by-side) diff view -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                          IsVisible="{Binding SelectedPreview.ShowSplit}">
                                <ItemsControl ItemsSource="{Binding SelectedPreview.SplitRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,*">
                                                <!-- old (left) -->
                                                <Border Grid.Column="0" Classes.del="{Binding LeftRemoved}" Classes.hunk="{Binding IsHunk}">
                                                    <Grid ColumnDefinitions="40,*">
                                                        <TextBlock Grid.Column="0" Text="{Binding LeftNo}" TextAlignment="Right"
                                                                   Foreground="{DynamicResource Gutter}" FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11" Padding="0,1,6,1" />
                                                        <TextBlock Grid.Column="1" Text="{Binding LeftText}" Foreground="{DynamicResource Fg}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="2,1,8,1"
                                                                   IsVisible="{Binding !IsHunk}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding HeaderText}" Foreground="{DynamicResource HunkFg}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="2,1,8,1"
                                                                   IsVisible="{Binding IsHunk}" />
                                                    </Grid>
                                                </Border>
                                                <!-- new (right) -->
                                                <Border Grid.Column="1" Classes.add="{Binding RightAdded}" Classes.hunk="{Binding IsHunk}">
                                                    <Grid ColumnDefinitions="40,*">
                                                        <TextBlock Grid.Column="0" Text="{Binding RightNo}" TextAlignment="Right"
                                                                   Foreground="{DynamicResource Gutter}" FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11" Padding="0,1,6,1" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RightText}" Foreground="{DynamicResource Fg}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="2,1,8,1" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Markdown preview (chat messages: tables, code, lists, …) -->
                            <mdxaml:MarkdownScrollViewer Grid.Row="1" Padding="16" Markdown="{Binding SelectedPreview.Body}"
                                                         IsVisible="{Binding SelectedPreview.IsMarkdown}"
                                                         SelectionEnabled="True" ctl:SelectionContextMenu.Enable="True">
                                <mdxaml:MarkdownScrollViewer.Styles>
                                    <!-- Same override as the transcript's renderer; see MarkdownStyles.axaml. -->
                                    <StyleInclude Source="avares://Agnes.App.Desktop/Themes/MarkdownStyles.axaml" />
                                </mdxaml:MarkdownScrollViewer.Styles>
                            </mdxaml:MarkdownScrollViewer>

                            <!-- Plain, verbatim text preview (tool output, logs) -->
                            <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding SelectedPreview.IsPlainText}">
                                <SelectableTextBlock Text="{Binding SelectedPreview.Body}" Foreground="{DynamicResource Fg}"
                                           FontSize="13" TextWrapping="Wrap" ctl:SelectionContextMenu.Enable="True" />
                            </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Embedded terminal (platform/03): a bottom-docked, on-demand overlay panel over the LIVE session.
             Gated by TerminalPanelVisible (= IsLive && Session.IsTerminalVisible), a single computed bool on the
             document — so it's hidden on the host-picker/configure screen where there's no session yet. -->

        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="260"
                IsVisible="{Binding TerminalPanelVisible}"
                Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                BoxShadow="0 -8 24 -12 #66120C2E">
            <views:TerminalPanelView DataContext="{Binding Session.Terminal}" />
        </Border>

        <!-- Workspace file browser (git-and-files/03): a right-docked, on-demand overlay panel over the LIVE
             session. Same computed gate as the terminal (FileBrowserPanelVisible) so it never covers the
             configure screen. -->
        <Border Grid.Row="1" HorizontalAlignment="Right" Width="520"
                IsVisible="{Binding FileBrowserPanelVisible}"
                Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"
                BoxShadow="-8 0 24 -12 #66120C2E">
            <views:FileBrowserView DataContext="{Binding Session.FileBrowser}" />
        </Border>

        <!-- Provider login terminal (platform/03): a bottom-docked, interactive terminal running a CLI's login,
             so the user can watch its prompts and type responses. Shown while a login is in progress; the login
             badge refreshes on its own when the CLI exits. Reuses the in-session TerminalPanelView unchanged. -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="300"
                IsVisible="{Binding IsLoginTerminalVisible}"
                Background="{DynamicResource Bg}"
                BorderBrush="{DynamicResource Panel}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,6">
                    <TextBlock Grid.Column="0" Text="Provider login" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg}" />
                    <Button Classes="chip" Grid.Column="1" Content="Close" Command="{Binding CloseLoginTerminalCommand}" Padding="8,2" FontSize="11"
                            ToolTip.Tip="Close the login terminal (the login keeps running until it finishes)" />
                </Grid>
                <views:TerminalPanelView Grid.Row="1" DataContext="{Binding LoginTerminal}" />
            </Grid>
        </Border>
        <!-- ===== pairing QR =====
             Shown only on request, and hidden again from here. The code it carries is a one-time
             credential, not an address, so "hide" revokes it server-side rather than just clearing the
             pixels — see ConnectQrViewModel. -->
        <!-- Spans both rows: this is a modal scrim over the whole tab, not a docked panel like the
             terminal and file browser below, which sit in row 1. Without the span it lands in row 0 —
             the auto-height status strip — where it draws at nearly zero height, so asking for the QR
             appears to do nothing while the view model is left visible and the menu item stays disabled. -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding ConnectQr.IsPanelOpen}"
                Background="{DynamicResource Scrim}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="24" MaxWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Scan to connect a device to this session"
                               FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Fg}" />

                    <!-- Why there is no code, when there isn't one. Without this the whole feature fails
                         silently: the menu item greys out for the length of the request and nothing else
                         ever happens. -->
                    <TextBlock Text="{Binding ConnectQr.Error}" IsVisible="{Binding ConnectQr.HasError}"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Warn}" />

                    <TextBlock Text="Point your phone's camera at this. It pairs the device with this host and opens this session."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource FgDim}"
                               IsVisible="{Binding ConnectQr.IsVisible}" />

                    <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Center"
                            IsVisible="{Binding ConnectQr.IsVisible}">
                        <ctl:QrCodeView Matrix="{Binding ConnectQr.Matrix}" Width="260" Height="260"
                                        Foreground="Black" Background="White" />
                    </Border>

                    <!-- Which address the code points at. The host guesses, and for a QR it often guesses
                         wrong: it may be bound to loopback, or advertise a LAN address to a phone that is
                         only on Tailscale. Switching re-encodes the same grant locally — nothing is
                         re-minted, so the code already scanned stays the code that works. -->
                    <StackPanel Spacing="4" IsVisible="{Binding ConnectQr.IsVisible}">
                        <TextBlock Text="Device connects to" FontSize="11" Foreground="{DynamicResource FgDim}" />

                        <!-- The list the host offered. Shown as a dropdown rather than type-ahead so the
                             alternatives are visible without knowing to look for them — the whole point is
                             that the address the host picked may be one this phone can't route to. -->
                        <ComboBox ItemsSource="{Binding ConnectQr.Addresses}"
                                  SelectedItem="{Binding ConnectQr.Address, Mode=TwoWay}"
                                  IsVisible="{Binding ConnectQr.HasAddressChoice}"
                                  HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                  ToolTip.Tip="Addresses this host reports answering on. Pick the one the scanning device can reach — a LAN or Tailscale address, not loopback." />

                        <TextBlock Text="or type another" FontSize="10" Margin="0,2,0,0"
                                   Foreground="{DynamicResource FgFaint}"
                                   IsVisible="{Binding ConnectQr.HasAddressChoice}" />

                        <TextBox Text="{Binding ConnectQr.Address, Mode=TwoWay}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 Watermark="https://192.168.1.20:5099"
                                 ToolTip.Tip="Any address the device can reach — a port-forward or a MagicDNS name the host can't see for itself." />
                    </StackPanel>

                    <SelectableTextBlock Text="{Binding ConnectQr.DeepLink}" TextWrapping="Wrap"
                                         IsVisible="{Binding ConnectQr.IsVisible}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="10"
                                         Foreground="{DynamicResource FgDim}"
                                         ToolTip.Tip="The link this code encodes — copy it if the camera won't focus." />

                    <TextBlock Text="This code is a credential. It works once, expires in a few minutes, and stops working the moment you hide it."
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Warn}"
                               IsVisible="{Binding ConnectQr.IsVisible}" />

                    <Button Content="Hide" Command="{Binding ConnectQr.HideCommand}"
                            HorizontalAlignment="Right" Padding="16,6" CornerRadius="6"
                            Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
