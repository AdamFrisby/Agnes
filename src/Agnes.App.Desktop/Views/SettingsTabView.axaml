<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:sys="using:System"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             x:Class="Agnes.App.Desktop.Views.SettingsTabView">

    <UserControl.Styles>
        <Style Selector="Button.navitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        </Style>
        <Style Selector="Button.navitem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
        </Style>
        <Style Selector="Button.navitem.on">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Scope notes explain which machine a page's settings live on, so they must not be cut off at the
             right edge — several of them are a sentence or two long. -->
        <Style Selector="TextBlock.scopeNote">
            <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.navGroup">
            <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,12,0,3" />
        </Style>
    </UserControl.Styles>

    <Grid DataContext="{Binding Owner}" RowDefinitions="Auto,*" Background="{DynamicResource Bg}">

        <!-- Header + search -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Spacing="10">
                <TextBlock Text="Settings" Classes="display" FontSize="20" Foreground="{DynamicResource Fg}" />
                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="10,2" Width="340" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="Auto,*">
                        <ic:SymbolIcon Grid.Column="0" Symbol="Search" FontSize="15" Foreground="{DynamicResource FgFaint}"
                                       Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding SettingsSearch, Mode=TwoWay}" Watermark="Search settings…"
                                 Background="Transparent" BorderThickness="0" FontSize="13" Padding="0,6" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <!-- LEFT NAV -->
            <ScrollViewer Grid.Column="0" Background="{DynamicResource Panel}" Padding="10,10">
                <ItemsControl ItemsSource="{Binding SettingsCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="navitem" Classes.on="{Binding IsSelected}" IsVisible="{Binding IsVisible}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding $parent[ItemsControl].DataContext.SetSettingsCategoryCommand}"
                                    CommandParameter="{Binding Id}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <ic:SymbolIcon Symbol="{Binding Icon}" FontSize="16" />
                                    <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- CONTENT -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1000" Margin="32,24,32,48" Spacing="14" HorizontalAlignment="Stretch">

                    <!-- APPEARANCE (this device) -->
                    <StackPanel Spacing="12" IsVisible="{Binding CatAppearance}">
                        <TextBlock Classes="sectionTitle" Text="Appearance" />
                        <TextBlock Classes="scopeNote" Text="These apply to this app on this device." />

                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="fieldLabel" Text="Theme" VerticalAlignment="Center" />
                                <ctl:InfoHint Description="The app's colour scheme. System follows your OS light/dark setting; everything else pins it. The Spacegray flavours are ports of the Sublime Text theme (MIT) — see Themes/Spacegray.axaml for the credit." />
                            </StackPanel>
                            <!-- One row per theme in ThemeCatalog, so adding a theme never touches this view. -->
                            <ItemsControl ItemsSource="{Binding Themes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Classes="seg" Margin="0,0,6,6"
                                                Classes.on="{Binding IsSelected}"
                                                Command="{Binding $parent[ItemsControl].DataContext.SetThemeCommand}"
                                                CommandParameter="{Binding Id}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="UI scale" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Small" Command="{Binding SetScaleCommand}" CommandParameter="small" Classes.on="{Binding IsScaleSmall}" Classes="seg" />
                                <Button Content="Default" Command="{Binding SetScaleCommand}" CommandParameter="default" Classes.on="{Binding IsScaleDefault}" Classes="seg" />
                                <Button Content="Large" Command="{Binding SetScaleCommand}" CommandParameter="large" Classes.on="{Binding IsScaleLarge}" Classes="seg" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox IsChecked="{Binding ReducedMotion, Mode=TwoWay}" Foreground="{DynamicResource Fg}" Content="Reduce motion" />
                            <ctl:InfoHint Description="Minimises non-essential animation. Helpful for motion sensitivity or lower-powered displays." />
                        </StackPanel>
                    </StackPanel>

                    <!-- KEYBOARD (this device). Rendered from KeyboardShortcuts.Groups so the page can't drift
                         from the bindings, and narrowed by the search box above so you can ask it a question. -->
                    <StackPanel Spacing="12" IsVisible="{Binding CatKeyboard}">
                        <TextBlock Classes="sectionTitle" Text="Keyboard shortcuts" />
                        <TextBlock Classes="scopeNote" TextWrapping="Wrap"
                                   Text="These are fixed — Agnes doesn't support rebinding yet. Use the search box above to find one by what it does." />

                        <TextBlock Text="Nothing matches that search." Foreground="{DynamicResource FgFaint}" FontSize="11"
                                   IsVisible="{Binding !HasKeyboardMatches}" />

                        <ItemsControl ItemsSource="{Binding KeyboardGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="160,*" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Gesture}" Foreground="{DynamicResource Fg}" FontSize="11"
                                                                   FontFamily="{StaticResource MonoFont}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource FgDim}"
                                                                   FontSize="11" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- GITHUB (host) -->
                    <StackPanel Spacing="12" IsVisible="{Binding CatGitHub}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="GitHub accounts" />
                            <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                                          Description="Link one or more GitHub accounts so sandboxed agents can push. Each push uses the account that owns the repo, and mints a token scoped to that one repo, ~1h TTL."
                                          Security="These accounts live on the host you're connected to, not this device. App private keys never enter a sandbox; agents get only a short-lived, repo-scoped token at push time, all audited." />
                            <Button Grid.Column="3" Content="Refresh" Command="{Binding LoadCredentialStatusCommand}" Classes="seg" />
                            <Button Grid.Column="4" Content="Connect account" Command="{Binding ConnectGitHubCommand}" Classes="seg" />
                        </Grid>
                        <TextBlock Classes="scopeNote">
                            <Run Text="Linked on the host:" /><Run Text=" " /><Run Text="{Binding ActiveHostName}" FontWeight="SemiBold" />
                        </TextBlock>

                        <!-- The accounts themselves, which is what a page called "GitHub accounts" is for. Each
                             is unlinkable: unlinking drops the App key the host mints push tokens with, so it's
                             two-step rather than one irreversible click. -->
                        <ItemsControl ItemsSource="{Binding LinkedGitHubAccounts}" IsVisible="{Binding HasLinkedGitHubAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Account}" Foreground="{DynamicResource Fg}" FontSize="12" VerticalAlignment="Center" />
                                        <Button Classes="danger" Grid.Column="1" Content="{Binding UnlinkLabel}" FontSize="11" Padding="9,3"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Command="{Binding $parent[ItemsControl].DataContext.UnlinkGitHubCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding CredentialStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- DEVICES (host) -->
                    <StackPanel Spacing="12" IsVisible="{Binding CatDevices}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Devices" />
                            <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                                          Description="Every client paired with this host has its own token. Revoke one to cut off a lost or unwanted device without affecting the others."
                                          Security="Tokens are stored only as hashes on the host. Anyone holding a valid token has full access to this host's sessions." />
                            <Button Grid.Column="3" Content="Refresh" Command="{Binding LoadDevicesCommand}" Classes="seg" />
                        </Grid>
                        <TextBlock Classes="scopeNote">
                            <Run Text="Paired with the host:" /><Run Text=" " /><Run Text="{Binding ActiveHostName}" FontWeight="SemiBold" />
                        </TextBlock>

                        <!-- Devices asking to join, above the paired list: this is the decision that
                             hasn't been made yet, and it's the one worth reading carefully. The digits are
                             derived from the asking device's own key, so the comparison is the security
                             check — approving without it proves nothing. -->
                        <StackPanel Spacing="8" IsVisible="{Binding HasPendingApprovals}">
                            <TextBlock Text="Asking to join" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding PendingApprovals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                                        <Run Text="Check it shows" /><Run Text=" " /><Run Text="{Binding VerificationCode}" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Fg}" /><Run Text=" " /><Run Text="before approving" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Classes="danger" Grid.Column="1" Content="Decline" FontSize="11" Padding="9,3"
                                                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DenyDeviceCommand}" CommandParameter="{Binding RequestId}" />
                                                <Button Grid.Column="2" Content="Approve" FontSize="11" Padding="9,3" Classes="seg"
                                                        Command="{Binding $parent[ItemsControl].DataContext.ApproveDeviceCommand}" CommandParameter="{Binding RequestId}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Last-seen is the field that answers "which of these is stale?", and the device you're
                             sitting at is marked because revoking it signs this app out. Revoke arms on the first
                             click and commits on the second. -->
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" VerticalAlignment="Center" />
                                                <Border CornerRadius="8" Padding="7,1" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsCurrentDevice}">
                                                    <TextBlock Text="this device" FontSize="10" Foreground="{DynamicResource Fg}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                        </StackPanel>
                                        <Button Classes="danger" Grid.Column="1" Content="{Binding RevokeLabel}" FontSize="11" Padding="9,3"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Command="{Binding $parent[ItemsControl].DataContext.RevokeDeviceCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DevicesStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- SANDBOXES (managed VMs on the host) -->
                    <StackPanel Spacing="12" IsVisible="{Binding CatSandboxes}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Sandboxes" />
                            <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                                          Description="The sandbox VMs Agnes has created. Closing a session tab shuts its VM down (freeing CPU + RAM) but keeps it here so you can resume or delete it. A running VM uses host CPU/RAM; a stopped one only uses disk."
                                          Security="These are real VMs on the connected host. Delete destroys a sandbox and everything in it, permanently." />
                            <Button Grid.Column="3" Content="Refresh" Command="{Binding LoadSandboxesCommand}" Classes="seg" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sandboxes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                    <Border CornerRadius="8" Padding="7,1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                                            BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State}" FontSize="10" Foreground="{DynamicResource FgDim}" />
                                                    </Border>
                                                    <TextBlock Text="· live" FontSize="10" Foreground="{DynamicResource Good}" VerticalAlignment="Center" IsVisible="{Binding Live}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding WorkingDirectory}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding VmName, StringFormat='VM: {0}'}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="Resume" Command="{Binding $parent[ItemsControl].DataContext.ResumeSandboxRecordCommand}"
                                                        CommandParameter="{Binding}" Classes="seg" IsVisible="{Binding !Live}"
                                                        ToolTip.Tip="Cold-start the VM and reopen this session in a tab" />
                                                <!-- Two-step: this destroys a VM and its contents for good. -->
                                                <Button Classes="danger" Content="{Binding DeleteLabel}" Command="{Binding $parent[ItemsControl].DataContext.DeleteSandboxRecordCommand}"
                                                        CommandParameter="{Binding}"
                                                        BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SandboxesStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />

                        <!-- Manual orphan reaper (never automatic) -->
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Find orphaned VMs" Command="{Binding FindOrphansCommand}" Classes="seg"
                                    ToolTip.Tip="Scan the host for Agnes VMs no session tracks (e.g. left from a prior daemon run). Nothing is deleted until you confirm." />
                            <Button Classes="danger" Content="{Binding ReapOrphansLabel}" Command="{Binding ReapOrphansCommand}" IsVisible="{Binding HasOrphans}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" Padding="10,4" FontSize="12" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OrphanVmNames}" IsVisible="{Binding HasOrphans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                               FontFamily="{StaticResource MonoFont}" Margin="2,1,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- MCP SERVERS (host-level registry: presets · scope · preview) -->
                    <StackPanel Spacing="12" IsVisible="{Binding CatMcp}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="MCP servers" />
                            <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                                          Description="MCP servers give agents extra tools. Install a curated preset in one click, or add your own. Each server has a scope (all hosts / this host / this workspace) that decides which sessions see it. Changes apply on the next session start, never mid-session."
                                          Security="These servers live on the host you're connected to. A host-run server is proxied into a sandbox through the audited forward; a sandbox-run server runs inside the VM." />
                            <Button Grid.Column="4" Content="Refresh" Command="{Binding LoadMcpCommand}" Classes="seg" Margin="6,0,0,0" />
                        </Grid>
                        <TextBlock Classes="scopeNote">
                            <Run Text="Configured on the host:" /><Run Text=" " /><Run Text="{Binding ActiveHostName}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding McpStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />

                        <!-- Curated quick-install presets -->
                        <TextBlock Text="Quick install" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        <ItemsControl ItemsSource="{Binding McpPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                            <TextBlock Text="{Binding Command}" Foreground="{DynamicResource FgFaint}" FontSize="10" FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                        <!-- Reads "Installed" and disables once the host has it, so the list says what
                                             you already have rather than offering the same install indefinitely. -->
                                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="seg" IsEnabled="{Binding CanInstall}"
                                                Command="{Binding $parent[ItemsControl].DataContext.InstallMcpPresetCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Search the registries. The curated list above is four servers; this reaches the
                             official MCP registry (and any other catalogue plugin the host has). Results say
                             what each server needs before you install it, not after it fails to start. -->
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
                        <TextBlock Text="Find more" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding McpCatalogQuery, Mode=TwoWay}" FontSize="12" Padding="8,5" CornerRadius="6"
                                     Watermark="Search the MCP registries — e.g. postgres, figma, filesystem">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SearchMcpCatalogCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="Search" Command="{Binding SearchMcpCatalogCommand}" Classes="seg" />
                            <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center"
                                         IsVisible="{Binding IsSearchingMcpCatalog}"
                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
                        </Grid>
                        <TextBlock Text="{Binding McpCatalogStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding McpCatalogResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Provenance}" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                                <TextBlock Text="{Binding RequiredEnvironmentLabel}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                                           IsVisible="{Binding NeedsConfiguration}"
                                                           ToolTip.Tip="These environment variables are added empty on install — fill them in under Configured servers before the server will work." />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="seg" VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanInstall}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.InstallMcpCatalogEntryCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Configured servers (with scope + run location) -->
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
                        <TextBlock Text="Configured servers" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        <ItemsControl ItemsSource="{Binding McpServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,3" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                            <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                                <Run Text="{Binding RunAt}" /><Run Text=" · " /><Run Text="{Binding Transport}" /><Run Text=" · " /><Run Text="{Binding ApplyScope}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- The row used to render the raw bool ("True"/"False") next to a button
                                             called "Toggle", which says neither what state you're in nor what the
                                             click will do. Now both are named. -->
                                        <TextBlock Grid.Column="1" Text="enabled" Foreground="{DynamicResource Good}" FontSize="10" VerticalAlignment="Center"
                                                   IsVisible="{Binding Enabled}" />
                                        <TextBlock Grid.Column="1" Text="disabled" Foreground="{DynamicResource FgFaint}" FontSize="10" VerticalAlignment="Center"
                                                   IsVisible="{Binding !Enabled}" />
                                        <Button Grid.Column="2" Content="Disable" Classes="seg" IsVisible="{Binding Enabled}"
                                                Command="{Binding $parent[ItemsControl].DataContext.ToggleMcpServerCommand}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Content="Enable" Classes="seg" IsVisible="{Binding !Enabled}"
                                                Command="{Binding $parent[ItemsControl].DataContext.ToggleMcpServerCommand}" CommandParameter="{Binding}" />
                                        <Button Classes="danger" Grid.Column="3" Content="Remove" FontSize="11" Padding="9,3"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveMcpServerCommand}" CommandParameter="{Binding Id}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add a server by hand (reuses the shared MCP composer fields) -->
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
                        <TextBlock Text="Add a server" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        <StackPanel Spacing="6">
                            <TextBox Text="{Binding NewMcpName, Mode=TwoWay}" Watermark="Server name" FontSize="12" Padding="8,5" CornerRadius="6" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Host" Command="{Binding SetNewMcpRunAtCommand}" CommandParameter="host" Classes.on="{Binding NewMcpRunAtHost}" Classes="seg" />
                                <Button Content="Sandbox" Command="{Binding SetNewMcpRunAtCommand}" CommandParameter="sandbox" Classes.on="{Binding NewMcpRunAtSandbox}" Classes="seg" />
                                <Button Content="stdio" Command="{Binding SetNewMcpTransportCommand}" CommandParameter="stdio" Classes.on="{Binding NewMcpIsStdio}" Classes="seg" />
                                <Button Content="http" Command="{Binding SetNewMcpTransportCommand}" CommandParameter="http" Classes.on="{Binding NewMcpIsHttp}" Classes="seg" />
                            </StackPanel>
                            <StackPanel Spacing="6" IsVisible="{Binding NewMcpIsStdio}">
                                <TextBox Text="{Binding NewMcpCommand, Mode=TwoWay}" Watermark="command (e.g. npx)" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                                <TextBox Text="{Binding NewMcpArgs, Mode=TwoWay}" Watermark="args (space-separated)" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <TextBox IsVisible="{Binding NewMcpIsHttp}" Text="{Binding NewMcpUrl, Mode=TwoWay}" Watermark="https://server/mcp" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                            <Button Content="Add server" Command="{Binding AddMcpServerCommand}" HorizontalAlignment="Left" Classes="seg" />
                        </StackPanel>

                        <!-- Effective-config preview -->
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,4" />
                        <TextBlock Text="Would be active" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        <TextBlock Classes="scopeNote" TextWrapping="Wrap"
                                   Text="The scope-filtered answer for a plain session started right now — including servers from a CLI's own config that Agnes doesn't manage. Recomputed whenever you change something above." />
                        <TextBlock Text="{Binding McpPreviewStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding EffectiveMcp}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="0" Margin="2,1,0,0">
                                        <TextBlock Foreground="{DynamicResource FgDim}" FontSize="11">
                                            <Run Text="{Binding Name}" /><Run Text="  ·  " /><Run Text="{Binding RunAt}" /><Run Text="  ·  " /><Run Text="{Binding ApplyScope}" />
                                        </TextBlock>
                                        <!-- Native-config servers (Agnes didn't add them) are read-only; label their origin CLI. -->
                                        <TextBlock IsVisible="{Binding NativeConfig}" Foreground="{DynamicResource FgFaint}" FontSize="10" Margin="0,0,0,2">
                                            <Run Text="read-only · from " /><Run Text="{Binding Source}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- PROJECTS (per-repo, on the host) -->
                    <StackPanel Spacing="12" IsVisible="{Binding CatProjects}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Projects" />
                            <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                                          Description="A project bundles what a session gets — its sandbox contents, MCP servers, GitHub account and defaults — keyed by the repo. A session in a repo uses that repo's project (auto-created the first time), so different repos get entirely different setups on the same host."
                                          Security="Projects and their sandbox images live on the host. Anything you add to a project's sandbox becomes available to that project's sandboxed agents." />
                            <Button Grid.Column="3" Content="Refresh" Command="{Binding LoadProjectsCommand}" Classes="seg" />
                        </Grid>
                        <TextBlock Text="{Binding ProjectsStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="240,*" ColumnSpacing="16">
                            <!-- Project list -->
                            <Border Grid.Column="0" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="6" VerticalAlignment="Top">
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding $parent[ItemsControl].DataContext.SelectProjectCommand}" CommandParameter="{Binding}">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="13" />
                                                    <TextBlock Text="{Binding RepoKey}" Foreground="{DynamicResource FgFaint}" FontSize="10" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Project editor -->
                            <StackPanel Grid.Column="1" Spacing="12" IsVisible="{Binding HasSelectedProject}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="Name" />
                                    <TextBox Text="{Binding ProjName, Mode=TwoWay}" FontSize="13" Padding="8,5" CornerRadius="6" />
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Line}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Sandbox" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                                    <ctl:InfoHint Description="What this project's VM image contains. Saving rebuilds it (a few minutes); sessions in this repo launch from it." />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding ProjNode, Mode=TwoWay}" Foreground="{DynamicResource Fg}" Content="Install node + npm" />
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="apt packages" />
                                    <TextBox Text="{Binding ProjApt, Mode=TwoWay}" Watermark="git ripgrep cargo…" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="npm globals" />
                                    <TextBox Text="{Binding ProjNpm, Mode=TwoWay}" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="pip packages" />
                                    <TextBox Text="{Binding ProjPip, Mode=TwoWay}" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="VM resources" VerticalAlignment="Center" />
                                    <ctl:InfoHint Description="Per-project sandbox VM size. Leave blank to inherit the host's default (2 CPU / 12 GiB RAM / 16 GiB disk). Applies to newly launched sessions." />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,0">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                        <TextBlock Classes="fieldLabel" Text="CPUs" />
                                        <TextBox Text="{Binding ProjCpu, Mode=TwoWay}" Watermark="default" FontSize="12" Padding="8,5" CornerRadius="6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="2,0,2,0">
                                        <TextBlock Classes="fieldLabel" Text="RAM (GiB)" />
                                        <TextBox Text="{Binding ProjMemoryGiB, Mode=TwoWay}" Watermark="default" FontSize="12" Padding="8,5" CornerRadius="6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" Margin="4,0,0,0">
                                        <TextBlock Classes="fieldLabel" Text="Disk (GiB)" />
                                        <TextBox Text="{Binding ProjDiskGiB, Mode=TwoWay}" Watermark="default" FontSize="12" Padding="8,5" CornerRadius="6" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Line}" />
                                <TextBlock Text="MCP servers" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                <ItemsControl ItemsSource="{Binding ProjectMcp}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                                    <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                                        <Run Text="{Binding Transport}" /><Run Text=" · run at " /><Run Text="{Binding RunAt}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Classes="danger" Grid.Column="1" Content="Remove" FontSize="11" Padding="9,3"
                                                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveProjectMcpCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="9">
                                    <StackPanel Spacing="6">
                                        <TextBox Text="{Binding NewMcpName, Mode=TwoWay}" Watermark="Server name" FontSize="12" Padding="8,5" CornerRadius="6" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="fieldLabel" Text="Run at" VerticalAlignment="Center" />
                                            <Button Content="Host" Command="{Binding SetNewMcpRunAtCommand}" CommandParameter="host" Classes.on="{Binding NewMcpRunAtHost}" Classes="seg" />
                                            <Button Content="Sandbox" Command="{Binding SetNewMcpRunAtCommand}" CommandParameter="sandbox" Classes.on="{Binding NewMcpRunAtSandbox}" Classes="seg" />
                                            <TextBlock Classes="fieldLabel" Text="Transport" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <Button Content="stdio" Command="{Binding SetNewMcpTransportCommand}" CommandParameter="stdio" Classes.on="{Binding NewMcpIsStdio}" Classes="seg" />
                                            <Button Content="http" Command="{Binding SetNewMcpTransportCommand}" CommandParameter="http" Classes.on="{Binding NewMcpIsHttp}" Classes="seg" />
                                        </StackPanel>
                                        <StackPanel Spacing="6" IsVisible="{Binding NewMcpIsStdio}">
                                            <TextBox Text="{Binding NewMcpCommand, Mode=TwoWay}" Watermark="command (e.g. npx)" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                                            <TextBox Text="{Binding NewMcpArgs, Mode=TwoWay}" Watermark="args (space-separated)" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                        <TextBox IsVisible="{Binding NewMcpIsHttp}" Text="{Binding NewMcpUrl, Mode=TwoWay}" Watermark="https://server/mcp" FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" />
                                        <Button Content="Add server" Command="{Binding AddProjectMcpCommand}" HorizontalAlignment="Left" Classes="seg" />
                                    </StackPanel>
                                </Border>

                                <Border Height="1" Background="{DynamicResource Line}" />
                                <TextBlock Text="GitHub" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Account" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding GitHubAccounts}" SelectedItem="{Binding ProjAccount, Mode=TwoWay}" MinWidth="180" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Access" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding ProjGitMode, Mode=TwoWay}" MinWidth="140" HorizontalAlignment="Left"
                                              ToolTip.Tip="Off: no credentials. Ask: approve each repository once. Trust: allow every repo without asking.">
                                        <sys:String>Off</sys:String>
                                        <sys:String>Ask</sys:String>
                                        <sys:String>Trust</sys:String>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Checkout repo" VerticalAlignment="Top" Margin="0,6,0,0" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                        <TextBox Text="{Binding ProjRepo, Mode=TwoWay}" Watermark="owner/repo or https://github.com/owner/repo (optional)"
                                                 FontSize="12" Padding="8,5" CornerRadius="6" FontFamily="{StaticResource MonoFont}" MinWidth="300" HorizontalAlignment="Left" />
                                        <TextBlock Text="Auto-cloned into the working directory before the agent launches (needs an account with access)."
                                                   Foreground="{DynamicResource FgFaint}" FontSize="10" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Line}" />
                                <TextBlock Text="Defaults for new sessions" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="MCP tools" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding ProjMcpApproval, Mode=TwoWay}" MinWidth="140" HorizontalAlignment="Left">
                                        <sys:String>Ask</sys:String>
                                        <sys:String>Trust</sys:String>
                                    </ComboBox>
                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ProjSkipPermissions, Mode=TwoWay}" Foreground="{DynamicResource Fg}" Content="Autonomous by default" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Save project" Command="{Binding SaveProjectCommand}"
                                            HorizontalAlignment="Left" Classes="seg" IsEnabled="{Binding !IsSavingProject}" />
                                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsSavingProject}"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- PLUGINS (NuGet-packaged extensions on the host) -->
                    <StackPanel IsVisible="{Binding CatPlugins}">
                        <StackPanel DataContext="{Binding Plugins}" Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Plugins" />
                                <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                                              Description="Extend this host with NuGet-packaged plugins — new agents, transports, notification channels, and more. Browse a source, install, then enable/disable or configure each one."
                                              Security="Plugins run third-party code on the host. Each declares the access it needs (network, credentials, session content); you approve those capabilities before it ever runs, and a plugin only gets what it declared. Signed packages only, by default." />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="Installed" Command="{Binding ShowInstalledCommand}" Classes="seg" />
                                    <Button Content="Browse" Command="{Binding ShowBrowseCommand}" Classes="seg" />
                                </StackPanel>
                                <Button Grid.Column="4" Margin="6,0,0,0" Content="Refresh" Command="{Binding RefreshCommand}" Classes="seg" />
                            </Grid>

                            <!-- Capability-consent prompt: shown before an install/update runs any plugin code -->
                            <Border IsVisible="{Binding HasPendingConsent}" Background="{DynamicResource PanelAlt}"
                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Fg}" FontSize="13">
                                        <Run Text="Approve access for" /><Run Text=" " /><Run Text="{Binding PendingConsent.PackageId}" />
                                    </TextBlock>
                                    <TextBlock Text="This plugin is requesting the following capabilities. It cannot run until you approve them:"
                                               Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding PendingConsent.Capabilities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding, StringFormat='• {0}'}" Foreground="{DynamicResource Fg}"
                                                           FontSize="12" FontFamily="{StaticResource MonoFont}" Margin="4,1,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                        <Button Content="Approve &amp; install" Command="{Binding ConfirmConsentCommand}" Classes="seg" />
                                        <Button Classes="chip" Content="Cancel" Command="{Binding CancelConsentCommand}" Padding="10,4" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- BROWSE: search the host's configured NuGet source(s) -->
                            <StackPanel Spacing="10" IsVisible="{Binding ShowBrowse}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <!-- Enter searches, so finding a plugin doesn't need a trip to the mouse. -->
                                    <TextBox Grid.Column="0" Watermark="Search plugins…" Text="{Binding SearchQuery, Mode=TwoWay}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Search" Command="{Binding SearchCommand}" Classes="seg" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" IsVisible="{Binding IsReviewed}">
                                                                <ic:SymbolIcon Symbol="CheckmarkCircle" Foreground="{DynamicResource Good}" FontSize="12" />
                                                                <TextBlock Text="{Binding ReviewedLabel}" FontSize="10" Foreground="{DynamicResource Good}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding PackageId}" Foreground="{DynamicResource FgFaint}" FontSize="10" FontFamily="{StaticResource MonoFont}" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                                                        <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                                            <Run Text="by" /><Run Text=" " /><Run Text="{Binding Publisher}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" VerticalAlignment="Center" Content="Install" Classes="seg"
                                                            Command="{Binding $parent[ItemsControl].DataContext.InstallCommand}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- INSTALLED: manage plugins already on the host -->
                            <ItemsControl ItemsSource="{Binding Installed}" IsVisible="{Binding !ShowBrowse}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding PluginId}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                            <Border CornerRadius="8" Padding="7,1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10" Foreground="{DynamicResource FgDim}" />
                                                            </Border>
                                                            <TextBlock Text="· enabled" FontSize="10" Foreground="{DynamicResource Good}" VerticalAlignment="Center" IsVisible="{Binding Enabled}" />
                                                            <TextBlock Text="· disabled" FontSize="10" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" IsVisible="{Binding !Enabled}" />
                                                            <TextBlock Text="· update available" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" IsVisible="{Binding UpdateAvailable}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CapabilitiesLabel, StringFormat='access: {0}'}" Foreground="{DynamicResource FgFaint}" FontSize="10" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="Update" Classes="seg" IsVisible="{Binding UpdateAvailable}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.UpdateCommand}" CommandParameter="{Binding}" />
                                                        <Button Content="Disable" Classes="seg" IsVisible="{Binding Enabled}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.ToggleEnabledCommand}" CommandParameter="{Binding}" />
                                                        <Button Content="Enable" Classes="seg" IsVisible="{Binding !Enabled}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.ToggleEnabledCommand}" CommandParameter="{Binding}" />
                                                        <Button Classes="danger" Content="Uninstall"
                                                                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,4" FontSize="12"
                                                                Command="{Binding $parent[ItemsControl].DataContext.UninstallCommand}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Expander Header="Configure" Padding="0,4,0,0">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="This plugin exposes no configurable settings." Foreground="{DynamicResource FgFaint}"
                                                                   FontSize="11" IsVisible="{Binding !HasSettings}" />
                                                        <ItemsControl ItemsSource="{Binding Settings}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid ColumnDefinitions="140,*" Margin="0,2">
                                                                        <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="fieldLabel" VerticalAlignment="Center" />
                                                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Content="Save configuration" Classes="seg" HorizontalAlignment="Left" IsVisible="{Binding HasSettings}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.SaveConfigurationCommand}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- REPORT A BUG (files a GitHub issue on the host, or falls back to the public flow) -->
                    <StackPanel IsVisible="{Binding CatBugReport}">
                        <StackPanel DataContext="{Binding BugReport}" Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Report a bug" />
                                <ctl:InfoHint Grid.Column="1" Margin="6,0,0,0"
                                              Description="Describe what went wrong. This files an issue on the project's GitHub, or — if this host has a GitHub token — first checks for likely duplicates you can comment on instead. If the host can't be reached, a prefilled issue opens in your browser."
                                              Security="Only the text you enter here is sent. No host logs or diagnostic data are attached (that owner-only capability isn't enabled)." />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Title" />
                                <TextBox Text="{Binding Title, Mode=TwoWay}" Watermark="A short summary of the problem" FontSize="13" Padding="8,5" CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Summary" />
                                <TextBox Text="{Binding Summary, Mode=TwoWay}" Watermark="What happened?" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" FontSize="13" Padding="8,5" CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Current behavior (optional)" />
                                <TextBox Text="{Binding CurrentBehavior, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" FontSize="13" Padding="8,5" CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Expected behavior (optional)" />
                                <TextBox Text="{Binding ExpectedBehavior, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" FontSize="13" Padding="8,5" CornerRadius="6" />
                            </StackPanel>

                            <!-- Owner-only, opt-in host-log attachment. Shown only when the host tells us this
                                 caller is the authorized owner AND the operator enabled the capability. Off by
                                 default; the host re-checks authorization before it attaches anything. -->
                            <StackPanel Spacing="3" IsVisible="{Binding CanAttachDiagnostics}">
                                <CheckBox Content="Attach host diagnostics (owner only)" IsChecked="{Binding AttachDiagnostics, Mode=TwoWay}" />
                                <TextBlock Classes="fieldLabel" TextWrapping="Wrap"
                                           Text="Includes recent host log lines, runtime/OS and adapter info, and recent error telemetry from this host. Sensitive — only attach when you're comfortable sharing it with the maintainer." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Submit report" Command="{Binding SubmitCommand}" HorizontalAlignment="Left" Classes="seg" IsEnabled="{Binding !IsBusy}" />
                                <ProgressBar IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center"
                                             IsVisible="{Binding IsBusy}"
                                             Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
                            </StackPanel>

                            <!-- Likely-duplicate issues: comment on one instead of filing a new report -->
                            <StackPanel Spacing="6" IsVisible="{Binding HasDuplicates}">
                                <TextBlock Text="Possibly related open issues" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                <ItemsControl ItemsSource="{Binding Duplicates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Number, StringFormat='#{0}'}" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Comment instead" FontSize="11" Padding="9,3" Classes="seg"
                                                        Command="{Binding $parent[ItemsControl].DataContext.OpenDuplicateCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Prompts: saved reusable prompts + slash-token templates that expand them -->
                    <StackPanel IsVisible="{Binding CatPrompts}">
                        <StackPanel DataContext="{Binding PromptLibrary}" Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Prompts" />
                                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Classes="seg" />
                            </Grid>
                            <TextBlock Classes="scopeNote"
                                       Text="Save prompts you retype, then bind a slash token (e.g. /review) that inserts one in the composer — or inserts and sends it." />

                            <!-- Prompt editor. One set of fields serves both "new" and "edit", so which one it's
                                 doing is stated above Save — otherwise Save silently overwrites whatever you last
                                 clicked Edit on. -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding EditorHeading}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                                    <Border CornerRadius="8" Padding="7,1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" VerticalAlignment="Center" IsVisible="{Binding IsEditingExistingPrompt}">
                                        <TextBlock Text="Save replaces it" FontSize="10" Foreground="{DynamicResource FgDim}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="fieldLabel" Text="Title" />
                                <TextBox Text="{Binding PromptTitle, Mode=TwoWay}" Watermark="e.g. Security review" FontSize="12" Padding="8,5" CornerRadius="6" />
                                <TextBlock Classes="fieldLabel" Text="Prompt body" />
                                <TextBox Text="{Binding PromptBody, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                                         Watermark="Review this diff for security issues…" FontSize="12" Padding="8,5" CornerRadius="6" />
                                <CheckBox IsChecked="{Binding PromptIsSystemAddition, Mode=TwoWay}"
                                          Content="Use as a system-prompt addition (prepended to a session's system prompt at open)" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{Binding SaveLabel}" Command="{Binding SavePromptCommand}" Classes="seg" />
                                    <Button Content="Cancel edit" Command="{Binding CancelEditCommand}" Classes="seg" IsVisible="{Binding IsEditingExistingPrompt}" />
                                    <Button Content="New" Command="{Binding NewPromptCommand}" Classes="seg" IsVisible="{Binding !IsEditingExistingPrompt}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Saved prompts. The body preview is the only thing that tells two similarly-named
                                 prompts apart, so the row carries it rather than the title alone. -->
                            <ItemsControl ItemsSource="{Binding Prompts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" VerticalAlignment="Center" />
                                                        <Border CornerRadius="8" Padding="7,1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                                                                BorderThickness="1" VerticalAlignment="Center" IsVisible="{Binding IsSystemPromptAddition}"
                                                                ToolTip.Tip="Prepended to a session's system prompt at open, rather than inserted per message.">
                                                            <TextBlock Text="system prompt" FontSize="10" Foreground="{DynamicResource FgDim}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MarkdownBody}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                                                               MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Edit" Classes="seg" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].DataContext.EditPromptCommand}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="Delete" Classes="seg" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DeletePromptCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Skill bundles. Installing is the point of this section — a delete-only list of
                                 skills you have no way to acquire is a dead end — so the registry the host offers
                                 is browsable here, and an unconfigured host says so instead of showing nothing. -->
                            <TextBlock Classes="sectionTitle" Text="Skills" FontSize="14" />
                            <TextBlock Classes="scopeNote"
                                       Text="Skill bundles (a SKILL.md plus supporting files) installed from a registry the host offers, and managed as a unit." />
                            <TextBlock Text="{Binding SkillStatus}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding SkillStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                                    <TextBlock Text="{Binding SupportingFiles.Count, StringFormat='{}{0} supporting file(s)'}"
                                                               Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Delete" Classes="seg"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DeleteSkillCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Install from a registry. One box searches every registry the host has at once:
                                 what a person wants is "a skill that does X", and which index happens to hold it
                                 is the registry's problem — so the source is shown per result instead of being
                                 a choice you make first. -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasSkillRegistries}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding SkillQuery, Mode=TwoWay}" FontSize="12" Padding="8,5" CornerRadius="6"
                                             Watermark="Search every skill registry — e.g. pdf, terraform, code review">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding BrowseRegistryCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Content="Search" Command="{Binding BrowseRegistryCommand}" Classes="seg" />
                                    <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsSearchingSkills}"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelAlt}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding RegistrySkills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                        <!-- Publisher, popularity and source: a public index holds many
                                                             skills of the same name, and this is how you tell them apart. -->
                                                        <TextBlock Text="{Binding Provenance}" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="seg" VerticalAlignment="Center"
                                                            IsEnabled="{Binding CanInstall}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.InstallSkillCommand}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Template editor -->
                            <TextBlock Classes="sectionTitle" Text="Templates" FontSize="14" />
                            <StackPanel Spacing="6">
                                <TextBlock Classes="fieldLabel" Text="Slash token" />
                                <TextBox Text="{Binding TemplateToken, Mode=TwoWay}" Watermark="/review" FontSize="12" Padding="8,5" CornerRadius="6"
                                         FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Classes="fieldLabel" Text="Inserts prompt" />
                                <ComboBox ItemsSource="{Binding Prompts}" SelectedValue="{Binding TemplatePromptId, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Id}" HorizontalAlignment="Stretch" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox IsChecked="{Binding TemplateSendImmediately, Mode=TwoWay}" Content="Send immediately (Insert and send)" FontSize="12" />
                                <Button Content="Save template" Command="{Binding SaveTemplateCommand}" Classes="seg" HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- Saved templates -->
                            <ItemsControl ItemsSource="{Binding Templates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding SlashToken, StringFormat='/{0}'}" Foreground="{DynamicResource Accent}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="12" Width="90" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding TargetLabel}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgDim}" IsVisible="{Binding !IsBroken}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding IsBroken}">
                                                    <ic:SymbolIcon Symbol="Warning" IconVariant="Filled" Foreground="{DynamicResource Danger}" FontSize="13" />
                                                    <TextBlock Text="{Binding TargetLabel}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Danger}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="send" FontSize="10" Foreground="{DynamicResource Good}" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" IsVisible="{Binding SendImmediately}" />
                                                <Button Grid.Column="3" Content="Delete" Classes="seg"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DeleteTemplateCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Launch profiles -->
                    <StackPanel IsVisible="{Binding CatProfiles}">
                        <StackPanel DataContext="{Binding LaunchProfiles}" Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Launch profiles" />
                                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Classes="seg" />
                            </Grid>
                            <TextBlock Classes="scopeNote"
                                       Text="Named, reusable new-session configs — agent, permission posture, git/sandbox defaults, model. Create one from the new-session screen with &quot;Save current as profile…&quot;; applying it there prefills the launch controls. Deleting a profile never affects a session already launched from it." />

                            <!-- Each row spells out what the profile would actually do, because "name + adapter id"
                                 can't answer that; and it can start a session, because starting one is the whole
                                 point of having saved it. -->
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12"
                                                               IsVisible="{Binding !IsRenaming}" />
                                                    <TextBox Text="{Binding DraftName, Mode=TwoWay}" FontSize="12" Padding="6,3" CornerRadius="6"
                                                             MaxWidth="260" HorizontalAlignment="Left" IsVisible="{Binding IsRenaming}">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter" Command="{Binding $parent[ItemsControl].DataContext.CommitRenameCommand}" CommandParameter="{Binding}" />
                                                            <KeyBinding Gesture="Escape" Command="{Binding $parent[ItemsControl].DataContext.CancelRenameCommand}" CommandParameter="{Binding}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <TextBlock Text="{Binding Where}" Foreground="{DynamicResource FgDim}" FontSize="10" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Posture}" Foreground="{DynamicResource FgFaint}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="New session" Classes="seg" VerticalAlignment="Center"
                                                        ToolTip.Tip="Open a new-session tab with this profile's options already applied."
                                                        Command="{Binding $parent[UserControl].DataContext.Owner.StartFromLaunchProfileCommand}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="Rename" Classes="seg" VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}"
                                                        Command="{Binding $parent[ItemsControl].DataContext.BeginRenameCommand}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="Save name" Classes="seg" VerticalAlignment="Center" IsVisible="{Binding IsRenaming}"
                                                        Command="{Binding $parent[ItemsControl].DataContext.CommitRenameCommand}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="3" Content="Delete" Classes="seg" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DeleteCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Collaborators & access grants (collaboration/01) -->
                    <StackPanel IsVisible="{Binding CatCollaborators}">
                        <StackPanel DataContext="{Binding Collaborators}" Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="Collaborators" />
                                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Classes="seg" />
                            </Grid>
                            <TextBlock Classes="scopeNote"
                                       Text="A collaborator is a GitHub-verified user. Being a collaborator (or sharing a configured org/team) only makes someone eligible — it shares nothing on its own. Access is conferred only by an explicit, revocable grant below. Owner-only." />

                            <!-- Add a collaborator by GitHub handle, with a live eligibility hint -->
                            <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding NewCollaboratorHandle, Mode=TwoWay}" PlaceholderText="GitHub handle" />
                                <TextBox Grid.Column="1" Text="{Binding NewCollaboratorDisplayName, Mode=TwoWay}" PlaceholderText="Display name (optional)" />
                                <Button Grid.Column="2" Content="Check" Command="{Binding CheckEligibilityCommand}" Classes="seg" />
                                <Button Grid.Column="3" Content="Add collaborator" Command="{Binding AddCollaboratorCommand}" Classes="seg" />
                            </Grid>
                            <TextBlock Text="{Binding EligibilityHint}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding EligibilityHint, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                            <!-- Each row says why the person is listed (added by hand vs surfaced from a shared
                                 org/team) and can re-check its own eligibility, instead of making you retype the
                                 handle into the box above to find out. -->
                            <ItemsControl ItemsSource="{Binding Collaborators}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="{Binding GitHubLogin}" Foreground="{DynamicResource Fg}" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                                        <Run Text="{Binding SourceLabel}" /><Run Text=" · " /><Run Text="{Binding AddedLabel}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding EligibilityNote}" Foreground="{DynamicResource FgDim}" FontSize="10"
                                                               IsVisible="{Binding HasEligibilityNote}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Check" Classes="seg" VerticalAlignment="Center"
                                                        ToolTip.Tip="Ask the host, now, whether this person is currently eligible for a grant."
                                                        Command="{Binding $parent[ItemsControl].DataContext.CheckCollaboratorEligibilityCommand}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="Remove" Classes="seg" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveCollaboratorCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Grant access to an eligible collaborator. What a grant names used to be a free-text
                                 "resource id" with no discoverable values; it's now a picker built from the host
                                 and its open sessions. -->
                            <TextBlock Classes="sectionTitle" Text="Access grants" Margin="0,6,0,0" />
                            <TextBlock Classes="scopeNote" TextWrapping="Wrap"
                                       Text="A grant is recorded here and honoured wherever a feature asks for it. To hand someone a session today, use Share on that session — that path enforces access itself." />
                            <TextBlock Classes="scopeNote" Text="Connect a host, and open a session, to have something to grant against."
                                       IsVisible="{Binding !HasGrantTargets}" />
                            <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding HasGrantTargets}">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Collaborators}" SelectedItem="{Binding SelectedCollaborator, Mode=TwoWay}"
                                          PlaceholderText="Collaborator" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GitHubLogin}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding GrantTargets}" SelectedItem="{Binding SelectedGrantTarget, Mode=TwoWay}"
                                          PlaceholderText="What they get" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Scopes}" SelectedItem="{Binding NewGrantScope, Mode=TwoWay}" />
                                <Button Grid.Column="3" Content="Grant" Command="{Binding GrantCommand}" Classes="seg" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Grants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GranteeLogin}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                                    <TextBlock Foreground="{DynamicResource FgFaint}" FontSize="10">
                                                        <Run Text="{Binding Resource}" /><Run Text=" · " /><Run Text="{Binding Scope}" /><Run Text=" · granted " /><Run Text="{Binding GrantedAt, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Revoke" Classes="seg"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RevokeGrantCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
