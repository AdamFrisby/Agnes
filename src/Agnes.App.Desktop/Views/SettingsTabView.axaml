<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:sys="using:System"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ctl="using:Agnes.App.Desktop.Controls"
             xmlns:km="using:Agnes.App.Desktop.Keymaps"
             xmlns:settings="using:Agnes.App.Desktop.Views.Settings"
             x:Class="Agnes.App.Desktop.Views.SettingsTabView">

    <UserControl.Styles>
        <StyleInclude Source="/Views/Settings/SettingsKit.axaml" />
        <Style Selector="Button.navitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        </Style>
        <Style Selector="Button.navitem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
        </Style>
        <Style Selector="Button.navitem.on">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Scope notes explain which machine a page's settings live on, so they must not be cut off at the
             right edge — several of them are a sentence or two long. -->
        <Style Selector="TextBlock.scopeNote">
            <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.navGroup">
            <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,12,0,3" />
        </Style>
    </UserControl.Styles>

    <Grid DataContext="{Binding Owner}" RowDefinitions="Auto,*" Background="{DynamicResource Bg}">

        <!-- Header + search -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Spacing="10">
                <TextBlock Text="Settings" Classes="display" FontSize="20" Foreground="{DynamicResource Fg}" />
                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="10,2" Width="340" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="Auto,*">
                        <ic:SymbolIcon Grid.Column="0" Symbol="Search" FontSize="15" Foreground="{DynamicResource FgFaint}"
                                       Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding SettingsSearch, Mode=TwoWay}" Watermark="Search settings…"
                                 Background="Transparent" BorderThickness="0" FontSize="13" Padding="0,6" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <!-- LEFT NAV -->
            <ScrollViewer Grid.Column="0" Background="{DynamicResource Panel}" Padding="10,10">
                <ItemsControl ItemsSource="{Binding SettingsCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="navitem" Classes.on="{Binding IsSelected}" IsVisible="{Binding IsVisible}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding $parent[ItemsControl].DataContext.SetSettingsCategoryCommand}"
                                    CommandParameter="{Binding Id}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <ic:SymbolIcon Symbol="{Binding Icon}" FontSize="16" />
                                    <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- CONTENT -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1000" Margin="32,24,32,48" Spacing="14" HorizontalAlignment="Stretch">
                    <settings:AppearancePage IsVisible="{Binding CatAppearance}" />
                    <settings:KeymapPage IsVisible="{Binding CatKeymap}" />
                    <settings:GitHubPage IsVisible="{Binding CatGitHub}" />
                    <settings:DevicesPage IsVisible="{Binding CatDevices}" />
                    <settings:SandboxesPage IsVisible="{Binding CatSandboxes}" />
                    <settings:LocalModelsPage IsVisible="{Binding CatLocalModels}" />
                    <settings:McpPage IsVisible="{Binding CatMcp}" />
                    <settings:ProjectsPage IsVisible="{Binding CatProjects}" />
                    <settings:CachePage IsVisible="{Binding CatCache}" />
                    <settings:PluginsPage IsVisible="{Binding CatPlugins}" />
                    <settings:BugReportPage IsVisible="{Binding CatBugReport}" />
                    <settings:PromptsPage IsVisible="{Binding CatPrompts}" />
                    <settings:LaunchProfilesPage IsVisible="{Binding CatProfiles}" />
                    <settings:CollaboratorsPage IsVisible="{Binding CatCollaborators}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
