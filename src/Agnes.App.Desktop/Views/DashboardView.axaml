<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Agnes.App.Desktop.Views.DashboardView">

    <!-- DataContext is a DashboardDocument; narrow it to its view model so bindings read directly. -->
    <ScrollViewer DataContext="{Binding Dashboard}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="18" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- ================= header ================= -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Dashboard" Classes="display" FontSize="20" Foreground="{DynamicResource Fg}" />
                    <TextBlock Foreground="{DynamicResource FgDim}" FontSize="12"
                               Text="Every session your hosts are running — and anything waiting on you." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="status working" Padding="9,3" IsVisible="{Binding HasWorking}">
                        <TextBlock Text="{Binding WorkingCount, StringFormat='{}{0} working'}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="status attention" Padding="9,3" IsVisible="{Binding HasBlocked}">
                        <TextBlock Text="{Binding BlockedCount, StringFormat='{}{0} waiting on you'}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Button Classes="chip" Content="Refresh" Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="Refresh the dashboard" />
                </StackPanel>
            </Grid>

            <!-- ================= attention band =================
                 The one prominent block: approvals a human has to answer, plus notices that mean the same
                 thing (a host that dropped, a session that faulted). Amber throughout — blocked on you. -->
            <Border Classes="card" Padding="16" IsVisible="{Binding HasAttention}"
                    Background="{DynamicResource StatusAttentionSoft}"
                    BorderBrush="{DynamicResource StatusAttention}"
                    AutomationProperties.Name="Waiting on you">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Warning" IconVariant="Filled" Classes="tone attention" FontSize="17" />
                        <TextBlock Text="WAITING ON YOU" Classes="section" Foreground="{DynamicResource StatusAttention}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Open authorisation requests, across every session and host. -->
                    <ItemsControl ItemsSource="{Binding Approvals.Approvals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}"
                                                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{DynamicResource FgDim}" FontSize="11"
                                                       Text="{Binding Source, StringFormat='asked by {0}'}"
                                                       IsVisible="{Binding Source, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- A session permission is answered in the session, so the action is "go there". -->
                                            <Button Classes="primary" Content="Open session" FontSize="12" Padding="10,4"
                                                    IsVisible="{Binding SessionId, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.Approvals.JumpCommand}"
                                                    CommandParameter="{Binding}" />
                                            <!-- Everything else is answerable right here: an external request's own
                                                 options, or approve/reject for a gated action. A request with no way
                                                 to answer it would make this band a dead end. -->
                                            <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding HasChoices}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Label}" Command="{Binding Command}"
                                                                FontSize="12" Padding="10,4"
                                                                Classes.primary="{Binding IsPrimary}"
                                                                Classes.chip="{Binding !IsPrimary}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Notices: not approvals, but the same "look at this" weight. -->
                    <ItemsControl ItemsSource="{Binding Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Classes="tone" Classes.attention="{Binding !IsError}"
                                                       Classes.error="{Binding IsError}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource FgDim}"
                                                       FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary" Content="Open session" FontSize="12" Padding="10,4"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding SessionId, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Command="{Binding $parent[ItemsControl].DataContext.OpenNoticeCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= open here ================= -->
            <StackPanel Spacing="10" IsVisible="{Binding HasLive}">
                <TextBlock Text="OPEN IN THIS WINDOW" Classes="section" />
                <ItemsControl ItemsSource="{Binding Live}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Padding="14" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="statusdot" VerticalAlignment="Top" Margin="0,6,0,0"
                                            Classes.working="{Binding IsWorking}"
                                            Classes.attention="{Binding IsAwaitingInput}"
                                            Classes.review="{Binding IsReadyForReview}"
                                            Classes.error="{Binding IsFaulted}" />

                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}"
                                                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ActivityText}" FontSize="11" VerticalAlignment="Center"
                                                       Classes="tone"
                                                       Classes.working="{Binding IsWorking}"
                                                       Classes.attention="{Binding IsAwaitingInput}"
                                                       Classes.done="{Binding IsReadyForReview}"
                                                       Classes.error="{Binding IsFaulted}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding CurrentStep}" Foreground="{DynamicResource FgDim}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasCurrentStep}" />

                                        <!-- Plan progress: the honest measure of "how far in" when the agent made a plan. -->
                                        <StackPanel Spacing="3" IsVisible="{Binding HasPlan}">
                                            <ProgressBar Classes="ctx" Height="4" Minimum="0" Maximum="1"
                                                         Value="{Binding PlanFraction}" />
                                            <TextBlock Text="{Binding PlanText}" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                            <TextBlock Text="{Binding WorkingDirectory}" Classes="mono"
                                                       Foreground="{DynamicResource FgFaint}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                            <TextBlock Text="{Binding UsageSummary}" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2" Classes="chip" Content="Go to tab" FontSize="12" Padding="10,4"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].DataContext.FocusCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ================= running elsewhere ================= -->
            <StackPanel Spacing="10" IsVisible="{Binding HasElsewhere}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ALSO RUNNING ON YOUR HOSTS" Classes="section" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ElsewhereCount}" Classes="section" Foreground="{DynamicResource FgDim}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Elsewhere}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Padding="12" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="statusdot" VerticalAlignment="Center"
                                            Classes.working="{Binding IsWorking}"
                                            Classes.attention="{Binding IsBlocked}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}"
                                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding AdapterId}" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                            <TextBlock Text="{Binding WorkingDirectory}" Classes="mono"
                                                       Foreground="{DynamicResource FgFaint}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                            <TextBlock Text="{Binding Age}" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="11" VerticalAlignment="Center"
                                               Classes="tone"
                                               Classes.working="{Binding IsWorking}"
                                               Classes.attention="{Binding IsBlocked}" />
                                    <Button Grid.Column="3" Classes="primary" Content="Join" FontSize="12" Padding="12,4"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].DataContext.Catalog.AttachCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Join this session" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ================= empty ================= -->
            <Border Classes="card" Padding="24" IsVisible="{Binding IsEmpty}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Nothing is running yet" Foreground="{DynamicResource Fg}" FontSize="14"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Open a tab and start a session — it'll show up here."
                               Foreground="{DynamicResource FgDim}" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Catalog.Status}" Foreground="{DynamicResource FgFaint}" FontSize="11" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
