      <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="PanelAlt" />
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="LineStrong" />
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="Accent" />
      <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="Line" />
      <StaticResource x:Key="ComboBoxForeground" ResourceKey="Fg" />
