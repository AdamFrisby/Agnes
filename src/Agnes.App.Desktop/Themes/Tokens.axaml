<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <!--
    Multitudal design tokens, as consumed by the Agnes desktop client.

    Source of truth is the brand bundle's `tokens/*.css`; this file is its Avalonia translation, and is
    the twin of `Agnes.App.Mobile/Themes/Tokens.axaml` — same palette, same gradient, different key
    names (the desktop head's existing vocabulary: Panel/Fg/Line rather than Surface/Text/Border).
    Two built-in variants:
      · Dark  — the Agnes console palette from `ui_kits/agnes` (#0F0A22 / #16112E / #1C1740, accent
                #B06CF0). The kit itself is authored dark and it's where the app is used most.
      · Light — the shared Multitudal neutrals (cool, faintly violet; never neutral grey, never warm)
                on near-white surfaces, ink #1D1546, accent indigo-600.

    THE SHAPE OF THIS FILE MATTERS, because it is what makes a theme cheap to write:

      1. Each variant defines COLOURS only (`AccentColor`, `PanelColor`, …) — nothing else.
      2. Everything downstream is a brush over `{DynamicResource <role>Color}`: the roles views bind
         to, the status hues, Dock's chrome, and the handful of Fluent keys a palette can't express.

    So a theme overrides ~32 colours and every derived brush follows on its own. Were these aliases
    instead written as `StaticResource`, they'd bind to *this* file's brushes at load and a theme
    could never move them — which is the trap Fluent and Dock both fall into internally, and why the
    "Fluent residue" section below exists at all.

    Stock control chrome is NOT set here: `FluentTheme.Palettes` in App.axaml carries it, which is
    Avalonia's supported hook (see the comment in Avalonia's own FluentTheme.xaml). It reaches
    Fluent's neutral ramp properly, so only the few brand-tinted states below need restating.

    Colour roles, not colour names: a view asks for `PanelAlt` or `Danger`, never a hex literal. The
    Agnes gradient (violet → magenta → coral) is the one signature flourish, used at most once per
    view. See `Themes/ThemeCatalog.cs` for how a whole theme is swapped at runtime.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <!-- ================= DARK (Agnes console) ================= -->
    <ResourceDictionary x:Key="Dark">
      <!-- app canvas -->
      <Color x:Key="BgColor">#0F0A22</Color>
      <!-- raised surface -->
      <Color x:Key="PanelColor">#16112E</Color>
      <!-- sunken/secondary surface -->
      <Color x:Key="PanelAltColor">#1C1740</Color>
      <!-- code + logs -->
      <Color x:Key="CodeBgColor">#120C2E</Color>
      <!-- dialog scrim -->
      <Color x:Key="ScrimColor">#8C120C2E</Color>
      <!-- hairline -->
      <Color x:Key="LineColor">#1FFFFFFF</Color>
      <!-- stronger hairline -->
      <Color x:Key="LineStrongColor">#33FFFFFF</Color>
      <!-- primary ink -->
      <Color x:Key="FgColor">#E6E3F7</Color>
      <!-- secondary ink -->
      <Color x:Key="FgDimColor">#9C97C4</Color>
      <!-- tertiary ink -->
      <Color x:Key="FgFaintColor">#6B6796</Color>
      <!-- ink on an accent fill -->
      <Color x:Key="FgOnAccentColor">#FFFFFF</Color>
      <!-- selection + brand -->
      <Color x:Key="AccentColor">#B06CF0</Color>
      <!-- accent, legible as text -->
      <Color x:Key="AccentTextColor">#D9B8FF</Color>
      <!-- accent tint (hover) -->
      <Color x:Key="AccentSoftColor">#2EB06CF0</Color>
      <!-- accent tint (pressed/selected) -->
      <Color x:Key="AccentEdgeColor">#4DB06CF0</Color>
      <!-- mint -->
      <Color x:Key="GoodColor">#3ADBB4</Color>
      <Color x:Key="GoodSoftColor">#243ADBB4</Color>
      <!-- amber -->
      <Color x:Key="WarnColor">#FFC53D</Color>
      <Color x:Key="WarnSoftColor">#26FFC53D</Color>
      <!-- pink -->
      <Color x:Key="DangerColor">#FF7BA5</Color>
      <Color x:Key="DangerSoftColor">#26F0356F</Color>
      <!-- sky -->
      <Color x:Key="InfoColor">#38BDF8</Color>
      <Color x:Key="InfoSoftColor">#2438BDF8</Color>
      <!-- chat -->
      <Color x:Key="UserBubbleColor">#241E4E</Color>
      <!-- diff -->
      <Color x:Key="DiffAddBgColor">#1A3ADBB4</Color>
      <Color x:Key="DiffAddFgColor">#6FEBC5</Color>
      <Color x:Key="DiffDelBgColor">#1FF0356F</Color>
      <Color x:Key="DiffDelFgColor">#FF9BBB</Color>
      <Color x:Key="HunkBgColor">#2038BDF8</Color>
      <Color x:Key="HunkFgColor">#86D3F7</Color>
      <!-- diff gutter + scrollbar thumb -->
      <Color x:Key="GutterColor">#4A4470</Color>
      <!-- Fluent reads these two as Colors, not brushes, so they can't be aliased
           dynamically — every theme states its own. -->
      <Color x:Key="ScrollBarThumbBackgroundColor">#4A4470</Color>
      <Color x:Key="SystemAccentColor">#B06CF0</Color>
      <Color x:Key="ShadowColor">#66120C2E</Color>
    </ResourceDictionary>

    <!-- ================= LIGHT (Multitudal neutrals) ================= -->
    <ResourceDictionary x:Key="Light">
      <!-- app canvas -->
      <Color x:Key="BgColor">#F5F5FA</Color>
      <!-- raised surface -->
      <Color x:Key="PanelColor">#FFFFFF</Color>
      <!-- sunken/secondary surface -->
      <Color x:Key="PanelAltColor">#ECECF4</Color>
      <!-- code + logs -->
      <Color x:Key="CodeBgColor">#F5F5FA</Color>
      <!-- dialog scrim -->
      <Color x:Key="ScrimColor">#8C120C2E</Color>
      <!-- hairline -->
      <Color x:Key="LineColor">#DEDEEB</Color>
      <!-- stronger hairline -->
      <Color x:Key="LineStrongColor">#C6C6DA</Color>
      <!-- primary ink -->
      <Color x:Key="FgColor">#1D1546</Color>
      <!-- secondary ink -->
      <Color x:Key="FgDimColor">#4E4E68</Color>
      <!-- tertiary ink -->
      <Color x:Key="FgFaintColor">#7C7C9C</Color>
      <!-- ink on an accent fill -->
      <Color x:Key="FgOnAccentColor">#FFFFFF</Color>
      <!-- selection + brand -->
      <Color x:Key="AccentColor">#4F46E5</Color>
      <!-- accent, legible as text -->
      <Color x:Key="AccentTextColor">#4338CA</Color>
      <!-- accent tint (hover) -->
      <Color x:Key="AccentSoftColor">#EFEFFE</Color>
      <!-- accent tint (pressed/selected) -->
      <Color x:Key="AccentEdgeColor">#C4C4FB</Color>
      <!-- mint -->
      <Color x:Key="GoodColor">#12B886</Color>
      <Color x:Key="GoodSoftColor">#DCFBEF</Color>
      <!-- amber -->
      <Color x:Key="WarnColor">#B37209</Color>
      <Color x:Key="WarnSoftColor">#FEF3D6</Color>
      <!-- pink -->
      <Color x:Key="DangerColor">#F0356F</Color>
      <Color x:Key="DangerSoftColor">#FEE0EA</Color>
      <!-- sky -->
      <Color x:Key="InfoColor">#0EA5E9</Color>
      <Color x:Key="InfoSoftColor">#DFF4FE</Color>
      <!-- chat -->
      <Color x:Key="UserBubbleColor">#EFEFFE</Color>
      <!-- diff -->
      <Color x:Key="DiffAddBgColor">#DCFBEF</Color>
      <Color x:Key="DiffAddFgColor">#0B7A5A</Color>
      <Color x:Key="DiffDelBgColor">#FEE0EA</Color>
      <Color x:Key="DiffDelFgColor">#B01B4C</Color>
      <Color x:Key="HunkBgColor">#DFF4FE</Color>
      <Color x:Key="HunkFgColor">#0B6E96</Color>
      <!-- diff gutter + scrollbar thumb -->
      <Color x:Key="GutterColor">#A9A9C6</Color>
      <!-- Fluent reads these two as Colors, not brushes, so they can't be aliased
           dynamically — every theme states its own. -->
      <Color x:Key="ScrollBarThumbBackgroundColor">#C6C6DA</Color>
      <Color x:Key="SystemAccentColor">#4F46E5</Color>
      <Color x:Key="ShadowColor">#1F1D1546</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ================= roles: the names views actually bind =================
       One brush per role, tracking its colour dynamically so a theme swap repaints live. -->
  <SolidColorBrush x:Key="Bg" Color="{DynamicResource BgColor}" />
  <SolidColorBrush x:Key="Panel" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="PanelAlt" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="CodeBg" Color="{DynamicResource CodeBgColor}" />
  <SolidColorBrush x:Key="Scrim" Color="{DynamicResource ScrimColor}" />
  <SolidColorBrush x:Key="Line" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="LineStrong" Color="{DynamicResource LineStrongColor}" />
  <SolidColorBrush x:Key="Fg" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="FgDim" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="FgFaint" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="FgOnAccent" Color="{DynamicResource FgOnAccentColor}" />
  <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentText" Color="{DynamicResource AccentTextColor}" />
  <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentEdge" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="Good" Color="{DynamicResource GoodColor}" />
  <SolidColorBrush x:Key="GoodSoft" Color="{DynamicResource GoodSoftColor}" />
  <SolidColorBrush x:Key="Warn" Color="{DynamicResource WarnColor}" />
  <SolidColorBrush x:Key="WarnSoft" Color="{DynamicResource WarnSoftColor}" />
  <SolidColorBrush x:Key="Danger" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoft" Color="{DynamicResource DangerSoftColor}" />
  <SolidColorBrush x:Key="Info" Color="{DynamicResource InfoColor}" />
  <SolidColorBrush x:Key="InfoSoft" Color="{DynamicResource InfoSoftColor}" />
  <SolidColorBrush x:Key="UserBubble" Color="{DynamicResource UserBubbleColor}" />
  <SolidColorBrush x:Key="DiffAddBg" Color="{DynamicResource DiffAddBgColor}" />
  <SolidColorBrush x:Key="DiffAddFg" Color="{DynamicResource DiffAddFgColor}" />
  <SolidColorBrush x:Key="DiffDelBg" Color="{DynamicResource DiffDelBgColor}" />
  <SolidColorBrush x:Key="DiffDelFg" Color="{DynamicResource DiffDelFgColor}" />
  <SolidColorBrush x:Key="HunkBg" Color="{DynamicResource HunkBgColor}" />
  <SolidColorBrush x:Key="HunkFg" Color="{DynamicResource HunkFgColor}" />
  <SolidColorBrush x:Key="Gutter" Color="{DynamicResource GutterColor}" />

  <!-- ================= status hues =================
       One meaning per hue, so a colour reads the same everywhere in the app:
       sky = in motion · amber = blocked on you · mint = done/healthy · pink = failed/destructive.
       Violet stays reserved for selection and brand, which is why it isn't in this list. The Agnes
       kit paints a running tool amber; here "blocked on you" gets sole claim on amber instead,
       because on a many-session client that's the one state worth interrupting for. -->
  <SolidColorBrush x:Key="StatusWorking" Color="{DynamicResource InfoColor}" />
  <SolidColorBrush x:Key="StatusWorkingSoft" Color="{DynamicResource InfoSoftColor}" />
  <SolidColorBrush x:Key="StatusAttention" Color="{DynamicResource WarnColor}" />
  <SolidColorBrush x:Key="StatusAttentionSoft" Color="{DynamicResource WarnSoftColor}" />
  <SolidColorBrush x:Key="StatusDone" Color="{DynamicResource GoodColor}" />
  <SolidColorBrush x:Key="StatusDoneSoft" Color="{DynamicResource GoodSoftColor}" />
  <SolidColorBrush x:Key="StatusError" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="StatusErrorSoft" Color="{DynamicResource DangerSoftColor}" />
  <SolidColorBrush x:Key="StatusIdle" Color="{DynamicResource FgFaintColor}" />

  <!-- ================= Dock's chrome =================
       Dock ships Visual Studio blue and aliases its own leaf keys with `StaticResource`, so these are
       the keys its templates actually read at runtime. Dock has a preset mechanism of its own
       (DockFluentThemeManager) — this is effectively our preset, expressed in our roles. -->
  <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="{DynamicResource AccentTextColor}" />
  <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="DockTabForegroundBrush" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="{DynamicResource AccentTextColor}" />
  <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="{DynamicResource AccentTextColor}" />
  <SolidColorBrush x:Key="DockDocumentTabPointerOverForegroundBrush" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="DockDocumentTabClosePointerOverForegroundBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="{DynamicResource DangerSoftColor}" />
  <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="{DynamicResource BgColor}" />
  <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="DockThemeAccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="DockBorderStrongBrush" Color="{DynamicResource LineStrongColor}" />
  <SolidColorBrush x:Key="DockSeparatorBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="DockSplitterDragBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="{DynamicResource DangerSoftColor}" />
  <SolidColorBrush x:Key="DockChromeGripBrush" Color="{DynamicResource FgFaintColor}" />

  <!-- ================= Fluent's chrome =================
       Fluent aliases its own control colours with `StaticResource` internally, so these leaf keys —
       the ones its templates actually read — are what a theme has to move. Declared ONCE here over
       the role colours, so every theme gets them, including the ported ones.

       `FluentTheme.Palettes` in App.axaml is the tidier hook and does reach these same controls, but
       it throws on anything that isn't Light or Dark ("FluentTheme.Palettes only supports Light and
       Dark variants"), so it cannot serve a custom theme. It stays for the two built-ins, where it
       also covers stock controls this list never names (ToggleSwitch, Slider, the date pickers); this
       bridge covers the controls the app actually uses, under every theme. -->
  <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource AccentTextColor}" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource LineStrongColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource LineStrongColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="TextControlButtonForeground" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource LineStrongColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource AccentTextColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource LineStrongColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource FgOnAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource FgOnAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{DynamicResource AccentEdgeColor}" />
  <SolidColorBrush x:Key="TreeViewItemForeground" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundDisabled" Color="{DynamicResource FgFaintColor}" />
  <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="{DynamicResource FgColor}" />
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ExpanderContentBackground" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="ExpanderChevronForeground" Color="{DynamicResource FgDimColor}" />
  <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="{DynamicResource LineColor}" />

  <!-- ================= the Agnes signature gradient =================
       violet → magenta → coral. The brand interpolates in OKLCH to keep mid-tones vivid; Avalonia
       interpolates in sRGB, so the midpoints are placed explicitly at the OKLCH-correct colours
       rather than letting a two-stop ramp mix through a muddy centre. This is brand, not palette: it
       stays the Agnes gradient whichever theme is active. -->
  <LinearGradientBrush x:Key="GradAgnes" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#5940D6" Offset="0.0" />
    <GradientStop Color="#8A55EE" Offset="0.28" />
    <GradientStop Color="#C858C8" Offset="0.58" />
    <GradientStop Color="#E86D9A" Offset="0.8" />
    <GradientStop Color="#FF8A66" Offset="1.0" />
  </LinearGradientBrush>

  <!-- Horizontal variant, for edges, CTA fills and progress. -->
  <LinearGradientBrush x:Key="GradAgnesH" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Color="#5940D6" Offset="0.0" />
    <GradientStop Color="#8A55EE" Offset="0.28" />
    <GradientStop Color="#C858C8" Offset="0.58" />
    <GradientStop Color="#E86D9A" Offset="0.8" />
    <GradientStop Color="#FF8A66" Offset="1.0" />
  </LinearGradientBrush>

  <!-- ================= geometry (4px grid; brand radii) ================= -->
  <CornerRadius x:Key="RadiusXs">5</CornerRadius>
  <CornerRadius x:Key="RadiusSm">8</CornerRadius>
  <CornerRadius x:Key="RadiusMd">12</CornerRadius>
  <CornerRadius x:Key="RadiusLg">16</CornerRadius>
  <CornerRadius x:Key="RadiusXl">22</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Fluent's own defaults are 3/5; the brand's controls are 8 and its overlays 12. -->
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

  <!-- Dock ships square tabs; round the top corners so the strip matches the brand's geometry. -->
  <CornerRadius x:Key="DockDocumentTabItemCornerRadius">8,8,0,0</CornerRadius>
  <CornerRadius x:Key="DockDocumentTabCreateButtonCornerRadius">8,8,0,0</CornerRadius>

  <!-- ================= type ================= -->
  <!-- Display = Space Grotesk, UI/body = Manrope, code/logs = JetBrains Mono. All three are the
       brand's declared Google-Font substitutes for the (unprovided) real wordmark font, embedded so
       the app reads the same on a bare Linux box as on a Mac. -->
  <FontFamily x:Key="DisplayFont">avares://Agnes.App.Desktop/Assets/Fonts#Space Grotesk</FontFamily>
  <FontFamily x:Key="UiFont">avares://Agnes.App.Desktop/Assets/Fonts#Manrope</FontFamily>
  <FontFamily x:Key="MonoFont">avares://Agnes.App.Desktop/Assets/Fonts#JetBrains Mono</FontFamily>

  <!-- Stock controls pick their font/size up from these two. 13px, not the brand's 15px reading
       size: this is a dense multi-pane desktop tool, and its own views are set at 11–13. -->
  <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="UiFont" />
  <sys:Double x:Key="ControlContentThemeFontSize">13</sys:Double>

  <sys:Double x:Key="Text2Xs">11</sys:Double>
  <sys:Double x:Key="TextXs">12</sys:Double>
  <sys:Double x:Key="TextSm">13</sys:Double>
  <sys:Double x:Key="TextMd">15</sys:Double>
  <sys:Double x:Key="TextLg">17</sys:Double>
  <sys:Double x:Key="TextXl">20</sys:Double>
  <sys:Double x:Key="Text2Xl">24</sys:Double>

  <!-- Display type is tracked tight, per the brand's −0.02/−0.03em. -->
  <sys:Double x:Key="TrackingTight">-0.4</sys:Double>
</ResourceDictionary>
