  </ResourceDictionary.ThemeDictionaries>

  <!-- ================= the Agnes signature gradient =================
       violet → magenta → coral. The brand interpolates in OKLCH to keep mid-tones vivid; Avalonia
       interpolates in sRGB, so the midpoints are placed explicitly at the OKLCH-correct colours
       rather than letting a two-stop ramp mix through a muddy centre. -->
  <LinearGradientBrush x:Key="GradAgnes" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#5940D6" Offset="0.0" />
    <GradientStop Color="#8A55EE" Offset="0.28" />
    <GradientStop Color="#C858C8" Offset="0.58" />
    <GradientStop Color="#E86D9A" Offset="0.8" />
    <GradientStop Color="#FF8A66" Offset="1.0" />
  </LinearGradientBrush>

  <!-- Horizontal variant, for edges, CTA fills and progress. -->
  <LinearGradientBrush x:Key="GradAgnesH" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Color="#5940D6" Offset="0.0" />
    <GradientStop Color="#8A55EE" Offset="0.28" />
    <GradientStop Color="#C858C8" Offset="0.58" />
    <GradientStop Color="#E86D9A" Offset="0.8" />
    <GradientStop Color="#FF8A66" Offset="1.0" />
  </LinearGradientBrush>

  <!-- ================= geometry (4px grid; brand radii) ================= -->
  <CornerRadius x:Key="RadiusXs">5</CornerRadius>
  <CornerRadius x:Key="RadiusSm">8</CornerRadius>
  <CornerRadius x:Key="RadiusMd">12</CornerRadius>
  <CornerRadius x:Key="RadiusLg">16</CornerRadius>
  <CornerRadius x:Key="RadiusXl">22</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Fluent's own defaults are 3/5; the brand's controls are 8 and its overlays 12. -->
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

  <!-- Dock ships square tabs; round the top corners so the strip matches the brand's geometry. -->
  <CornerRadius x:Key="DockDocumentTabItemCornerRadius">8,8,0,0</CornerRadius>
  <CornerRadius x:Key="DockDocumentTabCreateButtonCornerRadius">8,8,0,0</CornerRadius>

  <!-- ================= type ================= -->
  <!-- Display = Space Grotesk, UI/body = Manrope, code/logs = JetBrains Mono. All three are the
       brand's declared Google-Font substitutes for the (unprovided) real wordmark font, embedded so
       the app reads the same on a bare Linux box as on a Mac. -->
  <FontFamily x:Key="DisplayFont">avares://Agnes.App.Desktop/Assets/Fonts#Space Grotesk</FontFamily>
  <FontFamily x:Key="UiFont">avares://Agnes.App.Desktop/Assets/Fonts#Manrope</FontFamily>
  <FontFamily x:Key="MonoFont">avares://Agnes.App.Desktop/Assets/Fonts#JetBrains Mono</FontFamily>

  <!-- Stock controls pick their font/size up from these two. 13px, not the brand's 15px reading
       size: this is a dense multi-pane desktop tool, and its own views are set at 11–13. -->
  <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="UiFont" />
  <sys:Double x:Key="ControlContentThemeFontSize">13</sys:Double>

  <sys:Double x:Key="Text2Xs">11</sys:Double>
  <sys:Double x:Key="TextXs">12</sys:Double>
  <sys:Double x:Key="TextSm">13</sys:Double>
  <sys:Double x:Key="TextMd">15</sys:Double>
  <sys:Double x:Key="TextLg">17</sys:Double>
  <sys:Double x:Key="TextXl">20</sys:Double>
  <sys:Double x:Key="Text2Xl">24</sys:Double>

  <!-- Display type is tracked tight, per the brand's −0.02/−0.03em. -->
  <sys:Double x:Key="TrackingTight">-0.4</sys:Double>
</ResourceDictionary>
