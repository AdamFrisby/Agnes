      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="Accent" />
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="Accent" />
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="FgOnAccent" />
