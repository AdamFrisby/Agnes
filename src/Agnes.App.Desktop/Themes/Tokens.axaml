<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <!--
    Multitudal design tokens, as consumed by the Agnes desktop client.

    Source of truth is the brand bundle's `tokens/*.css`; this file is its Avalonia translation, and is
    the twin of `Agnes.App.Mobile/Themes/Tokens.axaml` — same palette, same gradient, different key
    names (the desktop head's existing vocabulary: Panel/Fg/Line rather than Surface/Text/Border).
    Two variants:
      · Dark  — the Agnes console palette from `ui_kits/agnes` (#0F0A22 / #16112E / #1C1740, accent
                #B06CF0). The kit itself is authored dark and it's where the app is used most.
      · Light — the shared Multitudal neutrals (cool, faintly violet; never neutral grey, never warm)
                on near-white surfaces, ink #1D1546, accent indigo-600.

    Colour roles, not colour names: a view asks for `PanelAlt` or `Danger`, never a hex literal.
    The Agnes gradient (violet → magenta → coral) is the one signature flourish and is used at most
    once per view — the brand mark, a hero CTA, an active accent edge.

    Section 2 of each variant re-points Fluent's own control resources at these roles, so stock
    controls (TextBox, ComboBox, menus, scrollbars) are brand-coloured too rather than sitting there
    in default grey-and-blue. Fluent aliases its neutral chrome with `StaticResource` internally, so
    overriding its base palette wouldn't reach the controls — the control-level keys are what they
    read at runtime, and what we override here.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <!-- ============================ DARK (Agnes console) ============================ -->
    <ResourceDictionary x:Key="Dark">

      <!-- 1. roles -->
      <SolidColorBrush x:Key="Bg" Color="#0F0A22" />
      <SolidColorBrush x:Key="Panel" Color="#16112E" />
      <SolidColorBrush x:Key="PanelAlt" Color="#1C1740" />
      <SolidColorBrush x:Key="CodeBg" Color="#120C2E" />
      <SolidColorBrush x:Key="Scrim" Color="#8C120C2E" />
      <SolidColorBrush x:Key="Line" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="LineStrong" Color="#33FFFFFF" />

      <SolidColorBrush x:Key="Fg" Color="#E6E3F7" />
      <SolidColorBrush x:Key="FgDim" Color="#9C97C4" />
      <SolidColorBrush x:Key="FgFaint" Color="#6B6796" />
      <SolidColorBrush x:Key="FgOnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Accent" Color="#B06CF0" />
      <SolidColorBrush x:Key="AccentText" Color="#D9B8FF" />
      <SolidColorBrush x:Key="AccentSoft" Color="#2EB06CF0" />
      <SolidColorBrush x:Key="AccentEdge" Color="#4DB06CF0" />

      <SolidColorBrush x:Key="Good" Color="#3ADBB4" />
      <SolidColorBrush x:Key="GoodSoft" Color="#243ADBB4" />
      <SolidColorBrush x:Key="Warn" Color="#FFC53D" />
      <SolidColorBrush x:Key="WarnSoft" Color="#26FFC53D" />
      <SolidColorBrush x:Key="Danger" Color="#FF7BA5" />
      <SolidColorBrush x:Key="DangerSoft" Color="#26F0356F" />
      <SolidColorBrush x:Key="Info" Color="#38BDF8" />
      <SolidColorBrush x:Key="InfoSoft" Color="#2438BDF8" />

      <!-- chat -->
      <SolidColorBrush x:Key="UserBubble" Color="#241E4E" />

      <!-- diff / code -->
      <SolidColorBrush x:Key="DiffAddBg" Color="#1A3ADBB4" />
      <SolidColorBrush x:Key="DiffAddFg" Color="#6FEBC5" />
      <SolidColorBrush x:Key="DiffDelBg" Color="#1FF0356F" />
      <SolidColorBrush x:Key="DiffDelFg" Color="#FF9BBB" />
      <SolidColorBrush x:Key="HunkBg" Color="#2038BDF8" />
      <SolidColorBrush x:Key="HunkFg" Color="#86D3F7" />
      <SolidColorBrush x:Key="Gutter" Color="#4A4470" />

      <!-- Elevation: cool violet, never black. -->
      <Color x:Key="ShadowColor">#66120C2E</Color>

      <!-- 2. Fluent’s stock chrome, re-pointed at the roles above -->
      <!-- Accent-derived controls (selection, checkmarks, progress, focus) read these colours
           dynamically, so the whole accent family follows from the seven below. -->
      <Color x:Key="SystemAccentColor">#B06CF0</Color>
      <Color x:Key="SystemAccentColorLight1">#BE85F3</Color>
      <Color x:Key="SystemAccentColorLight2">#CC9DF6</Color>
      <Color x:Key="SystemAccentColorLight3">#DAB6F9</Color>
      <Color x:Key="SystemAccentColorDark1">#9C55DB</Color>
      <Color x:Key="SystemAccentColorDark2">#8442C2</Color>
      <Color x:Key="SystemAccentColorDark3">#6B32A3</Color>

      <!-- List rows (ListBox/ComboBox items) read these two for their neutral hover/press fills. -->
      <StaticResource x:Key="SystemControlHighlightListLowBrush" ResourceKey="AccentSoft" />
      <StaticResource x:Key="SystemControlHighlightListMediumBrush" ResourceKey="AccentEdge" />
      <StaticResource x:Key="SystemControlHighlightAltBaseHighBrush" ResourceKey="Fg" />

      <StaticResource x:Key="ButtonBackground" ResourceKey="PanelAlt" />
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentEdge" />
      <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="Line" />
      <StaticResource x:Key="ButtonForeground" ResourceKey="Fg" />
      <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentText" />
      <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="ButtonBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="LineStrong" />
      <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentEdge" />
      <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="Line" />

      <StaticResource x:Key="TextControlBackground" ResourceKey="PanelAlt" />
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="PanelAlt" />
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Panel" />
      <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="PanelAlt" />
      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="LineStrong" />
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="Accent" />
      <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="Line" />
      <StaticResource x:Key="TextControlForeground" ResourceKey="Fg" />
      <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="Fg" />
      <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FgFaint" />
      <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="FgFaint" />
      <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="FgFaint" />
      <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="AccentEdge" />
      <StaticResource x:Key="TextControlButtonForeground" ResourceKey="FgDim" />
      <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="AccentEdge" />

      <StaticResource x:Key="ComboBoxBackground" ResourceKey="PanelAlt" />
      <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="PanelAlt" />
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="AccentEdge" />
      <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="PanelAlt" />
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="LineStrong" />
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="Accent" />
      <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="Line" />
      <StaticResource x:Key="ComboBoxForeground" ResourceKey="Fg" />
      <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="Fg" />
      <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="Fg" />
      <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="FgFaint" />
      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="Panel" />
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="FgDim" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="Fg" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="Fg" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="Fg" />
      <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="AccentText" />
      <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="AccentEdge" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="AccentSoft" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentEdge" />

      <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="PanelAlt" />
      <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="LineStrong" />
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="Accent" />
      <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="Accent" />
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="Accent" />
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="Accent" />
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="FgOnAccent" />
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="FgOnAccent" />
      <StaticResource x:Key="CheckBoxForegroundUnchecked" ResourceKey="Fg" />
      <StaticResource x:Key="CheckBoxForegroundUncheckedPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="Fg" />
      <StaticResource x:Key="CheckBoxForegroundCheckedPointerOver" ResourceKey="Fg" />

      <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="Panel" />
      <StaticResource x:Key="FlyoutBorderThemeBrush" ResourceKey="Line" />
      <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="Panel" />
      <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="AccentEdge" />
      <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="Fg" />
      <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="Fg" />
      <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="FgFaint" />

      <StaticResource x:Key="ToolTipBackground" ResourceKey="Panel" />
      <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="ToolTipForeground" ResourceKey="Fg" />

      <Color x:Key="ScrollBarThumbBackgroundColor">#4A4470</Color>
      <StaticResource x:Key="ScrollBarThumbFillPointerOver" ResourceKey="FgFaint" />
      <StaticResource x:Key="ScrollBarThumbFillPressed" ResourceKey="FgDim" />
      <StaticResource x:Key="ScrollBarThumbFillDisabled" ResourceKey="Line" />
      <StaticResource x:Key="ScrollBarBackgroundPointerOver" ResourceKey="Panel" />
      <StaticResource x:Key="ScrollBarTrackFillPointerOver" ResourceKey="PanelAlt" />
      <StaticResource x:Key="ScrollBarTrackStrokePointerOver" ResourceKey="Line" />
      <StaticResource x:Key="ScrollBarButtonBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="ScrollBarButtonBackgroundPressed" ResourceKey="AccentEdge" />
      <StaticResource x:Key="ScrollBarButtonArrowForeground" ResourceKey="FgDim" />
      <StaticResource x:Key="ScrollBarButtonArrowForegroundPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="ScrollBarButtonArrowForegroundPressed" ResourceKey="Fg" />
      <StaticResource x:Key="ScrollBarButtonArrowForegroundDisabled" ResourceKey="FgFaint" />

      <StaticResource x:Key="TreeViewItemBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="AccentSoft" />
      <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="AccentEdge" />
      <StaticResource x:Key="TreeViewItemForeground" ResourceKey="Fg" />
      <StaticResource x:Key="TreeViewItemForegroundPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="TreeViewItemForegroundSelected" ResourceKey="Fg" />
      <StaticResource x:Key="TreeViewItemForegroundSelectedPointerOver" ResourceKey="Fg" />

      <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="Panel" />
      <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="TabItemHeaderForegroundSelected" ResourceKey="Fg" />
      <StaticResource x:Key="TabItemHeaderForegroundUnselected" ResourceKey="FgDim" />
      <StaticResource x:Key="TabItemHeaderForegroundUnselectedPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="TabItemHeaderForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="TabItemHeaderSelectedPipeFill" ResourceKey="Accent" />

      <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="PanelAlt" />
      <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="ExpanderHeaderForeground" ResourceKey="Fg" />
      <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="ExpanderContentBackground" ResourceKey="Panel" />
      <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="ExpanderChevronForeground" ResourceKey="FgDim" />
      <StaticResource x:Key="ExpanderChevronBorderBrush" ResourceKey="Line" />

      <!-- Dock's tab strip is the app's most prominent chrome (it carries the toolbar too), and it
           ships Visual Studio blue. Same rule as Fluent: its templates read the leaf keys below
           dynamically, so those are what we re-point rather than its accent trio. -->
      <StaticResource x:Key="DockDocumentTabStripBackgroundBrush" ResourceKey="Panel" />
      <StaticResource x:Key="DockTabActiveBackgroundBrush" ResourceKey="AccentSoft" />
      <StaticResource x:Key="DockTabActiveForegroundBrush" ResourceKey="AccentText" />
      <StaticResource x:Key="DockTabHoverBackgroundBrush" ResourceKey="PanelAlt" />
      <StaticResource x:Key="DockTabActiveIndicatorBrush" ResourceKey="Accent" />
      <StaticResource x:Key="DockTabForegroundBrush" ResourceKey="FgDim" />
      <StaticResource x:Key="DockTabSelectedForegroundBrush" ResourceKey="AccentText" />
      <StaticResource x:Key="DockSurfaceHeaderBrush" ResourceKey="PanelAlt" />
      <StaticResource x:Key="DockSurfaceHeaderActiveBrush" ResourceKey="Accent" />
      <StaticResource x:Key="DockDocumentTabSelectedForegroundBrush" ResourceKey="AccentText" />
      <StaticResource x:Key="DockDocumentTabPointerOverForegroundBrush" ResourceKey="Fg" />
      <StaticResource x:Key="DockDocumentTabCloseSelectedForegroundBrush" ResourceKey="FgDim" />
      <StaticResource x:Key="DockDocumentTabClosePointerOverForegroundBrush" ResourceKey="Danger" />
      <StaticResource x:Key="DockTabCloseHoverBackgroundBrush" ResourceKey="DangerSoft" />
      <StaticResource x:Key="DockThemeBackgroundBrush" ResourceKey="Panel" />
      <StaticResource x:Key="DockThemeControlBackgroundBrush" ResourceKey="Bg" />
      <StaticResource x:Key="DockThemeForegroundBrush" ResourceKey="Fg" />
      <StaticResource x:Key="DockThemeBorderLowBrush" ResourceKey="Line" />
      <StaticResource x:Key="DockThemeAccentBrush" ResourceKey="Accent" />
      <StaticResource x:Key="DockBorderSubtleBrush" ResourceKey="Line" />
      <StaticResource x:Key="DockBorderStrongBrush" ResourceKey="LineStrong" />
      <StaticResource x:Key="DockSeparatorBrush" ResourceKey="Line" />
      <StaticResource x:Key="DockSplitterIdleBrush" ResourceKey="Line" />
      <StaticResource x:Key="DockSplitterHoverBrush" ResourceKey="AccentEdge" />
      <StaticResource x:Key="DockSplitterDragBrush" ResourceKey="Accent" />
      <StaticResource x:Key="DockTargetIndicatorBrush" ResourceKey="Accent" />
      <StaticResource x:Key="DockChromeButtonForegroundBrush" ResourceKey="FgDim" />
      <StaticResource x:Key="DockChromeButtonHoverBackgroundBrush" ResourceKey="AccentSoft" />
      <StaticResource x:Key="DockChromeButtonPressedBackgroundBrush" ResourceKey="AccentEdge" />
      <StaticResource x:Key="DockChromeButtonDangerHoverBrush" ResourceKey="DangerSoft" />
      <StaticResource x:Key="DockChromeGripBrush" ResourceKey="FgFaint" />
    </ResourceDictionary>

    <!-- ============================ LIGHT (Multitudal neutrals) ============================ -->
    <ResourceDictionary x:Key="Light">

      <!-- 1. roles -->
      <SolidColorBrush x:Key="Bg" Color="#F5F5FA" />
      <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PanelAlt" Color="#ECECF4" />
      <SolidColorBrush x:Key="CodeBg" Color="#F5F5FA" />
      <SolidColorBrush x:Key="Scrim" Color="#8C120C2E" />
      <SolidColorBrush x:Key="Line" Color="#DEDEEB" />
      <SolidColorBrush x:Key="LineStrong" Color="#C6C6DA" />

      <SolidColorBrush x:Key="Fg" Color="#1D1546" />
      <SolidColorBrush x:Key="FgDim" Color="#4E4E68" />
      <SolidColorBrush x:Key="FgFaint" Color="#7C7C9C" />
      <SolidColorBrush x:Key="FgOnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Accent" Color="#4F46E5" />
      <SolidColorBrush x:Key="AccentText" Color="#4338CA" />
      <SolidColorBrush x:Key="AccentSoft" Color="#EFEFFE" />
      <SolidColorBrush x:Key="AccentEdge" Color="#C4C4FB" />

      <SolidColorBrush x:Key="Good" Color="#12B886" />
      <SolidColorBrush x:Key="GoodSoft" Color="#DCFBEF" />
      <SolidColorBrush x:Key="Warn" Color="#B37209" />
      <SolidColorBrush x:Key="WarnSoft" Color="#FEF3D6" />
      <SolidColorBrush x:Key="Danger" Color="#F0356F" />
      <SolidColorBrush x:Key="DangerSoft" Color="#FEE0EA" />
      <SolidColorBrush x:Key="Info" Color="#0EA5E9" />
      <SolidColorBrush x:Key="InfoSoft" Color="#DFF4FE" />

      <SolidColorBrush x:Key="UserBubble" Color="#EFEFFE" />

      <SolidColorBrush x:Key="DiffAddBg" Color="#DCFBEF" />
      <SolidColorBrush x:Key="DiffAddFg" Color="#0B7A5A" />
      <SolidColorBrush x:Key="DiffDelBg" Color="#FEE0EA" />
      <SolidColorBrush x:Key="DiffDelFg" Color="#B01B4C" />
      <SolidColorBrush x:Key="HunkBg" Color="#DFF4FE" />
      <SolidColorBrush x:Key="HunkFg" Color="#0B6E96" />
      <SolidColorBrush x:Key="Gutter" Color="#A9A9C6" />

      <Color x:Key="ShadowColor">#1F1D1546</Color>

      <!-- 2. Fluent’s stock chrome, re-pointed at the roles above -->
      <Color x:Key="SystemAccentColor">#4F46E5</Color>
      <Color x:Key="SystemAccentColorLight1">#6E67EA</Color>
      <Color x:Key="SystemAccentColorLight2">#8D87EF</Color>
      <Color x:Key="SystemAccentColorLight3">#ACA8F4</Color>
      <Color x:Key="SystemAccentColorDark1">#4338CA</Color>
      <Color x:Key="SystemAccentColorDark2">#3730A3</Color>
      <Color x:Key="SystemAccentColorDark3">#2E2A73</Color>

      <StaticResource x:Key="SystemControlHighlightListLowBrush" ResourceKey="AccentSoft" />
      <StaticResource x:Key="SystemControlHighlightListMediumBrush" ResourceKey="AccentEdge" />
      <StaticResource x:Key="SystemControlHighlightAltBaseHighBrush" ResourceKey="Fg" />

      <StaticResource x:Key="ButtonBackground" ResourceKey="Panel" />
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentSoft" />
      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentEdge" />
      <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="PanelAlt" />
      <StaticResource x:Key="ButtonForeground" ResourceKey="Fg" />
      <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentText" />
      <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="ButtonBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="LineStrong" />
      <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentEdge" />
      <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="Line" />

      <StaticResource x:Key="TextControlBackground" ResourceKey="Panel" />
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Panel" />
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Panel" />
      <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="PanelAlt" />
      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Line" />
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="LineStrong" />
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="Accent" />
      <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="Line" />
      <StaticResource x:Key="TextControlForeground" ResourceKey="Fg" />
      <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="Fg" />
      <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="Fg" />
      <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="FgFaint" />
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FgFaint" />
      <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="FgFaint" />
