<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit">
  <!-- Loaded only by InlineMarkdown, i.e. the rendered body of an explicit ```markdown / ```md
       fence. This is the sole context where a code fence receives a second-level fill. -->
  <Style Selector="Border.CodeBlock">
    <Setter Property="Background" Value="{DynamicResource CodeBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="Border.CodeBlock ae|TextEditor">
    <Setter Property="Background" Value="{DynamicResource CodeBg}" />
  </Style>
</Styles>
