<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:icx="using:FluentIcons.Avalonia.Markup"
        xmlns:dc="using:Dock.Avalonia.Controls"
        x:Class="Agnes.App.Desktop.MainWindow"
        Title="{Binding WindowTitle}" Width="1180" Height="760"
        MinWidth="720" MinHeight="480"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        Icon="avares://Agnes.App.Desktop/Assets/Brand/Agnes.png">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PrevTabCommand}" />
        <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding PrevTabCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="4" />
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="5" />
        <KeyBinding Gesture="Ctrl+D6" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Ctrl+D7" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="7" />
        <KeyBinding Gesture="Ctrl+D8" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="8" />
        <KeyBinding Gesture="Ctrl+D9" Command="{Binding ActivateTabByIndexCommand}" CommandParameter="9" />
        <KeyBinding Gesture="Ctrl+K" Command="{Binding TogglePaletteCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding OpenDashboardCommand}" />
    </Window.KeyBindings>

    <!-- Native menu — shown in the macOS menu bar (inert on Windows/Linux, where the top bar serves). -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New Tab" Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
                        <NativeMenuItem Header="Close Tab" Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>
        <!-- Segmented selector buttons (e.g. the theme picker). The chrome comes from Button.chip;
             the selected segment fills with the accent. -->
        <Style Selector="Button.seg">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.seg.on">
            <Setter Property="Foreground" Value="{DynamicResource FgOnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.seg.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource FgOnAccent}" />
        </Style>
    </Window.Styles>

    <!-- Whole-UI zoom (accessibility / density) via a layout transform. The scaled tree is wrapped in a
         ScrollViewer so that when a large scale on a small window pushes content past the viewport, it can
         be scrolled to rather than being silently clipped. ScaleRoot's size is pinned to (client / scale)
         with a floor in code-behind (see MainWindow.axaml.cs), so content fills the window when it fits and
         scrolls when it doesn't. -->
    <!-- Scrollbars stay Disabled at 100% (content is pinned to fit exactly) and only switch to Auto when
         zoomed past 100%, so a child BringIntoView can never scroll the whole app at normal scale. -->
    <ScrollViewer x:Name="ScaleScroller"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
    <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding FontScale}" ScaleY="{Binding FontScale}" />
        </LayoutTransformControl.LayoutTransform>
    <Grid x:Name="ScaleRoot" RowDefinitions="Auto,Auto,*">

        <!-- Top bar (fallback): LeftBar/RightBar are relocated into the Dock tab strip at runtime and this
             whole row is collapsed once that succeeds (see MainWindow.axaml.cs). -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" x:Name="LeftBar" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Brand lockup: the Agnes gradient tile and the wordmark in the display face. This
                         is the one place the gradient appears in the chrome. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource GradAgnes}" VerticalAlignment="Center" />
                        <TextBlock Text="Agnes" Classes="display" FontSize="15" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" x:Name="RightBar" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Search across all open sessions. Lives at the left edge of the right-hand group,
                         where the other whole-app controls are; the left group is the brand alone. -->
                    <Button Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            AutomationProperties.Name="Search across sessions">
                    <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="10,5" Width="240">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Search" Foreground="{DynamicResource FgFaint}" FontSize="15" />
                            <TextBlock Text="Search across all sessions…" Foreground="{DynamicResource FgFaint}" FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="420" Spacing="8">
                                <!-- Auto-focus the real search box the moment the popover opens, so clicking
                                     the bar and typing is one motion, not two separate inputs (defect #9). -->
                                <TextBox Text="{Binding GlobalSearchQuery, Mode=TwoWay}" Watermark="Search across all sessions…"
                                         AttachedToVisualTree="OnGlobalSearchAttached"
                                         Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                         BorderBrush="{DynamicResource Line}" CornerRadius="7" Padding="9,5" FontSize="12"
                                         AutomationProperties.Name="Search query across sessions" />
                                <TextBlock Text="No matches" Foreground="{DynamicResource FgFaint}" FontSize="11"
                                           IsVisible="{Binding !HasGlobalResults}" />
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GlobalResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding $parent[ItemsControl].DataContext.SelectGlobalHitCommand}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                                    Padding="7,5" CornerRadius="6" Cursor="Hand">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding SessionTitle}" Foreground="{DynamicResource Fg}"
                                                                   FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Good}" FontSize="10"
                                                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    </Button>

                    <!-- Update available -->
                    <Button Classes="accent" Command="{Binding OpenUpdateCommand}" IsVisible="{Binding UpdateAvailable}" Padding="10,5" FontSize="12"
                            AutomationProperties.Name="Download update"
                            ToolTip.Tip="A newer version of Agnes is available">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="ArrowCircleUp" FontSize="14" />
                            <TextBlock Text="{Binding UpdateVersion, StringFormat='Update {0}'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Approvals: open permission requests across every session that need a human -->
                    <Button Classes="chip" Padding="10,5" FontSize="12"
                            Command="{Binding Approvals.RefreshCommand}"
                            IsVisible="{Binding Approvals.HasApprovals}" AutomationProperties.Name="Approvals needing you">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Alert" FontSize="14" />
                            <TextBlock Text="Approvals" VerticalAlignment="Center" />
                            <Border Classes="status attention" Padding="6,1" MinWidth="18" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Approvals.Count}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MinWidth="360" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Approvals.Approvals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- A session permission jumps (it's answered against its transcript);
                                                 anything else — an external question, a gated action — carries its
                                                 own answers, so no row here is a dead end. -->
                                            <Panel Margin="0,2">
                                                <Button Command="{Binding $parent[ItemsControl].DataContext.Approvals.JumpCommand}"
                                                        CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Background="{DynamicResource PanelAlt}"
                                                        BorderThickness="0" Padding="8,6" CornerRadius="6" Cursor="Hand"
                                                        IsVisible="{Binding !HasChoices}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="Tap to jump to the session" Foreground="{DynamicResource FgDim}" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Border Background="{DynamicResource PanelAlt}" Padding="8,6" CornerRadius="6"
                                                        IsVisible="{Binding HasChoices}">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Source, StringFormat='asked by {0}'}"
                                                                   Foreground="{DynamicResource FgDim}" FontSize="11"
                                                                   IsVisible="{Binding Source, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <ItemsControl ItemsSource="{Binding Choices}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding Label}" Command="{Binding Command}"
                                                                            FontSize="11" Padding="10,3"
                                                                            Classes.primary="{Binding IsPrimary}"
                                                                            Classes.chip="{Binding !IsPrimary}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Inbox: completed background runs -->
                    <Button Classes="chip" Padding="10,5" FontSize="12"
                            IsVisible="{Binding HasInbox}" AutomationProperties.Name="Background run inbox">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="MailInbox" FontSize="14" />
                            <TextBlock Text="Inbox" VerticalAlignment="Center" />
                            <Border Classes="status working" Padding="6,1" MinWidth="18" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InboxCount}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MinWidth="360" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Inbox}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="{DynamicResource PanelAlt}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Automations: scheduled tasks with pause/resume/run-now/delete -->
                    <Button Classes="chip" Padding="10,5" FontSize="12"
                            IsVisible="{Binding HasScheduledTasks}" AutomationProperties.Name="Automations">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Timer" FontSize="14" />
                            <TextBlock Text="Automations" VerticalAlignment="Center" />
                            <Border Classes="status" Padding="6,1" MinWidth="18" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ScheduledTaskCount}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MinWidth="380" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="{DynamicResource PanelAlt}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Prompt}" Foreground="{DynamicResource Fg}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Schedule}" Foreground="{DynamicResource FgDim}" FontSize="11" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Run now" FontSize="11" Padding="8,3"
                                                                Command="{Binding $parent[ItemsControl].DataContext.RunAutomationNowCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Run automation now" />
                                                        <Button Content="Pause" FontSize="11" Padding="8,3" IsVisible="{Binding Enabled}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.PauseAutomationCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Pause automation" />
                                                        <Button Content="Resume" FontSize="11" Padding="8,3" IsVisible="{Binding Paused}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.ResumeAutomationCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Resume automation" />
                                                        <Button Content="Delete" FontSize="11" Padding="8,3"
                                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveAutomationCommand}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="Delete automation" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Sessions switcher: state of every open session + attention -->
                    <Button Classes="chip" Padding="10,5" FontSize="12" AutomationProperties.Name="Sessions">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Sessions" VerticalAlignment="Center" />
                            <Border Classes="status attention" Padding="6,1" MinWidth="18" VerticalAlignment="Center"
                                    IsVisible="{Binding HasAttention}">
                                <TextBlock Text="{Binding AttentionCount}" FontSize="10"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MinWidth="320" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding OpenSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding $parent[ItemsControl].DataContext.ActivateSessionCommand}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                                    Padding="8,6" CornerRadius="6" Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border Grid.Column="0" Classes="statusdot"
                                                            Classes.working="{Binding IsWorking}" Classes.attention="{Binding IsAwaitingInput}"
                                                            Classes.review="{Binding IsReadyForReview}" Classes.error="{Binding IsFaulted}"
                                                            ToolTip.Tip="{Binding ActivityText}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                                        <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <!-- Unread badge (sessions/05): activity you haven't looked at yet. -->
                                                        <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                                Background="{DynamicResource Accent}" IsVisible="{Binding IsUnread}"
                                                                ToolTip.Tip="Unread" />
                                                        <TextBlock Text="{Binding ActivityText}" Foreground="{DynamicResource FgDim}"
                                                                   FontSize="10" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Dashboard: the optional status-of-everything tab (Ctrl+Shift+D) -->
                    <Button Classes="chip" Content="{icx:SymbolIcon Symbol=Board}" Command="{Binding OpenDashboardCommand}" Padding="10,5" FontSize="12"
                            AutomationProperties.Name="Status dashboard"
                            ToolTip.Tip="Status of every session, and anything waiting on you (Ctrl+Shift+D)" />

                    <!-- Search: opens a first-class tab searching every recorded session's transcript -->
                    <Button Classes="chip" Content="{icx:SymbolIcon Symbol=Search}" Command="{Binding OpenSearchCommand}" Padding="10,5" FontSize="12" AutomationProperties.Name="Search history" />

                    <!-- Settings: opens a first-class, searchable Settings tab -->
                    <Button Classes="chip" Content="{icx:SymbolIcon Symbol=Settings}" Command="{Binding OpenSettingsCommand}" Padding="10,5" FontSize="12" AutomationProperties.Name="Settings" />
                    <Button Classes="chip" Padding="10,5" FontSize="12"
                            IsVisible="{Binding HasArchived}" AutomationProperties.Name="Reopen archived sessions">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Archive" FontSize="14" />
                            <TextBlock Text="Archived" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxWidth="340" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ArchivedSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding $parent[ItemsControl].DataContext.ReopenArchivedCommand}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                                    Padding="8,6" CornerRadius="6" Cursor="Hand">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12" />
                                                    <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource FgFaint}" FontSize="10" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="chip" Command="{Binding NewTabCommand}" Padding="10,5" FontSize="12" AutomationProperties.Name="New tab">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+" FontSize="14" />
                            <TextBlock Text="New tab" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- First-run nudge: link a GitHub account so sandboxed agents can clone/push private repos.
             Its own row (Auto → 0 when hidden) so it sits above the tab strip instead of overlapping it,
             with a solid background so it's readable. -->
        <Border Grid.Row="1" IsVisible="{Binding ShowGitHubLinkPrompt}"
                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <ic:SymbolIcon Grid.Column="0" Symbol="Link" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Link a GitHub account?" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Sandboxed agents need it to clone or push private repositories. You can also do this later in Settings › GitHub."
                               Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <Button Classes="accent" Grid.Column="2" Content="Link GitHub" Command="{Binding LinkGitHubNowCommand}" VerticalAlignment="Center" Padding="12,5" FontSize="12" Margin="8,0,0,0" />
                <Button Classes="chip" Grid.Column="3" Content="Later" Command="{Binding DismissGitHubLinkPromptCommand}" VerticalAlignment="Center" Padding="12,5" FontSize="12" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <dc:DockControl x:Name="DockRoot" Grid.Row="2" Layout="{Binding Layout}" />

        <!-- Command palette (Ctrl+K): jump to a session or run an action -->
        <Border Grid.Row="0" Grid.RowSpan="3" ZIndex="100" IsVisible="{Binding IsPaletteOpen}"
                Background="{DynamicResource Scrim}">
            <Border Classes="sheet" Width="540" MaxHeight="460" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" Padding="10">
                <StackPanel Spacing="8">
                    <TextBox x:Name="PaletteBox" Text="{Binding PaletteQuery, Mode=TwoWay}"
                             Watermark="Jump to a session or action…" FontSize="14"
                             Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                             BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="10,8">
                        <TextBox.KeyBindings>
                            <!-- Focus stays in the box for typing; Up/Down move the highlighted row and Enter
                                 runs it, so the palette is fully keyboard-navigable (defect #9). -->
                            <KeyBinding Gesture="Down" Command="{Binding MovePaletteSelectionCommand}" CommandParameter="down" />
                            <KeyBinding Gesture="Up" Command="{Binding MovePaletteSelectionCommand}" CommandParameter="up" />
                            <KeyBinding Gesture="Enter" Command="{Binding RunTopPaletteItemCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding ClosePaletteCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <ListBox MaxHeight="380" ItemsSource="{Binding PaletteItems}"
                             SelectedIndex="{Binding SelectedPaletteIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="7" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding $parent[ItemsControl].DataContext.RunPaletteItemCommand}"
                                        CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                        Padding="10,7" CornerRadius="7" Cursor="Hand">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource Fg}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding Hint}" Foreground="{DynamicResource FgFaint}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Border>

        <!-- Fork session: choose a target folder (copy of the working folder) and whether to CoW-clone the sandbox -->
        <Border Grid.Row="0" Grid.RowSpan="3" ZIndex="110" IsVisible="{Binding IsForkPromptOpen}"
                Background="{DynamicResource Scrim}">
            <Border Classes="sheet" Width="540" MaxHeight="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20"
                    DataContext="{Binding ForkPrompt}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Fork session" Classes="display" Foreground="{DynamicResource Fg}" FontSize="16" />
                        <TextBlock Text="Copies the working folder to a new location and opens a fresh session there."
                                   Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="From" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                        <TextBlock Text="{Binding SourceDirectory}" Foreground="{DynamicResource FgDim}" FontSize="12"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Copy to" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                        <TextBox Text="{Binding TargetDirectory, Mode=TwoWay}" FontSize="13"
                                 Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                 BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="10,8" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding CopySandbox, Mode=TwoWay}" IsVisible="{Binding CanCopySandbox}"
                              Foreground="{DynamicResource Fg}" FontSize="12">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Copy the sandbox (copy-on-write)" Foreground="{DynamicResource Fg}" FontSize="12" />
                            <TextBlock Text="Clones the VM's installed tooling/state; fast on ZFS. Otherwise a fresh sandbox is created."
                                       Foreground="{DynamicResource FgFaint}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Danger}"
                               FontSize="12" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="Working…" IsVisible="{Binding Busy}" Foreground="{DynamicResource FgDim}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <Button Classes="chip" Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !Busy}" Padding="14,6" FontSize="12" Margin="8,0,0,0" />
                        <Button Classes="primary" Grid.Column="3" Content="Fork" Command="{Binding ConfirmCommand}" IsEnabled="{Binding !Busy}" Padding="16,6"
                                FontSize="12" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- First-run setup wizard: guides a brand-new user through adding a host and pairing, using only the
             auth methods the host advertises at GET /auth/methods. Layered on top of the existing add-host UI;
             it never appears once a host is paired, and cancelling keeps persisted progress for next launch. -->
        <Border Grid.Row="0" Grid.RowSpan="3" ZIndex="120" IsVisible="{Binding IsSetupWizardOpen}"
                Background="{DynamicResource Scrim}">
            <Border Classes="sheet" x:Name="SetupWizardRoot" Width="560" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
                    DataContext="{Binding SetupWizard}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Connect your first host" Classes="display" Foreground="{DynamicResource Fg}" FontSize="18" />
                        <TextBlock Text="Point Agnes at a running host, then pick how to sign in. You can also do this manually anytime."
                                   Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Step 1: host address -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsEnteringHost}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Host address" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                            <TextBox Text="{Binding HostUrl, Mode=TwoWay}" Watermark="https://your-host:5099" FontSize="13"
                                     Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                     BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Name (optional)" Foreground="{DynamicResource FgFaint}" FontSize="11" />
                            <TextBox Text="{Binding HostName, Mode=TwoWay}" Watermark="My host" FontSize="13"
                                     Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource Fg}"
                                     BorderBrush="{DynamicResource Line}" CornerRadius="8" Padding="10,8" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 2: methods the host actually advertises -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsChoosingMethod}">
                        <TextBlock Text="How do you want to sign in?" Foreground="{DynamicResource Fg}" FontSize="13" FontWeight="SemiBold" />
                        <!-- Grouped by AuthFlowKind: add a device / restore access / authorize a headless process. -->
                        <ItemsControl ItemsSource="{Binding MethodGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource FgFaint}"
                                                   FontSize="11" FontWeight="SemiBold" Margin="0,2,0,2" />
                                        <ItemsControl ItemsSource="{Binding Methods}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding #SetupWizardRoot.DataContext.ChooseMethodCommand}"
                                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left" Background="{DynamicResource PanelAlt}"
                                                            BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                                                            Padding="12,9" Margin="0,0,0,6" Cursor="Hand">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Fg}" FontSize="13" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="11" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Set up your host (deployment docs)" Command="{Binding $parent[Window].DataContext.OpenDeploymentDocsCommand}"
                                HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Accent}"
                                BorderThickness="0" Padding="0" FontSize="12" Cursor="Hand" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button Classes="chip" Grid.Column="0" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding IsChoosingMethod}" Padding="14,6" FontSize="12" />
                        <Button Classes="chip" Grid.Column="2" Content="Skip" Command="{Binding CancelCommand}" Padding="14,6" FontSize="12" Margin="8,0,0,0" />
                        <Button Classes="primary" Grid.Column="3" Content="Continue" Command="{Binding DiscoverCommand}" IsVisible="{Binding IsEnteringHost}" Padding="16,6"
                                FontSize="12" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Onboarding showcase: a data-driven, next/prev/dismiss feature tour. Shown once per install and
             re-openable from the command palette ("Show onboarding tour"). -->
        <Border Grid.Row="0" Grid.RowSpan="3" ZIndex="130" IsVisible="{Binding Showcase.IsOpen}"
                Background="{DynamicResource Scrim}">
            <Border Classes="sheet" Width="560" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
                    DataContext="{Binding Showcase}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StepLabel}" Foreground="{DynamicResource FgFaint}" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{icx:SymbolIcon Symbol=Dismiss}" Command="{Binding DismissCommand}" Background="Transparent"
                                Foreground="{DynamicResource FgDim}" BorderThickness="0" Padding="6,2" FontSize="13" Cursor="Hand" />
                    </Grid>
                    <StackPanel Spacing="8" DataContext="{Binding Current}">
                        <TextBlock Text="{Binding Title}" Classes="display" Foreground="{DynamicResource Fg}" FontSize="20" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button Classes="chip" Grid.Column="0" Content="Back" Command="{Binding PrevCommand}" IsVisible="{Binding HasPrev}" Padding="14,6" FontSize="12" />
                        <Button Classes="chip" Grid.Column="2" Content="Dismiss" Command="{Binding DismissCommand}" Padding="14,6" FontSize="12" Margin="8,0,0,0" />
                        <Button Classes="primary" Grid.Column="3" Content="Next" Command="{Binding NextCommand}" IsVisible="{Binding HasNext}" Padding="16,6"
                                FontSize="12" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </LayoutTransformControl>
    </ScrollViewer>
</Window>
