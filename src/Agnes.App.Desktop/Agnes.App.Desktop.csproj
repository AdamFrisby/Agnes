<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia/XAML codegen produces warnings we don't want to fail the build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Agnes.Desktop.Tests" />

    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
    <!-- Icons. Microsoft's fluentui-system-icons (MIT) as an Avalonia control, over the whole ~2800-icon
         catalogue rather than a curated subset, so a plugin screen can ask for any glyph without editing
         this head. The wrapper is a thin, single-purpose binding — the fonts and the typed `Symbol` enum
         are generated from Microsoft's own repo, which is where the actual artwork risk would live. It is
         the only Avalonia icon package built against Avalonia 12. `Agnes.Ui.Core` takes the dependency-free
         `FluentIcons.Common` alone, so shared view models can name a symbol without pulling in a toolkit. -->
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
    <!-- Third-party VT/terminal control for the embedded terminal head (platform/03). Deliberately
         confined to the desktop head — never core or Agnes.Ui.Core. Maintainer-approved for this use;
         restores against Avalonia 12 (its dep is Avalonia 12.0.2). -->
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand fonts (Space Grotesk / Manrope / JetBrains Mono), embedded so typography is identical on
         a bare Linux box and a Mac rather than falling back to whatever the OS happens to ship. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.md" />
    <EmbeddedResource Include="Assets\Keymaps\*.json" />
    <None Include="Assets\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agnes.Abstractions\Agnes.Abstractions.csproj" />
    <ProjectReference Include="..\Agnes.Protocol\Agnes.Protocol.csproj" />
    <ProjectReference Include="..\Agnes.Client\Agnes.Client.csproj" />
    <ProjectReference Include="..\Agnes.Client.Simulation\Agnes.Client.Simulation.csproj" />
    <ProjectReference Include="..\Agnes.Ui.Core\Agnes.Ui.Core.csproj" />
  </ItemGroup>

</Project>
