[
  { "key": "ctrl+t", "command": "agnes.tab.new", "when": "window" },
  { "key": "ctrl+w", "command": "agnes.tab.close", "when": "window" },
  { "key": "ctrl+tab", "command": "agnes.tab.next", "when": "window" },
  { "key": "ctrl+shift+tab", "command": "agnes.tab.previous", "when": "window" },
  { "key": "ctrl+pagedown", "command": "agnes.tab.next", "when": "window" },
  { "key": "ctrl+pageup", "command": "agnes.tab.previous", "when": "window" },
  { "key": "ctrl+1", "command": "agnes.tab.position1", "when": "window" },
  { "key": "ctrl+2", "command": "agnes.tab.position2", "when": "window" },
  { "key": "ctrl+3", "command": "agnes.tab.position3", "when": "window" },
  { "key": "ctrl+4", "command": "agnes.tab.position4", "when": "window" },
  { "key": "ctrl+5", "command": "agnes.tab.position5", "when": "window" },
  { "key": "ctrl+6", "command": "agnes.tab.position6", "when": "window" },
  { "key": "ctrl+7", "command": "agnes.tab.position7", "when": "window" },
  { "key": "ctrl+8", "command": "agnes.tab.position8", "when": "window" },
  { "key": "ctrl+9", "command": "agnes.tab.position9", "when": "window" },
  { "key": "ctrl+k", "command": "agnes.palette.open", "when": "window" },
  { "key": "ctrl+shift+d", "command": "agnes.dashboard.open", "when": "window" },

  { "key": "down", "command": "agnes.palette.next", "when": "paletteFocus" },
  { "key": "up", "command": "agnes.palette.previous", "when": "paletteFocus" },
  { "key": "enter", "command": "agnes.palette.run", "when": "paletteFocus" },
  { "key": "escape", "command": "agnes.palette.close", "when": "paletteFocus" },

  { "key": "enter", "command": "agnes.search.allSessions", "when": "allSessionsSearchFocus" },
  { "key": "enter", "command": "agnes.settings.mcp.search", "when": "settingsMcpSearchFocus" },
  { "key": "enter", "command": "agnes.settings.plugin.search", "when": "settingsPluginSearchFocus" },
  { "key": "enter", "command": "agnes.settings.skill.search", "when": "settingsSkillSearchFocus" },
  { "key": "enter", "command": "agnes.launchProfile.rename.commit", "when": "settingsLaunchProfileRenameFocus" },
  { "key": "escape", "command": "agnes.launchProfile.rename.cancel", "when": "settingsLaunchProfileRenameFocus" },

  { "key": "ctrl+f", "command": "agnes.session.find.open", "when": "session" },
  { "key": "escape", "command": "agnes.session.find.close", "when": "session" },
  { "key": "f3", "command": "agnes.session.find.next", "when": "session" },
  { "key": "shift+f3", "command": "agnes.session.find.previous", "when": "session" },
  { "key": "f7", "command": "agnes.session.prompt.previous", "when": "session" },
  { "key": "f8", "command": "agnes.session.prompt.next", "when": "session" },
  { "key": "ctrl+f8", "command": "agnes.session.change.next", "when": "session" },
  { "key": "ctrl+f7", "command": "agnes.session.change.previous", "when": "session" },
  { "key": "ctrl+plus", "command": "agnes.chat.fontSize.increase", "when": "chat" },
  { "key": "ctrl+shift+plus", "command": "agnes.chat.fontSize.increase", "when": "chat" },
  { "key": "ctrl+minus", "command": "agnes.chat.fontSize.decrease", "when": "chat" },
  { "key": "enter", "command": "agnes.session.rename.commit", "when": "sessionRenameFocus" },
  { "key": "escape", "command": "agnes.session.rename.cancel", "when": "sessionRenameFocus" },
  { "key": "enter", "command": "agnes.session.tag.add", "when": "sessionTagFocus" },
  { "key": "enter", "command": "agnes.session.find.next", "when": "sessionFindFocus" },
  { "key": "shift+enter", "command": "agnes.session.find.previous", "when": "sessionFindFocus" },
  { "key": "escape", "command": "agnes.session.find.close", "when": "sessionFindFocus" },
  { "key": "enter", "command": "agnes.session.reference.add", "when": "sessionReferenceFocus" },

  { "key": "meta+enter", "command": "agnes.composer.send", "when": "composerFocus" },
  { "key": "ctrl+enter", "command": "agnes.composer.send", "when": "composerFocus" },
  { "key": "ctrl+shift+enter", "command": "agnes.composer.sendNow", "when": "composerFocus" },
  { "key": "alt+up", "command": "agnes.composer.recallPrevious", "when": "composerFocus" },
  { "key": "alt+down", "command": "agnes.composer.recallNext", "when": "composerFocus" }
]
