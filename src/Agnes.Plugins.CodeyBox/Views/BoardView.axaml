<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cb="using:Agnes.Plugins.CodeyBox"
             xmlns:v="using:Agnes.Plugins.CodeyBox.Views"
             xmlns:c="using:Agnes.Plugins.CodeyBox.Views.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Agnes.Plugins.CodeyBox.Views.BoardView">
  <!-- THE RUNWAY. Four horizons read top to bottom — Now, Next, Waiting, Landed — replacing a flat list
       of 404 rows that could not answer the one question an operator opens this tab with: what happens
       next, and can I change it.

       The unit of READING here is the chain: nine items authored in one second as a seven-step series
       are one row with a strip of pips, not nine rows that say nothing about each other. The unit of
       ACTING stays the item, which is why a pip, a blocker link and an expanded step row all select an
       individual step.

       This control's DataContext is the queue view model, so the rows reach commands through
       $parent[UserControl].DataContext — an ordinary {Binding} inside a row template would resolve
       against the Chain. The three REORDER commands arrive as properties instead, because drag-and-drop
       is driven from code-behind and code-behind should not be reaching into a DataContext by name.

       Colours are DynamicResource roles, never literals, and each status hue keeps its one meaning:
       sky = in motion, amber = blocked on you, mint = landed, pink = failed, violet = selection. -->
  <UserControl.Resources>

    <!-- ONE row template for every horizon. The differences between them are properties of the chain
         (IsNext, HasBlocker, IsSingleton), not different kinds of row, and writing them as separate
         templates is how the Waiting rows would quietly stop growing a feature the Now rows got. -->
    <DataTemplate x:Key="ChainRow">
      <!-- TWO LINES, and the second one only where there is something to put on it.

           Everything used to sit on one: title, agent, project, reason, a pip per step, the progress
           count and four reorder buttons, in a row of Auto columns with the title on the only star. A
           32-step chain therefore drew a 349px strip, the Auto columns took what they liked, and the
           title — the one thing that identifies the row — was measured last and got what was left, which
           on a half-width pane was nothing. So: line one is the row's IDENTITY (mark, title, and a
           bounded block of meta that trims), and line two is its MACHINERY (the strip, the disclosure,
           the reorder actions), indented under the title. The strip reads better there anyway: a
           twelve-pip shape is a picture, and a picture belongs under its caption rather than jammed
           beside it competing for the same pixels. -->
      <Grid Classes="chainrow" Classes.nextrow="{Binding IsNext}" Background="Transparent" Margin="0,1"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto">

        <!-- Selection is violet and nothing else in the app is, so it is drawn as its own wash rather
             than as a state on the button: a class toggled by a MultiBinding cannot be expressed, and a
             row that silently stops highlighting is a bug nobody reports. -->
        <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="5" Opacity="0.2"
                Background="{DynamicResource Accent}">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static v:BoardConverters.IsSelected}">
              <Binding />
              <Binding Path="$parent[UserControl].DataContext.Selected" />
            </MultiBinding>
          </Border.IsVisible>
        </Border>

        <!-- The row itself selects the chain's head: the step the row already stands for. -->
        <Button Grid.Row="0" Classes="chainbutton"
                Command="{Binding $parent[UserControl].DataContext.SelectChainCommand}"
                CommandParameter="{Binding}">
          <Grid ColumnSpacing="8">
            <!-- PROPORTIONS, not Auto. An Auto column is measured against infinity and then clamped, so
                 its content is CLIPPED rather than trimmed and the row's desired width can exceed the pane
                 — which is exactly how the reason text used to run under the pane boundary and off the
                 edge. Two stars always sum to the width available, so the title keeps three fifths of it
                 and the meta two, both of them trimming, and the row can never be wider than its pane. -->
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <!-- The title never collapses: a row identified by nothing is not a row. -->
              <ColumnDefinition Width="3*" MinWidth="110" />
              <!-- …and the meta never grows past what a half-width pane can spare. -->
              <ColumnDefinition Width="2*" MaxWidth="330" />
            </Grid.ColumnDefinitions>

            <c:StepDot Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                       State="{Binding Converter={x:Static v:BoardConverters.HeadState}}" />

            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource Fg}" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                       ToolTip.Tip="{Binding Title}" />

            <!-- The meta, as a Grid rather than a StackPanel: a StackPanel measures its children
                 unbounded, so nothing in it ever trims and the last one simply runs off the edge. Here
                 the reason is on the star and gives way first. -->
            <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"
                  VerticalAlignment="Center">
              <!-- Who is on it — except in Now, where the reason already says "running on codex" and
                   printing the agent twice on one row is how a vocabulary stops being one. -->
              <TextBlock Grid.Column="0" Text="{Binding Agent}" Foreground="{DynamicResource FgFaint}"
                         FontSize="10" VerticalAlignment="Center" MaxWidth="76"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsNow}" />
              <TextBlock Grid.Column="1" Text="{Binding ProjectId}" Foreground="{DynamicResource FgFaint}"
                         FontSize="10" VerticalAlignment="Center" MaxWidth="96"
                         TextTrimming="CharacterEllipsis" />

              <!-- Why it is where it is — where the row still has it to say. A section whose rows all
                   said the same thing has already said it in its header, and those rows are blank here.
                   Pink only where something is broken, amber only where it waits on a person; a chain
                   that is merely queued states a fact and stays dim. -->
              <Panel Grid.Column="2" IsVisible="{Binding HasShownWhy}">
                <TextBlock Classes="why" Foreground="{DynamicResource StatusError}"
                           Text="{Binding ShownWhy}" ToolTip.Tip="{Binding Why}"
                           IsVisible="{Binding Converter={x:Static v:BoardConverters.WhyIsError}}" />
                <TextBlock Classes="why" Foreground="{DynamicResource StatusAttention}"
                           Text="{Binding ShownWhy}" ToolTip.Tip="{Binding Why}"
                           IsVisible="{Binding Converter={x:Static v:BoardConverters.WhyNeedsPerson}}" />
                <TextBlock Classes="why" Foreground="{DynamicResource FgDim}"
                           Text="{Binding ShownWhy}" ToolTip.Tip="{Binding Why}"
                           IsVisible="{Binding Converter={x:Static v:BoardConverters.WhyIsPlain}}" />
              </Panel>
            </Grid>
          </Grid>
        </Button>

        <!-- LINE TWO. Nothing of it is visible on a singleton that is not queued, and a Grid whose
             children are all invisible measures to nothing, so such a row stays one line tall. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="19,0,4,0">

          <!-- The chain, as a shape. Kept outside the row button so a pip can select its own step
               without the click also selecting the head. -->
          <c:ChainStrip Grid.Column="0" Steps="{Binding Steps}" VerticalAlignment="Center"
                        IsVisible="{Binding !IsSingleton}"
                        SelectedId="{Binding $parent[UserControl].DataContext.Selected,
                                     Converter={x:Static v:BoardConverters.IdOf}}"
                        StepCommand="{Binding $parent[UserControl].DataContext.SelectStepCommand}" />

          <!-- The disclosure says what it will do (a chevron) as well as what it is about (the count).
               "3 of 5" alone was a label that happened to be pressable, which is not an affordance. -->
          <ToggleButton x:Name="Expand" Grid.Column="1" Classes="progress" Margin="7,0,0,0"
                        IsVisible="{Binding !IsSingleton}" ToolTip.Tip="Show the steps">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:SymbolIcon Symbol="ChevronRight" FontSize="11" VerticalAlignment="Center"
                             IsVisible="{Binding #Expand.IsChecked, Converter={x:Static BoolConverters.Not},
                                         FallbackValue=True}" />
              <ic:SymbolIcon Symbol="ChevronDown" FontSize="11" VerticalAlignment="Center"
                             IsVisible="{Binding #Expand.IsChecked, FallbackValue=False}" />
              <TextBlock Text="{Binding Progress}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>

          <!-- Reordering, revealed on hover so four buttons per row do not shout over the queue. -->
          <StackPanel Grid.Column="3" Classes="rowactions" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center" IsVisible="{Binding IsNext}">
            <Button Classes="ghost" Content="Run next" ToolTip.Tip="Put this at the front of the queue"
                    Command="{Binding $parent[UserControl].RunNextCommand}" CommandParameter="{Binding}" />
            <Button Classes="ghost" Content="Up"
                    Command="{Binding $parent[UserControl].DataContext.MoveUpCommand}" CommandParameter="{Binding}" />
            <Button Classes="ghost" Content="Down"
                    Command="{Binding $parent[UserControl].DataContext.MoveDownCommand}" CommandParameter="{Binding}" />
            <Button Classes="ghost" Content="Run after…" ToolTip.Tip="Then pick the chain it should follow"
                    Command="{Binding $parent[UserControl].BeginRunAfterCommand}" CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>

        <!-- The other half of "Run after…": while a move is armed, every other queued row becomes a
             destination. Not hover-revealed — during a move it is the only thing being looked for. -->
        <Button Grid.Row="2" Classes="putafter"
                Content="Put it after this" HorizontalAlignment="Left" Margin="19,2,0,2"
                Command="{Binding $parent[UserControl].RunAfterCommand}" CommandParameter="{Binding}">
          <Button.IsVisible>
            <MultiBinding Converter="{x:Static v:BoardConverters.PendingElsewhere}">
              <Binding />
              <Binding Path="$parent[UserControl].DataContext.PendingMove" />
            </MultiBinding>
          </Button.IsVisible>
        </Button>

        <!-- What is actually holding a waiting chain, named and selectable. The unblock itself lives in
             the pane's relations band, one click away, because it acts on the parent rather than here. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="5"
                    Margin="19,0,0,2" IsVisible="{Binding HasBlocker}">
          <TextBlock Text="held by" Foreground="{DynamicResource FgFaint}" FontSize="10"
                     VerticalAlignment="Center" />
          <Button Classes="linky" Content="{Binding Blocker.Item.Title}"
                  Command="{Binding $parent[UserControl].DataContext.SelectStepCommand}"
                  CommandParameter="{Binding Blocker}" />
        </StackPanel>

        <!-- The steps, in place. Expanding a chain must not cost the operator their position in the
             queue, so it happens under the row rather than by navigating into it. -->
        <ItemsControl Grid.Row="4" ItemsSource="{Binding Steps}"
                      Margin="19,2,0,4"
                      IsVisible="{Binding #Expand.IsChecked, FallbackValue=False, TargetNullValue=False}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Border CornerRadius="4" Opacity="0.2" Background="{DynamicResource Accent}">
                  <Border.IsVisible>
                    <MultiBinding Converter="{x:Static v:BoardConverters.IsSelected}">
                      <Binding />
                      <Binding Path="$parent[UserControl].DataContext.Selected" />
                    </MultiBinding>
                  </Border.IsVisible>
                </Border>
                <Button Classes="steprow"
                        Command="{Binding $parent[UserControl].DataContext.SelectStepCommand}"
                        CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Series}" Width="34" FontSize="10"
                             Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" />
                  <c:StepDot Grid.Column="1" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                             State="{Binding State}" />
                  <TextBlock Grid.Column="2" Text="{Binding Item.Title}" FontSize="11"
                             Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="3" Classes="statechip">
                    <TextBlock FontSize="9" Foreground="{DynamicResource FgDim}"
                               Text="{Binding State, Converter={x:Static v:BoardConverters.StateWord}}" />
                  </Border>
                  <TextBlock Grid.Column="4" Text="{Binding Item.Agent}" FontSize="10" Margin="8,0,6,0"
                             Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" />
                </Grid>
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.chainbutton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chainbutton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
    </Style>

    <Style Selector="Button.steprow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.steprow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
    </Style>

    <!-- Right-aligned and trimming: the reason is the meta block's star, so it is the thing that gives
         way when a row runs out of width, and it gives way by trimming rather than by pushing. -->
    <Style Selector="TextBlock.why">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="Border.statechip">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
    </Style>

    <Style Selector="Button.putafter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource StatusAttention}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource StatusAttention}" />
    </Style>

    <Style Selector="Button.linky">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.linky /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.progress">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.progress:checked">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector="ToggleButton.progress:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Present, but only once the pointer is on the row it belongs to. -->
    <Style Selector="StackPanel.rowactions">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.chainrow:pointerover StackPanel.rowactions">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Expander.horizon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Headers WRAP. They carry the reason their rows no longer print — "Next · 16 in dispatch order ·
         7 of 16 waiting for an audit slot for 11h 06m" — and a header measured at its natural width makes
         its whole section demand that width, which pushed every row in it past the pane's edge. Wrapping
         keeps the sentence and keeps the section inside its pane. -->
    <Style Selector="TextBlock.horizonhead">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.subhead">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The tail of a folded section. Wears the ghost treatment the row actions wear, because it is the
         same kind of thing: a control that reveals something, not a row. -->
    <Style Selector="ToggleButton.showmore">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="19,3,0,2" />
    </Style>
    <Style Selector="ToggleButton.showmore:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.showmore:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
    </Style>

    <!-- The key. Drawn from the same marks the rows are drawn from — see the legend below. -->
    <Style Selector="Button.legend">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.keyword">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.keymeaning">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The reason a whole section shares, said once under its heading rather than on every row — and in
         the BODY rather than in the heading, because an Expander measures its header at that header's
         natural width and a long one drags its entire section past the edge of the pane. -->
    <Style Selector="TextBlock.sharedline">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="19,1,4,3" />
    </Style>

    <!-- An empty horizon is a sentence. A blank gap is indistinguishable from a failed request. -->
    <Style Selector="TextBlock.nothing">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
      <Setter Property="Margin" Value="19,3,0,3" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Search first, then the two slices that matter on a host serving several repositories, then the
         one action the board itself offers. No filter chips: the horizons ARE the filter, and a chip
         that hides a horizon hides the order the operator came here to read. -->
    <Grid Grid.Row="0" Margin="8,8,8,6" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
      <TextBox Grid.Column="0" FontSize="12" Text="{Binding Search, Mode=TwoWay}"
               PlaceholderText="Search title, id, branch, prompt…" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" MinWidth="140" FontSize="11"
                SelectedValue="{Binding ProjectFilter, Mode=TwoWay}" SelectedValueBinding="{Binding Id}"
                DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="All projects" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding Agents}" MinWidth="104" FontSize="11"
                SelectedItem="{Binding AgentFilter, Mode=TwoWay}" PlaceholderText="All agents" />
      <Button Grid.Column="3" Content="New" Padding="12,4" FontSize="12"
              ToolTip.Tip="Describe some work, or paste a plan"
              Command="{Binding OpenComposerCommand}"
              CommandParameter="{x:Static cb:ComposerIntent.Blank}" />

      <!-- THE KEY. The board says nearly everything in marks — hollow against solid, five hues, a dashed
           pip for something that will never run — and until now said nowhere what any of them meant; a
           mark you have not been taught is decoration. Every sample here is drawn by the SAME StepDot the
           rows are drawn by, from the same StepMarks mapping, so the key cannot drift away from the
           board: change a hue and this changes with it. -->
      <Button Grid.Column="4" Classes="legend" ToolTip.Tip="What the marks mean">
        <ic:SymbolIcon Symbol="QuestionCircle" FontSize="15" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Spacing="7" MaxWidth="330">
              <TextBlock Text="What the marks mean" FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource Fg}" />

              <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="9" RowSpacing="4">
                <c:StepDot Grid.Row="0" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                           State="{x:Static cb:StepState.Done}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="keyword" Text="done" />
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="keymeaning" Text="solid mint — it landed" />

                <c:StepDot Grid.Row="1" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                           State="{x:Static cb:StepState.Running}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="keyword" Text="running" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="keymeaning" Text="solid sky — it holds a slot" />

                <c:StepDot Grid.Row="2" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                           State="{x:Static cb:StepState.Ready}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="keyword" Text="ready" />
                <TextBlock Grid.Row="2" Grid.Column="2" Classes="keymeaning"
                           Text="hollow sky — runnable, waiting for a slot" />

                <c:StepDot Grid.Row="3" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                           State="{x:Static cb:StepState.Blocked}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="keyword" Text="blocked" />
                <TextBlock Grid.Row="3" Grid.Column="2" Classes="keymeaning"
                           Text="hollow grey — a parent has not finished" />

                <c:StepDot Grid.Row="4" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                           State="{x:Static cb:StepState.Parked}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Classes="keyword" Text="parked" />
                <TextBlock Grid.Row="4" Grid.Column="2" Classes="keymeaning"
                           Text="solid grey — backing off, it will resume itself" />

                <c:StepDot Grid.Row="5" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                           State="{x:Static cb:StepState.NeedsPerson}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Classes="keyword" Text="needs a person" />
                <TextBlock Grid.Row="5" Grid.Column="2" Classes="keymeaning"
                           Text="amber — it is blocked on you" />

                <c:StepDot Grid.Row="6" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                           State="{x:Static cb:StepState.Failed}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Classes="keyword" Text="failed" />
                <TextBlock Grid.Row="6" Grid.Column="2" Classes="keymeaning"
                           Text="pink — it stopped and needs a decision" />

                <c:StepDot Grid.Row="7" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                           State="{x:Static cb:StepState.Cancelled}" />
                <TextBlock Grid.Row="7" Grid.Column="1" Classes="keyword" Text="cancelled" />
                <TextBlock Grid.Row="7" Grid.Column="2" Classes="keymeaning"
                           Text="dashed — it will not run" />
              </Grid>

              <Border Height="1" Background="{DynamicResource Line}" />

              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:ChainStrip x:Name="LegendStrip" VerticalAlignment="Center" />
                <TextBlock Classes="keymeaning" Text="a chain: one pip per step, in dependency order"
                           MaxWidth="200" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="9">
                <c:ChainStrip x:Name="LegendLongStrip" VerticalAlignment="Center" />
                <TextBlock Classes="keymeaning" MaxWidth="200"
                           Text="past twelve steps: the first eight, the last three, and a gap for the rest — the tooltip names every one" />
              </StackPanel>

              <TextBlock Classes="keymeaning"
                         Text="A violet wash, and a ring round a pip, are the item the pane is showing. Times are local." />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Horizontal overflow is DISABLED, not scrolled: a runway whose rows can be wider than the pane
         clips its own text at the pane boundary and gives the operator a scrollbar to read a title with.
         Rows measure within the width they are given (see the row template), and the right padding is
         the scrollbar's gutter, so the vertical bar never sits on top of a reason. -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8,0,16,10" Spacing="10">

        <Expander Classes="horizon" IsExpanded="True">
          <Expander.Header>
            <TextBlock Classes="horizonhead" Text="{Binding Board.NowHeader}"
                       ToolTip.Tip="{x:Static cb:Board.NowTip}" />
          </Expander.Header>
          <StackPanel>
            <TextBlock Classes="nothing" Text="{Binding Board.NowEmptyText}" IsVisible="{Binding !Board.HasNow}" />
            <TextBlock Classes="sharedline" Text="{Binding Board.NowSharedWhy}"
                       IsVisible="{Binding Board.HasNowSharedWhy, FallbackValue=False}" />
            <ItemsControl ItemsSource="{Binding Board.Now}" ItemTemplate="{StaticResource ChainRow}" />
          </StackPanel>
        </Expander>

        <Expander Classes="horizon" IsExpanded="True">
          <Expander.Header>
            <TextBlock Classes="horizonhead" Text="{Binding Board.NextHeader}"
                       ToolTip.Tip="{x:Static cb:Board.NextTip}" />
          </Expander.Header>
          <StackPanel>
            <!-- A move in progress states which chain is being moved, because by the time the operator
                 has scrolled to the destination the row they picked is off screen. -->
            <Border Margin="0,2,0,6" Padding="9,6" CornerRadius="6"
                    Background="{DynamicResource Panel}" BorderThickness="1"
                    BorderBrush="{DynamicResource StatusAttention}"
                    IsVisible="{Binding HasPendingMove, FallbackValue=False}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg}"
                           Text="{Binding PendingMove, Converter={x:Static v:BoardConverters.ChooseWhere}}" />
                <Button Grid.Column="1" Classes="ghost" Content="Cancel"
                        Command="{Binding CancelPendingMoveCommand}" />
              </Grid>
            </Border>

            <TextBlock Classes="nothing" Text="Nothing queued — add work with New."
                       IsVisible="{Binding !Board.HasNext}" />

            <!-- The sentence the rows stopped printing, said once for the section. -->
            <TextBlock Classes="sharedline" Text="{Binding Board.NextSharedWhy}"
                       IsVisible="{Binding Board.HasNextSharedWhy, FallbackValue=False}" />

            <!-- The front of the dispatch order, then the rest on request. Sixteen queued rows is not
                 sixteen decisions: the first few are what an operator can actually reorder, and the tail
                 is a list of things that are not moving. The toggle lives in the view rather than in the
                 board, so opening it survives every rebuild for as long as the tab is open. -->
            <ItemsControl x:Name="NextList" ItemsSource="{Binding Board.NextShown}"
                          ItemTemplate="{StaticResource ChainRow}" />

            <ToggleButton x:Name="MoreNext" Classes="showmore"
                          IsVisible="{Binding Board.NextIsFolded, FallbackValue=False}"
                          ToolTip.Tip="The rest of the dispatch order">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ic:SymbolIcon Symbol="ChevronRight" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding #MoreNext.IsChecked, Converter={x:Static BoolConverters.Not},
                                           FallbackValue=True}" />
                <ic:SymbolIcon Symbol="ChevronDown" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding #MoreNext.IsChecked, FallbackValue=False}" />
                <TextBlock Text="{Binding Board.NextMoreLabel}" FontSize="10" VerticalAlignment="Center"
                           IsVisible="{Binding #MoreNext.IsChecked, Converter={x:Static BoolConverters.Not},
                                       FallbackValue=True}" />
                <TextBlock Text="Show fewer" FontSize="10" VerticalAlignment="Center"
                           IsVisible="{Binding #MoreNext.IsChecked, FallbackValue=False}" />
              </StackPanel>
            </ToggleButton>

            <ItemsControl x:Name="NextRestList" ItemsSource="{Binding Board.NextRest}"
                          ItemTemplate="{StaticResource ChainRow}"
                          IsVisible="{Binding #MoreNext.IsChecked, FallbackValue=False}" />
          </StackPanel>
        </Expander>

        <Expander Classes="horizon" IsExpanded="True">
          <Expander.Header>
            <TextBlock Classes="horizonhead" Text="{Binding Board.WaitingHeader}"
                       ToolTip.Tip="{x:Static cb:Board.WaitingTip}" />
          </Expander.Header>
          <StackPanel>
            <TextBlock Classes="nothing" Text="Nothing waiting." IsVisible="{Binding !Board.HasWaiting}" />
            <!-- Grouped by REASON, because a reason is an unblock: everything under one heading is
                 released by the same move. What needs a person is open; the rest states its count and
                 stays folded, because it is by definition work the operator cannot move.

                 With only one group there is no grouping to show: the horizon's own header names it
                 ("Waiting · 4 need you") and the rows follow it directly, rather than a lone subheading
                 repeating the same sentence one indent in. -->
            <ItemsControl ItemsSource="{Binding Board.Waiting}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Expander Classes="horizon" Margin="0,2,0,0"
                              IsExpanded="{Binding OpenByDefault}"
                              IsVisible="{Binding $parent[UserControl].DataContext.Board.WaitingIsGrouped,
                                          FallbackValue=True}">
                      <Expander.Header>
                        <TextBlock Classes="subhead" Text="{Binding Header}" />
                      </Expander.Header>
                      <StackPanel>
                        <TextBlock Classes="sharedline" Text="{Binding SharedWhy}"
                                   IsVisible="{Binding HasSharedWhy}" />
                        <ItemsControl ItemsSource="{Binding Chains}"
                                      ItemTemplate="{StaticResource ChainRow}" />
                      </StackPanel>
                    </Expander>

                    <StackPanel IsVisible="{Binding $parent[UserControl].DataContext.Board.WaitingIsOneGroup,
                                            FallbackValue=False}">
                      <TextBlock Classes="sharedline" Text="{Binding SharedWhy}"
                                 IsVisible="{Binding HasSharedWhy}" />
                      <ItemsControl ItemsSource="{Binding Chains}" ItemTemplate="{StaticResource ChainRow}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <Expander Classes="horizon" IsExpanded="True">
          <Expander.Header>
            <TextBlock Classes="horizonhead" Text="{Binding Board.LandedHeader}"
                       ToolTip.Tip="{x:Static cb:Board.LandedTip}" />
          </Expander.Header>
          <StackPanel>
            <TextBlock Classes="nothing" Text="Nothing landed in the last 7 days."
                       IsVisible="{Binding !Board.HasLanded}" />
            <!-- Today open, the rest of the week folded: history is here to be searched, not read. -->
            <ItemsControl ItemsSource="{Binding Board.Landed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander Classes="horizon" Margin="0,2,0,0"
                            IsExpanded="{Binding Converter={x:Static v:BoardConverters.IsToday}}">
                    <Expander.Header>
                      <TextBlock Classes="subhead" Text="{Binding Header}" />
                    </Expander.Header>
                    <StackPanel>
                      <TextBlock Classes="sharedline" Text="{Binding SharedWhy}"
                                 IsVisible="{Binding HasSharedWhy}" />
                      <ItemsControl ItemsSource="{Binding Chains}"
                                    ItemTemplate="{StaticResource ChainRow}" />
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <!-- What the four horizons are deliberately not showing, and how to reach it. -->
        <TextBlock Text="{Binding Board.HistoryLabel}" Foreground="{DynamicResource FgFaint}" FontSize="10"
                   Margin="4,2,0,0" TextWrapping="Wrap" />

        <Expander Classes="horizon" IsExpanded="True"
                  IsVisible="{Binding HistoryMatches, Converter={x:Static v:BoardConverters.Any},
                              FallbackValue=False}">
          <Expander.Header>
            <TextBlock Classes="horizonhead" Text="History" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding HistoryMatches}" ItemTemplate="{StaticResource ChainRow}" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
