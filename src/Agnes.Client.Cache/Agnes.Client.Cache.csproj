<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- The same two packages the host's event store uses, at the same versions: no new supply-chain surface.
       Kept out of Agnes.Client itself so heads that cannot carry a native SQLite (or do not want one) are
       untouched; a head opts in by referencing this project and handing the cache to its AgnesClient. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agnes.Abstractions\Agnes.Abstractions.csproj" />
    <ProjectReference Include="..\Agnes.Client\Agnes.Client.csproj" />
  </ItemGroup>

</Project>
