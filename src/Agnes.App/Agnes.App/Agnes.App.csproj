<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- Android is no longer an Uno target: the phone client is its own Avalonia head
         (src/Agnes.App.Mobile), designed for one thumb rather than reflowed from the desktop layout.
         What's left here is the web (WASM) head plus its desktop counterpart. -->
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Agnes.App</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.agnes-app</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Agnes.App</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Agnes.App powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Agnes.Ui.Core\Agnes.Ui.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same fluentui-system-icons catalogue the Avalonia heads use, in its Uno.WinUI build, so the
         `Symbol` a shared view model names resolves here too. It also replaces this head's `FontIcon`s,
         which addressed Segoe MDL2 by codepoint — a font that doesn't exist in a browser or on Linux. -->
    <PackageReference Include="FluentIcons.WinUI" />
  </ItemGroup>

</Project>
